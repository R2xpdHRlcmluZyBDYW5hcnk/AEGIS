#!/usr/bin/env python3
"""ips-supervisor — Snort 检测与 NFQUEUE 守护

职责
  1. 独占维护 `table inet ips`（NFQUEUE 分发规则）：启动时应用，停止时删除；
  2. 拉起并守护 Snort（NFQ 模式，前台运行）；
  3. 检查队列监听，持续缺失时在规则事务完成后恢复 Snort；
  4. 定期用 libnftables 读队列表：如果被 `systemctl restart nftables`
     之类的操作冲掉了，自动重建（并写日志）；
  5. 收到 SIGTERM 时停止检测进程并删表。

Web 控制台和事件库由独立的 ips-web.service 管理。

用法
  ips-supervisor            # 前台运行（由 ips.service 拉起）
  ips-supervisor --status   # 只读检查：队列表 + 进程 + 端口
"""

from contextlib import ExitStack
import json
from pathlib import Path
import secrets
import os
import signal
import subprocess
import sys
import threading
import time
from log_storage import log_paths, validate_log_storage

NFT_FAMILY = "inet"
NFT_TABLE = "ips"
NFT_FILE = None                      # 规则内嵌，见 nft_rules()
QUEUES = "0-3"
QUEUE_IDS = frozenset(('0', '1', '2', '3'))

SNORT_PREFIX = os.environ.get('SNORT_ENGINE_PREFIX', '/opt/ips-snort3/3.12.4.0')
SNORT = SNORT_PREFIX + "/bin/snort"
SNORT_CONF = "/etc/snort/snort.lua"
SNORT_PIDFILE = "/run/snort/snort.pid"
SNORT_RUNDIR = "/run/snort"
NATIVE_LOG_DIR = str(log_paths()[0])

NFT_BIN = "/usr/sbin/nft"
NFQ_PROC = "/proc/net/netfilter/nfnetlink_queue"
ENGINE_SOCKET = "/run/snort/control.sock"
CHECK_INTERVAL = 1.0
RESTART_DELAY = 3.0
STARTUP_TIMEOUT = 120.0
MISSING_GRACE = 15.0
RECOVERY_RECHECK = 5.0
RECOVERY_COOLDOWN = 180.0
BRIDGE_CHECKPOINT = Path('/var/lib/ips-event-bridge/offsets.json')
RULE_MAINTENANCE = Path('/var/lib') / ('ips-snort-rule-manager' if
    os.environ.get('IPS_PROGRAM_DIRECTORY') == '/opt/ips-console/bin' else 'ips-rule-manager') / 'maintenance'


def log(message):
    sys.stdout.write("[ips] %s\n" % message)
    sys.stdout.flush()


def nft_rules():
    """NFQUEUE 分发规则；拦截点在 prerouting dstnat + 10(-90)：
    - 在 conntrack/defrag 之后，报文已重组
    - 在 dstnat 之后，反向 NAT 已恢复客户端地址，双向使用同一连接元组
    - 隧道回注流量也经过相同的地址过滤与队列分发
    - 仅按入口接口排除 lo；其他接口继续经过目的地址过滤与队列分发
    """
    return (
        "add table %(fam)s %(tab)s\n"
        "delete table %(fam)s %(tab)s\n"
        "table %(fam)s %(tab)s {\n"
        "    chain prerouting {\n"
        "        type filter hook prerouting priority -90; policy accept;\n"
        '        iifname "lo" return\n'
        "        fib daddr type { local, broadcast, multicast } return\n"
        "        ip daddr { 224.0.0.0/4, 255.255.255.255 } return\n"
        "        counter queue flags bypass to %(queues)s\n"
        "    }\n"
        "}\n"
    ) % {"fam": NFT_FAMILY, "tab": NFT_TABLE, "queues": QUEUES}


class Nft:
    """优先用 libnftables 的 Python 绑定；没有绑定就退回 nft -j"""

    def __init__(self):
        self.lock = threading.Lock()
        self.ctx = None
        self.binding = True
        try:
            import nftables  # python3-nftables
            self.ctx = nftables.Nftables()
            self.ctx.set_json_output(True)
        except ImportError:
            self.binding = False
            log("python3-nftables 未安装，退回 nft -j")

    def _run(self, text):
        with self.lock:
            if self.ctx is not None:
                rc, out, err = self.ctx.cmd(text)
                return rc, (out or ""), (err or "")
        proc = subprocess.run([NFT_BIN, "-f", "-"], input=text, capture_output=True, text=True)
        return proc.returncode, proc.stdout, proc.stderr

    def _dump(self):
        with self.lock:
            if self.ctx is not None:
                rc, out, err = self.ctx.cmd("list table %s %s" % (NFT_FAMILY, NFT_TABLE))
                if rc != 0 or not out:
                    return None
                try:
                    return json.loads(out)
                except ValueError:
                    return None
        proc = subprocess.run([NFT_BIN, "-j", "list", "table", NFT_FAMILY, NFT_TABLE],
                              capture_output=True, text=True)
        if proc.returncode != 0 or not proc.stdout:
            return None
        try:
            return json.loads(proc.stdout)
        except ValueError:
            return None

    def has_queue(self):
        data = self._dump()
        if not data:
            return False
        for obj in data.get("nftables", []):
            rule = obj.get("rule")
            if not rule:
                continue
            if any("queue" in expr for expr in (rule.get("expr") or [])):
                return True
        return False

    def apply(self):
        rc, out, err = self._run(nft_rules())
        if rc != 0:
            return False, (err or out).strip()
        return True, ""

    def remove(self):
        self._run("delete table %s %s" % (NFT_FAMILY, NFT_TABLE))


class Child:
    def __init__(self, name, argv, nice=None):
        self.name = name
        self.argv = argv
        self.proc = None
        self.nice = nice

    def start(self):
        log("启动 %s" % self.name)
        kwargs = {"stdout": None, "stderr": None}
        if self.nice is not None:
            kwargs["preexec_fn"] = lambda: os.nice(self.nice)
        started = time.time()
        argv = list(self.argv)
        if self.name == 'snort':
            from session_logger import plugin_arguments
            argv[1:1] = plugin_arguments()
        self.proc = subprocess.Popen(argv, **kwargs)
        if self.name == "snort":
            with open(SNORT_PIDFILE, "w") as handle:
                handle.write(str(self.proc.pid) + "\n")
            instance = os.path.join(SNORT_RUNDIR, "instance.json")
            with open(instance + ".new", "w") as handle:
                json.dump(dict(epoch=secrets.token_hex(16), started=started), handle)
            os.replace(instance + ".new", instance)

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def returncode(self):
        return None if self.proc is None else self.proc.poll()

    def stop(self, timeout=20.0):
        if not self.alive():
            return
        log("停止 %s" % self.name)
        self.proc.terminate()
        deadline = time.time() + timeout
        while time.time() < deadline:
            if self.proc.poll() is not None:
                return
            time.sleep(0.2)
        log("%s 未在 %.0fs 内退出，强制结束" % (self.name, timeout))
        try:
            self.proc.kill()
            self.proc.wait(timeout=5)
        except OSError:
            pass


def clean_stale_pidfile():
    """Snort 会因为残留的 pidfile 直接拒绝启动，这里提前清掉"""
    pid = 0
    try:
        with open(SNORT_PIDFILE, encoding="utf-8") as handle:
            pid = int(handle.read().strip())
    except (OSError, ValueError):
        pid = 0
    if pid and os.path.isdir("/proc/%d" % pid):
        return
    try:
        os.unlink(SNORT_PIDFILE)
        log("清理了陈旧的 pidfile")
    except OSError:
        pass


def queue_listeners():
    """Return bound queue IDs, or None when the kernel snapshot is unavailable."""
    bound = set()
    try:
        with open(NFQ_PROC, encoding="utf-8") as handle:
            for line in handle:
                cols = line.split()
                if len(cols) < 2 or not cols[0].isdecimal() or not cols[1].isdecimal():
                    return None
                if cols[0] in QUEUE_IDS and int(cols[1]):
                    bound.add(cols[0])
    except (OSError, UnicodeError):
        return None
    return bound


def wait_queues_free(stop, timeout):
    """旧实例退出后内核释放队列可能有延迟，先等一会儿再启动，避免 create_queue 失败"""
    deadline = time.monotonic() + timeout
    while not stop.is_set():
        busy = queue_listeners()
        if not busy:
            return True
        if time.monotonic() >= deadline:
            log("队列 %s 仍被占用，稍后重试" % ",".join(sorted(busy)))
            break
        stop.wait(0.5)
    return False


class QueueHealth:
    def __init__(self, started):
        self.started = started
        self.ready = False
        self.missing_since = {}

    def overdue(self, listeners, now):
        if listeners is None:
            self.missing_since.clear()
            return set()
        missing = QUEUE_IDS - listeners
        if not missing:
            self.ready = True
        if not self.ready and now - self.started < STARTUP_TIMEOUT:
            return set()
        self.missing_since = {queue: self.missing_since.get(queue, now) for queue in missing}
        return {queue for queue, since in self.missing_since.items() if now - since >= MISSING_GRACE}


def status():
    nft = Nft()
    ok = nft.has_queue()
    print("nft table %s %s: %s" % (NFT_FAMILY, NFT_TABLE, "OK" if ok else "MISSING"))
    listeners = queue_listeners()
    if listeners is None:
        print("NFQUEUE 监听状态不可用")
    else:
        print("NFQUEUE 已监听 %s 缺失 %s" % (','.join(sorted(listeners)) or '无',
                                              ','.join(sorted(QUEUE_IDS - listeners)) or '无'))
    for name in ("snort", "ips-web"):
        proc = subprocess.run(["pgrep", "-af", name], capture_output=True, text=True)
        lines = [l for l in proc.stdout.splitlines() if "ips-supervisor" not in l]
        print("%-8s %s" % (name, lines[0] if lines else "not running"))
    for name in ('ips.service', 'ips-web.service'):
        unit = subprocess.run(["systemctl", "is-active", name], capture_output=True, text=True)
        print("%s: %s" % (name, unit.stdout.strip()))
    return 0 if ok and listeners == QUEUE_IDS else 1


def wait_snort_ready(snort, stop):
    deadline = time.monotonic() + STARTUP_TIMEOUT
    while not stop.is_set() and time.monotonic() < deadline:
        if not snort.alive():
            return False
        if os.path.exists(ENGINE_SOCKET) and queue_listeners() == QUEUE_IDS:
            return True
        stop.wait(0.5)
    return False


def archive_native_logs(stop):
    """Preserve files Snort would truncate at startup, on the same filesystem."""
    import ctypes

    logs = Path(NATIVE_LOG_DIR)
    names = ('file_connector_ndr_transmit', 'alert_json.txt', 'ndr_session.json')
    sources = [logs / (prefix + name) for prefix in ('', '0_', '1_', '2_', '3_') for name in names]
    files = {}
    for path in sources:
        if path.is_symlink() or (path.exists() and not path.is_file()):
            raise OSError('原始日志路径无效：' + path.name)
        if path.exists():
            info = path.stat()
            if info.st_size:
                files[path] = info
    if not files:
        return

    try:
        instance = json.loads((Path(SNORT_RUNDIR) / 'instance.json').read_text())
        epoch, started = instance['epoch'], float(instance['started'])
    except (OSError, ValueError, KeyError, TypeError):
        epoch = None
    if epoch:
        pending = {path.name: info for path, info in files.items()
                   if info.st_size and info.st_mtime >= started}
        deadline = time.monotonic() + 5
        while pending and time.monotonic() < deadline:
            try:
                checkpoint = json.loads(BRIDGE_CHECKPOINT.read_text())
                if checkpoint.get('epoch') == epoch and all(
                    checkpoint['files'].get(name, {}).get('inode') == info.st_ino and
                    checkpoint['files'][name].get('offset', 0) >= info.st_size
                    for name, info in pending.items()
                ):
                    break
            except (OSError, ValueError, KeyError, TypeError):
                pass
            if stop.wait(0.25):
                return
        else:
            if pending:
                log('采集尚未追平，未入库的原始记录将保存在归档中')

    # Share the existing native archive naming and history cleanup policy.
    archive = logs / ('.response-' + time.strftime('%Y%m%dT%H%M%S', time.gmtime()) + '-' + str(time.time_ns()))
    # Keep the active pathname present while the bridge reads it independently.
    exchange = ctypes.CDLL(None, use_errno=True).renameat2
    exchange.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
    exchange.restype = ctypes.c_int
    archive.mkdir(mode=0o700)
    for path, info in files.items():
        destination = archive / path.name
        with destination.open('xb'):
            pass
        try:
            destination.chmod(info.st_mode & 0o777)
            if exchange(-100, os.fsencode(path), -100, os.fsencode(destination), 2):  # AT_FDCWD, RENAME_EXCHANGE
                error = ctypes.get_errno()
                raise OSError(error, os.strerror(error), str(path))
        except OSError:
            destination.unlink()
            raise
    log('已保留重启前的原始日志：' + archive.name)


def start_snort(snort, stop, queue_timeout):
    clean_stale_pidfile()
    if not wait_queues_free(stop, queue_timeout):
        return False
    try:
        archive_native_logs(stop)
    except OSError as exc:
        log('原始日志归档失败，暂缓启动 Snort：' + str(exc))
        return False
    if stop.is_set():
        return False
    snort.start()
    return True


def recover_snort(snort, stop, overdue, socket_missing):
    from snort_engine import configuration_lock

    with ExitStack() as guard:
        try:
            guard.enter_context(configuration_lock(SNORT_CONF, blocking=False))
        except BlockingIOError:
            return False
        except OSError as exc:
            log('暂无法协调 Snort 恢复：' + str(exc))
            return False
        listeners = queue_listeners()
        missing = overdue - listeners if listeners is not None else set()
        socket_missing = socket_missing and not os.path.exists(ENGINE_SOCKET)
        if stop.is_set() or RULE_MAINTENANCE.exists() or not (missing or socket_missing):
            return False
        reason = 'NFQUEUE %s 持续缺少监听' % ','.join(sorted(missing)) if missing else 'Snort 控制套接字未就绪'
        log(reason + '，自动重启 Snort')
        snort.stop()
        if snort.alive():
            log('Snort 未完全退出，等待后续恢复')
        elif start_snort(snort, stop, 10) and wait_snort_ready(snort, stop):
            log('Snort 已恢复，NFQUEUE 0–3 全部就绪')
        elif not stop.is_set():
            log('Snort 重启后监听尚未全部就绪')
        return True


def ensure_nft():
    """被 nftables.service 的 ExecStartPost 调用：表没了就补上"""
    nft = Nft()
    if nft.has_queue():
        return 0
    ok, err = nft.apply()
    log("exec-hook 补建队列表: %s" % ("OK" if ok else "FAILED " + err))
    return 0 if ok else 1


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--status":
        return status()
    if len(sys.argv) > 1 and sys.argv[1] == "--ensure-nft":
        return ensure_nft()

    os.makedirs(SNORT_RUNDIR, exist_ok=True)
    validate_log_storage()

    stop = threading.Event()

    def on_signal(_signum, _frame):
        stop.set()

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    nft = Nft()
    ok, err = nft.apply()
    log("NFQUEUE 规则: %s" % ("已应用" if ok else "应用失败: " + err))

    snort = Child("snort", [SNORT, "--daq-dir", SNORT_PREFIX + "/lib/daq",
        "--daq", "nfq", "-Q", "-s", "65535", "-z", "4", "-i", "0", "-i", "1", "-i", "2", "-i", "3",
        "-c", SNORT_CONF, "-l", NATIVE_LOG_DIR, "--control-socket", ENGINE_SOCKET,
        "--script-path", SNORT_PREFIX + "/etc/snort"])

    start_snort(snort, stop, 20)
    health = QueueHealth(time.monotonic())
    next_recovery = 0.0
    recovery_armed = True

    last_check = 0.0
    while not stop.is_set():
        if not snort.alive():
            log("Snort 未运行 (rc=%s)，%.0fs 后重试" % (snort.returncode(), RESTART_DELAY))
            if stop.wait(RESTART_DELAY):
                break
            if start_snort(snort, stop, 10):
                health = QueueHealth(time.monotonic())

        now = time.monotonic()
        if now - last_check >= CHECK_INTERVAL:
            last_check = now
            if not nft.has_queue():
                log("队列表被清空（nftables 被重载？），正在重建")
                ok, err = nft.apply()
                log("重建%s" % ("成功" if ok else "失败: " + err))
            if snort.alive():
                listeners = queue_listeners()
                socket_ready = os.path.exists(ENGINE_SOCKET)
                if listeners == QUEUE_IDS and socket_ready:
                    recovery_armed = True
                overdue = health.overdue(listeners, now)
                socket_missing = not socket_ready and now - health.started >= STARTUP_TIMEOUT
                if recovery_armed and now >= next_recovery and (overdue or socket_missing):
                    next_recovery = now + RECOVERY_RECHECK
                    if recover_snort(snort, stop, overdue, socket_missing):
                        health = QueueHealth(time.monotonic())
                        next_recovery = health.started + RECOVERY_COOLDOWN
                        recovery_armed = False

        stop.wait(1.0)

    snort.stop(timeout=20)
    nft.remove()
    log("已停止")
    return 0


if __name__ == "__main__":
    sys.exit(main())
