class App:
    def clear_history(self):
        with self.store.lock:
            try:
                info=os.stat(self.store.path)
                cutoff=dict(device=info.st_dev,inode=info.st_ino,offset=info.st_size)
            except FileNotFoundError:
                cutoff=None
            if not self.db.clear(cutoff): return False
            self.store.events.clear();self.store.strong.clear()
            self.store.offsets=array.array('Q');self.store.offset_base=self.store.next_id
            self.store.buf=b'';self.store.minute_index.clear();self.store.buckets.clear()
            self.store._series_cache=None;self.store.last_ingest=0
            if cutoff:
                self.store.ino=cutoff['inode'];self.store.offset=cutoff['offset']
        if hasattr(self,'data'): self.data.invalidate()
        return True

    def __init__(self, config):
        self.config = config
        self.assistant = LocalAssistant(config.get('local_llm'), config.get('llm_summary_max_tokens'))
        self.stop=threading.Event()
        self.control = None
        if config.get("rule_manager_socket"):
            from ips_control import Client, install_proxies
            self.control = Client(config["rule_manager_socket"])
            install_proxies(sys.modules[__name__], self.control)
        else:
            normalize_selector_conf(DISABLE_CONF)
            normalize_selector_conf(DROP_CONF)
            normalize_selector_conf(MODIFY_CONF, modify=True)
        self.db = EventDB(config.get("event_db") or EVENT_DB)
        self.db.cpu = shared_cpu()
        self.cache_budget = SharedCache.budget(config)
        self.cache = SharedCache(self.cache_budget*3//4)
        self.network = NetworkSnapshots(self.db,cache=self.cache)
        self.analytics = StoredNetworkStats(self.db,config.get('stats_batch_size',1024),
                                            config.get('stats_duty_percent',20))
        self.db.analytics = self.analytics
        self.analytics.cpu = shared_cpu()
        # 启动时补读多少 eve.json：按"库里最新时间到现在"的缺口估算，
        # 库是新的（首次部署）就多读一点，日常重启只要补最近 1MB
        tail = int(config.get("event_tail_bytes") or 0)
        if not tail:
            try:
                newest = (self.db.conn.execute('SELECT MAX(ts) FROM events').fetchone()[0] or 0)/1000 if self.db.conn is not None else 0.0
                gap = max(0.0, now() - newest) if newest else 3600.0
                tail = int(min(32 << 20, max(1 << 20, gap * 40 * 1024)))
            except Exception:  # noqa: BLE001
                tail = 1 << 20
        self.store = EventStore(EVE, maxlen=int(config.get("event_buffer") or 30000),
                                initial_tail=tail,memory_budget=self.cache_budget//4)
        self.store.db = self.db
        self.store.cpu = shared_cpu()
        self.sys = SysInfo()
        self.rules = RuleBook()
        self.sessions = Sessions(int(config.get("session_ttl") or SESSION_TTL))
        self.auth_lock = threading.Lock()
        self.login_failures = {}
        self.started = now()
        self.data = DataService(self,self.cache)

    def db_loop(self):
        """Catch up bounded batches promptly; idle and failed writes yield their budget."""
        while not self.stop.is_set():
            more=False
            try:
                # 事件库要自己 tail 日志，不能依赖前端有没有请求
                more=self.store.ingest()
                self.db.flush()
                generation = self.db.network_generation
                self.db.maintain()
                if generation != self.db.network_generation:
                    self.data.wake.set()
            except Exception:  # noqa: BLE001
                pass
            self.stop.wait(.05 if more and not self.db.write_error else .5 if not self.db.write_error else 2)

    def login_throttled(self, ip):
        with self.auth_lock:
            item = self.login_failures.get(ip)
            if not item:
                return False
            count, first = item
            if now() - first > LOGIN_WINDOW:
                self.login_failures.pop(ip, None)
                return False
            return count >= LOGIN_MAX_FAIL

    def note_login_failure(self, ip):
        with self.auth_lock:
            item = self.login_failures.get(ip)
            if not item or now() - item[1] > LOGIN_WINDOW:
                self.login_failures[ip] = (1, now())
            else:
                self.login_failures[ip] = (item[0] + 1, item[1])

    def clear_login_failures(self, ip):
        with self.auth_lock:
            self.login_failures.pop(ip, None)

    @staticmethod
    def _overview_push(params, low=None, high=None):
        """Exact chart dimensions only; never execute a client-supplied SQL expression."""
        clauses, args = [], []
        def evidence(predicate, values=()):
            if low is None or high is None:
                clauses.append(predicate);args.extend(values);return
            clauses.append("(session_id IN (SELECT session_id FROM events WHERE ts>=? AND ts<=? AND "+predicate+
                           " AND COALESCE(session_id,'')!='') OR (COALESCE(session_id,'')='' AND "+predicate+"))")
            from overview_metrics import range_bound
            args.extend([range_bound(low),range_bound(high),*values,*values])
        detection = params.get('detection')
        if detection:
            predicate = {'alerts': EventDB.DETECTION_SQL,
                         'high': EventDB.DETECTION_SQL+' AND sev=1',
                         'drops': EventDB.BLOCKED_SQL}.get(detection)
            if predicate is None:
                raise ValueError('检测筛选无效')
            evidence('('+predicate+')')
        fields = {'src':'src', 'dst':'dst', 'sig':'sig', 'app':'app',
                  'proto':'proto', 'dns':'dnsname', 'sni':'sni', 'type':'type'}
        for key, column in fields.items():
            missing = key in ('app','proto','dns','sni') and params.get('missing_'+key) == '1'
            if key in params or missing:
                value = params.get(key, '')
                if not isinstance(value, str) or len(value) > 1024:
                    raise ValueError('概览筛选值无效')
                if key == 'type' and value not in (*BASE_EVENT_TYPES, *APP_EVENT_TYPES):
                    raise ValueError('记录类型无效')
                predicate=column+'=?' if value else 'COALESCE('+column+",'')=?"
                if key in ('app','proto'):
                    predicate='LOWER(COALESCE('+column+",''))=?";value=value.lower()
                if key=='app' and low is not None and high is not None:
                    from overview_metrics import application_cohort
                    clause,values=application_cohort(value,low,high);clauses.append(clause);args.extend(values)
                elif key in ('src','dst','proto'):
                    clauses.append(predicate);args.append(value)
                else:evidence(predicate,[value])
        if 'connection' in params:
            if params['connection']!='1':raise ValueError('连接筛选无效')
            clauses.append("(COALESCE(session_id,'')!='' OR type='flow')")
        if 'sid' in params:
            try:
                value = int(params['sid'])
                if not 0 < value <= 0xffffffff:
                    raise ValueError()
            except (TypeError, ValueError, OverflowError):
                raise ValueError('签名标识无效') from None
            evidence('sid=?',[value])
        return clauses, args

    def overview_runtime(self, panel=False):
        svc = self.sys.service()
        counters = self.sys.counters()
        ruleset = self.sys.ruleset()
        queue = self.sys.queue()
        rates = self.sys.current_rates()
        ips = counters.get("ips", {}) if isinstance(counters, dict) else {}
        drops = ips.get("drop_reason", {}) if isinstance(ips, dict) else {}
        if panel:
            svc = {key:svc.get(key) for key in ('state','memory','uptime')}
            queue = {key:queue.get(key) for key in ('packets','kernel_drops')}
        return {
            'telemetry':self.sys.telemetry(),
            "service": svc,
            "rates": rates,
            "queue": queue,
            "ips": {
                "accepted": ips.get("accepted"),
                "blocked": ips.get("blocked"),
                "rejected": ips.get("rejected"),
                "rule_drops": (drops or {}).get("rules"),
                "engine_drops": sum(v for k, v in (drops or {}).items() if k != "rules"),
                "drop_reasons": {k: v for k, v in (drops or {}).items() if v},
            },
            "rules": {
                "loaded": ruleset.get("rules_loaded"),
                "failed": ruleset.get("rules_failed"),
                "skipped": ruleset.get("rules_skipped"),
                "reload": self.sys.reload_state(),
            },
        }

    def sample_overview_runtime(self):
        if self.data.overview_runtime is None or time.monotonic() < self.data.overview_active_until:
            self.data.overview_runtime = self.overview_runtime(panel=True)

    @data_query()
    def overview(self, params=None):
        params = params or {}
        try:
            stamp = now()
            window = max(1, min(43200, int(params.get('window') or 1440)))
            low = float(params['from']) if params.get('from') else stamp - window * 60
            high = float(params['to']) if params.get('to') else stamp
            if not (math.isfinite(low) and math.isfinite(high)) or low < 0 or high < low:
                raise ValueError('invalid time range')
        except (TypeError, ValueError, OverflowError):
            raise ValueError('时间参数无效')
        window = max(1, math.ceil((high - low) / 60))
        push = self._overview_push(params, low, high)
        if window <= 15:
            bucket = 1      # 15 分钟视图：1 分钟一个点
        elif window <= 60:
            bucket = 2      # 1 小时视图：2 分钟一个点
        elif window <= 360:
            bucket = 15     # 6 小时视图：15 分钟一个点
        else:
            bucket = max(60, math.ceil(window / 720))
        if not hasattr(self,'data'):
            self.store.ingest()
        building = getattr(self, '_building_first_page', False)
        panel = params.get('view') == 'panel'
        runtime = self.data.overview_runtime if building else None
        if runtime is None:
            runtime = self.overview_runtime(panel)
        agg = self.db.security_summary(window=window, topn=5, dedup=True, start=low, end=high, push=push, panel=panel)
        _, recent = self.db.search_range(low, high, limit=10, list_view=True, push=push, include_total=False)
        network_push=self._overview_push(params,('range','start'),('range','end'))
        network = (self.db.empty_network(None) if building else
                   self.network.get(low, high, rolling=('fixed_start' if params.get('from') else 'rolling') if not params.get('to') else False, push=network_push))
        try:
            ingest_lag = max(0, os.stat(EVE).st_size - self.store.offset)
        except OSError:
            ingest_lag = None
        result = {
            "ts": now(),
            **runtime,
            "series": self.db.security_series(window, bucket, start=low, end=high, push=push),
            "coverage": int(now() - agg["oldest"]) if agg.get("oldest") else 0,
            "security": agg,
            "network": network,
            "sensor": {"ingest_lag_bytes": ingest_lag,
                       "error": self.store.last_error or self.db.last_error,
                       "scope": "Snort 配置的采集范围",
                       "limitations": "可见性取决于采集位置、双向流量和协议加密"},
            "window": window,
            "range": [low, high],
            "bucket": bucket,
            "top": dict(signatures=agg['signatures'],sources=network.get('log_sources',[]),destinations=network.get('log_destinations',[])),
            "recent": recent,
            "events_total": len(self.store.events),
        }
        if panel:
            result['security'] = {key:agg[key] for key in ('total','alerts','drops','high','sources_count','destinations_count')}
            if agg.get('error'):
                result['security']['error'] = agg['error']
            for key in ('coverage','sensor','events_total'):
                result.pop(key,None)
        return result

    @staticmethod
    def _incident_range(params):
        try:
            window = max(1, min(43200, int(params.get("window") or 1440)))
            low = float(params["from"]) if params.get("from") else now() - window * 60
            high = float(params["to"]) if params.get("to") else now()
            if not (math.isfinite(low) and math.isfinite(high)) or low < 0 or high < low:
                raise ValueError("invalid time range")
            return low, high
        except (ValueError, TypeError, OverflowError):
            raise ValueError("时间参数无效")

    @data_query(pages=True)
    def incidents(self, params):
        if not hasattr(self,'data'):
            self.store.ingest()
        low, high = self._incident_range(params)
        try:
            offset = max(0, int(params.get("offset") or 0))
            limit = min(500, max(1, int(params.get("limit") or 50)))
            sev = int(params["sev"]) if params.get("sev") else None
            if sev is not None and sev not in (1, 2, 3, 4):
                raise ValueError("invalid severity")
        except (ValueError, TypeError, OverflowError):
            raise ValueError("分页或级别参数无效")
        total, incidents = self.db.security_incidents(
            low, high, sev=sev, proto=params.get("proto") or None,
            q=(params.get("q") or "").strip(), offset=offset, limit=limit)
        return {"total": total, "incidents": incidents, "source": "db", "range": [low, high],
                "error": self.db.last_error or None}

    @data_query(cache=False)
    def incident(self, params):
        if not hasattr(self,'data'):
            self.store.ingest()
        low, high = self._incident_range(params)
        incident_id = params.get("id") or ""
        if not re.fullmatch(r"(?:session:[0-9a-f]{32}:[0-9a-f]{16}|event:[0-9a-f]{64}|record:[0-9]+:[0-9.e+\-]+)", incident_id):
            raise ValueError("安全事件标识无效")
        network_offset = max(0, int(params.get('network_offset') or 0))
        network_limit = min(500, max(1, int(params.get('network_limit') or 50)))
        try:
            result = self.db.security_incident(incident_id, low, high, network_offset, network_limit,
                                              list_view=params.get('view')=='list')
        except sqlite3.Error as exc:
            message = '安全事件查询中断或超时，请重试或缩小时间范围' if str(exc)=='interrupted' else '安全事件查询失败：'+str(exc)
            raise RuntimeError(message) from exc
        if result is None:
            return {"error": "安全事件不存在或不在所选时间范围内"}
        result["range"] = [low, high]
        return result

    @data_query(pages=True)
    def events(self, params):
        if not hasattr(self,'data'):
            self.store.ingest()
        try:
            window = max(1, min(43200, int(params.get("window") or 60)))
            low = float(params["from"]) if params.get("from") else now() - window * 60
            high = float(params["to"]) if params.get("to") else now()
            limit = min(CSV_EXPORT_LIMIT if params.get("format") == "csv" else 500,
                        max(1, int(params.get("limit") or 100)))
            offset = max(0, int(params.get("offset") or 0))
            if not (math.isfinite(low) and math.isfinite(high)) or low < 0 or high < low:
                raise ValueError("invalid time range")
            sev = [int(x) for x in (params.get("sev") or "").split(",") if x.strip()]
        except (ValueError, TypeError, OverflowError):
            raise ValueError("时间、分页或级别参数无效")
        clauses, args = [], []
        if sev:
            clauses.append("sev IN (%s)" % ",".join("?" * len(sev)))
            args.extend(sev)
        if params.get('detection'):
            if params['detection']!='alerts':raise ValueError('检测筛选无效')
            clauses.append(EventDB.DETECTION_SQL)
        for key in ("proto", "action"):
            if params.get(key):
                clauses.append("LOWER(%s) = ?" % key)
                args.append(params[key].lower())
        keyword = (params.get("q") or "").strip().lower()
        if keyword:
            columns = ("sig", "src", "dst", "app", "reason", "cat", "proto", "sport", "dport")
            clauses.append("(" + " OR ".join("INSTR(LOWER(COALESCE(%s,'')), ?) > 0" % (FLOW_SIG_SQL if c == 'sig' else c)
                                             for c in columns) + ")")
            args.extend([keyword] * len(columns))
        etype = params.get("type")
        types = [etype] if etype and etype != "all" else None
        total, rows = self.db.search_range(low, high, types=types, limit=limit,
                                           offset=offset, push=(clauses, args),
                                           list_view=params.get('view')=='list' and params.get('format')!='csv')
        result = {"total": total, "events": rows, "source": "db", "range": [low, high],
                  "error": self.db.last_error or None}
        if getattr(self, '_building_first_page', False):
            result['aggregate'] = self.db.security_summary(window=window, topn=8, etype='drop',
                                                           start=low, end=high)
        return result

    @data_query()
    def aggregate(self, params):
        if not hasattr(self,'data'):
            self.store.ingest()
        try:
            window = max(1, min(43200, int(params.get("window") or 60)))
            start = float(params["from"]) if params.get("from") else None
            end = float(params["to"]) if params.get("to") else None
            low, high = now() - window * 60 if start is None else start, now() if end is None else end
            if not (math.isfinite(low) and math.isfinite(high)) or low < 0 or high < low:
                raise ValueError("invalid time range")
        except (ValueError, TypeError, OverflowError):
            raise ValueError("时间参数无效")
        if not any(params.get(key) for key in ("sev", "proto", "action", "q")):
            return self.db.security_summary(window=window, topn=8, etype=params.get("type") or "all", start=start, end=end)
        sev = None
        if params.get("sev"):
            sev = {int(x) for x in params["sev"].split(",") if x.strip().isdigit()}
        clauses,args = [],[]
        if sev:
            clauses.append('sev IN ('+','.join('?' for _ in sev)+')')
            args.extend(sorted(sev))
        for key in ('proto','action'):
            if params.get(key):
                clauses.append('LOWER('+key+')=?')
                args.append(params[key].lower())
        keyword = (params.get('q') or '').strip().lower()
        if keyword:
            columns = ('sig','src','dst','app','reason','cat','proto','sport','dport')
            clauses.append('('+' OR '.join('INSTR(LOWER(COALESCE('+col+",'')),?)>0" for col in columns)+')')
            args.extend([keyword]*len(columns))
        return self.db.security_summary(window=window,topn=8,etype=params.get('type') or 'all',
                                        start=low,end=high,push=(clauses,args))

