def suppress_groups_add(groups, sids=()):
    """Persist source-qualified group policies; render current members natively."""
    catalog = rule_group_catalog()
    targets = set()
    for value in sids:
        try:
            gid,sid=signature_identity(value)
            if not (1<=gid<=4294967295 and 1<=sid<=4294967295):raise ValueError('Invalid identity')
            targets.add(signature_key(sid,gid))
        except ValueError:
            return {"ok": False, "message": "无效 SID：" + str(value)}
    requested_policies=set()
    for name in groups:
        matches = [row for row in catalog if group_matches(name,row['name'],row['source']) and row["source_enabled"] is not False]
        if not matches:
            return {"ok": False, "message": "规则分组不可用：" + name}
        for row in matches:
            requested_policies.add(group_selector(row['name'],row['source']))
    if not targets and not groups:
        return {"ok": False, "message": "所选分组没有规则"}
    targets.discard(0)
    with threshold_lock():
        policies=set(group_suppression_policies())
        added_groups=len(requested_policies-policies)
        try:original=Path(THRESHOLD_CONF).read_text()
        except FileNotFoundError:original=''
        configured={signature_key(match[2],match[1]) for line in original.splitlines()
                    if (match:=_SUPPRESS_IDS.match(suppression_line(line))) and int(match[1]) and int(match[2])}
        pending = sorted(targets - configured, key=signature_identity)
        text = original + ("\n" if original and not original.endswith("\n") else "")
        text += ''.join('suppress gen_id %d, sig_id %d\n' % signature_identity(token) for token in pending)
        save_group_suppressions(policies|requested_policies)
        write_thresholds(text)
    return {"ok": True, "added": len(pending), 'added_groups':added_groups, "skipped": len(targets) - len(pending),
            "message": "已添加 %d 个组策略、%d 条手动抑制" % (added_groups,len(pending))}


def suppress_groups_remove(groups):
    """Match the current group inventory; remove each matching signature once."""
    catalog, targets = rule_group_catalog(), set()
    if not groups:
        return {"ok": False, "message": "请选择规则分组"}
    policies=set(group_suppression_policies());removed_policies=set()
    for name in groups:
        selected={value for value in policies if any(group_matches(name,row['name'],row['source']) and group_matches(value,row['name'],row['source']) for row in catalog)}
        if name in policies:selected.add(name)
        if selected:
            removed_policies.update(selected);continue
        matches = [row for row in catalog if group_matches(name,row['name'],row['source'])]
        if not matches:
            return {"ok": False, "message": "规则分组不存在，请刷新后重试：" + name}
        for row in matches:
            targets.update(_GROUP_CACHE.get("members", {}).get((row['name'], row["source"]), set()))
    with threshold_lock():
        save_group_suppressions(policies-removed_policies)
    result=suppress_remove_many(targets-{0}) if targets else dict(ok=True,removed=0)
    if removed_policies:prepare_thresholds()
    result['removed_groups']=len(removed_policies)
    return result


