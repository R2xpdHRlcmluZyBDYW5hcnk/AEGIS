class RuleBook:
    def __init__(self):
        self.lock = threading.Lock()
        self.cache = {"key": None, "value": None}

    @staticmethod
    def _category(msg):
        words = msg.split()
        if not words:
            return "other"
        first = words[0].rstrip(":")
        if first == "ET" and len(words) > 1:
            return "ET " + words[1].rstrip(":")
        if first in ("Feodo", "SSL", "URLhaus", "TrafficID", "Stamus", "PT", "ETN", "abuse.ch"):
            if len(words) > 1:
                return first + " " + words[1].rstrip(":")
            return first
        if first.startswith("GPL"):
            return "GPL"
        return first

    def categories(self):
        try:
            st = os.stat(RULES_FILE)
            key = (st.st_mtime, st.st_size)
        except OSError:
            return []
        with self.lock:
            if self.cache["key"] == key:
                return self.cache["value"]
        counts = Counter()
        drops = Counter()
        try:
            with open(RULES_FILE, "r", encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    if line[:1] in ("#", "\n", None):
                        continue
                    match = _RULE_LINE.match(line)
                    if not match:
                        continue
                    msg = match.group(2)
                    cat = self._category(msg)
                    counts[cat] += 1
                    if line.startswith(("block ", "drop ", "reject ")):
                        drops[cat] += 1
        except OSError:
            return []
        value = [{"category": c, "count": n, "drop": drops.get(c, 0)}
                 for c, n in counts.most_common(40)]
        with self.lock:
            self.cache = {"key": key, "value": value}
        return value

    @staticmethod
    def sources():
        out = []
        try:
            for name in sorted(os.listdir(SOURCES_DIR)):
                if not name.endswith(".yaml") or name.startswith("index"):
                    continue
                out.append(name[:-5])
        except OSError:
            pass
        return out

    @staticmethod
    def local_rules():
        try:
            with open(LOCAL_RULES, "r", encoding="utf-8", errors="replace") as fh:
                return fh.read().splitlines()
        except OSError:
            return []

    # -- 封禁：JSON 事实源 + 生成独立规则文件 ---------------------------
    @staticmethod
    def _load_bans():
        try:
            with open(BAN_STORE, "r", encoding="utf-8") as fh:
                data = json.load(fh)
            if isinstance(data, list):
                return [b for b in data if isinstance(b, dict) and b.get("value")]
        except (OSError, ValueError):
            pass
        return []

    @staticmethod
    def _save_bans(entries):
        tmp = BAN_STORE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(entries, fh, ensure_ascii=False, indent=1)
        os.replace(tmp, BAN_STORE)

    @staticmethod
    def _domain_rules(domain, proto, sid):
        """域名封禁：精确匹配 + 子域后缀匹配；proto 取 tls/http/dns"""
        from snort_rules import domain_app
        d = domain.lower()
        if proto == 'tls':
            return ['block ip any any -> any any (msg:"ips-web ban domain %s"; appids:"%s"; sid:%d; rev:1;)' % (d, domain_app(d), sid)]
        if proto == 'http':
            pattern = re.escape(d).replace('/', r'\/')
            return ['block http any any -> any any (msg:"ips-web ban HTTP domain %s"; http_header:field host; pcre:"/(?:^|\\.)%s(?::[0-9]+)?$/i"; sid:%d; rev:1;)' % (d, pattern, sid)]
        labels = d.encode('idna').split(b'.')
        wire = ''.join('|%02x|' % len(label) + label.decode('ascii') for label in labels) + '|00|'
        return ['block dns any any -> any any (msg:"ips-web ban DNS domain %s"; flow:to_server; content:"%s",nocase; sid:%d; rev:1;)' % (d, wire, sid)]

    @staticmethod
    def _render_rules(entries):
        lines = [
            "# 由 ips-web 生成：封禁列表（IP / 域名），请勿手改",
            "# 修改请用控制台“规则 → 封禁列表”，点击应用更改后生效",
        ]
        sid = BAN_SID_BASE
        for entry in entries:
            kind = entry.get("type") or "ip"
            value = (entry.get("value") or "").strip()
            if not value:
                continue
            if kind == "domain":
                lines.append("# domain %s" % value)
                for proto in ("tls", "http", "dns"):
                    lines.extend(RuleBook._domain_rules(value, proto, sid))
                    sid += 2
                for ip in entry.get("ips") or []:
                    lines.append('block ip any any <> %s any (msg:"ips-web ban %s (%s)"; sid:%d; rev:1;)'
                                 % (ip, value, ip, sid))
                    sid += 1
            else:
                lines.append("# ip %s" % value)
                # proto 用 ip：TCP/UDP/ICMP 全部覆盖
                lines.append('block ip any any <> %s any (msg:"ips-web ban %s"; sid:%d; rev:1;)'
                             % (value, value, sid))
                sid += 1
        return "\n".join(lines) + "\n"

    @staticmethod
    def _write_ban_rules(entries):
        text = RuleBook._render_rules(entries)
        tmp = BAN_RULES + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(text)
        os.replace(tmp, BAN_RULES)
        from snort_rules import domain_detector
        atomic_text(BAN_DETECTOR, domain_detector(entries))
        return text

    @staticmethod
    def bans():
        return RuleBook._load_bans()

    @staticmethod
    def resolve_domain(domain):
        """解析域名 A/AAAA，用于同时生成 IP 规则（这样 ICMP 也能被拦）"""
        out = []
        try:
            proc = subprocess.run(["getent", "ahosts", domain],
                                  capture_output=True, text=True, timeout=5)
            for line in proc.stdout.splitlines():
                parts = line.split()
                if parts and parts[0] not in out:
                    out.append(parts[0])
        except (OSError, subprocess.SubprocessError):
            pass
        return out[:8]

    @staticmethod
    def valid_ip(value):
        for family in (socket.AF_INET, socket.AF_INET6):
            try:
                socket.inet_pton(family, value)
                return True
            except OSError:
                continue
        return False

    @staticmethod
    def parse_target(raw):
        value = (raw or "").strip().strip("[]").strip().lower().rstrip(".")
        if not value:
            return None, "empty target"
        if RuleBook.valid_ip(value):
            return {"type": "ip", "value": str(ip_address(value))}, None
        if len(value) > 253 or "." not in value:
            return None, "invalid ip or domain"
        if not re.fullmatch(r"[a-z0-9]([a-z0-9._-]*[a-z0-9])?", value):
            return None, "invalid domain"
        return {"type": "domain", "value": value}, None

    @staticmethod
    def ban(target):
        entry, err = RuleBook.parse_target(target)
        if err:
            return False, err
        entries = RuleBook._load_bans()
        for old in entries:
            old_entry, _ = RuleBook.parse_target(old.get("value"))
            if old_entry == entry:
                return False, "already banned"
        entry["created"] = time.strftime("%Y-%m-%d %H:%M")
        if entry["type"] == "domain":
            entry["ips"] = RuleBook.resolve_domain(entry["value"])
        entries.append(entry)
        RuleBook._save_bans(entries)
        RuleBook._write_ban_rules(entries)
        return True, "ok"

    @staticmethod
    def unban(target):
        value = (target or "").strip().strip("[]").strip().lower().rstrip(".")
        entries = RuleBook._load_bans()
        remain = [e for e in entries if e.get("value") != value]
        if len(remain) == len(entries):
            return False, "not found"
        RuleBook._save_bans(remain)
        RuleBook._write_ban_rules(remain)
        return True, "ok"

