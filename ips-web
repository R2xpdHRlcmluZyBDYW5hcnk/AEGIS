    @data_query(cache=False)
    def session_events(self, params):
        identity=str(params.get('session_id') or '')
        if not re.fullmatch(r'[0-9a-f]{32}:[0-9a-f]{16}',identity):
            raise ValueError('会话 ID 无效')
        offset=max(0,int(params.get('offset') or 0))
        limit=min(100,max(1,int(params.get('limit') or 50)))
        low,high=self.db.history_range()
        total,records=self.db.search_range(low,high,push=(['session_id=?'],[identity]),
                                          limit=limit,offset=offset,list_view='network')
        return dict(session_id=identity,total=total,events=records,offset=offset,limit=limit)

    @data_query(cache=False)
    def summary_context(self, target):
        """Resolve trusted record identity and search only its engine-owned session."""
        if not isinstance(target, dict):
            raise ValueError('需要事件标识')
        if target.get('kind') == 'record':
            detail = self.db.read_record(target.get('key',''), include_raw=False)
            if not detail:
                raise ValueError('事件已不存在或已超过保留范围')
            anchor = detail['record']
        elif target.get('kind') == 'event':
            raw = self.store.detail(int(target.get('id')))
            parsed = self.store._parse(raw) if raw is not None else None
            if not parsed:
                raise ValueError('事件明细已不在缓存中')
            anchor = parsed[0]
        elif target.get('kind') == 'incident':
            params = target.get('params')
            identity = params.get('id') if isinstance(params, dict) else None
            if not isinstance(identity,str) or not re.fullmatch(r'(?:session:[0-9a-f]{32}:[0-9a-f]{16}|event:[0-9a-f]{64}|record:[0-9]+:[0-9.e+\-]+)',identity):
                raise ValueError('安全事件标识无效')
            conditions, args = self.db.incident_filter(identity)
            rows = self.db.context_records(' AND '.join(conditions),args)
            if not rows:
                raise ValueError('事件已不存在或已超过保留范围')
            anchor = rows[0]
        else:
            raise ValueError('不支持的事件类型')
        session = anchor.get('session_id')
        if session:
            context = self.db.session_context(session)
            if context:
                context['anchor'] = anchor
                return context
        return dict(scope='event', session_id='', total_records=1,
                    first_ts=anchor.get('ts'), last_ts=anchor.get('ts'),
                    event_counts={anchor.get('type','unknown'):1}, action_counts={},
                    records=[anchor], anchor=anchor)

    @data_query(cache=False,seconds=3)
    def summary_dns_context(self, params):
        from dns_context import candidates
        try:
            if 'target' in params:
                context = self.summary_context(params['target'])
            else:
                session = params.get('session_id')
                if not isinstance(session,str) or not re.fullmatch(r'[0-9a-f]{32}:[0-9a-f]{16}',session):
                    raise ValueError('DNS 关联需要事件标识或引擎会话 ID')
                context = self.db.session_context(session)
            return candidates(self.db,context) if context else dict(status='not_found',records=[])
        except sqlite3.Error:
            raise RuntimeError('DNS 关联检索未完成') from None

    @data_query(cache=False,seconds=3)
    def summary_hunt(self, params):
        """Model-selected metadata predicates across nearby, independent sessions."""
        query=params.get('query')
        if not isinstance(query,str) or not 0<len(query.strip())<=240:
            raise ValueError('狩猎搜索词为空或过长')
        try:node=hunt_parse(query)
        except HuntError as exc:raise ValueError('狩猎语法无效：'+str(exc)) from None
        from llm_hunting import FIELDS
        allowed={HUNT_FIELDS[field] for field in FIELDS if field in HUNT_FIELDS}
        nodes=0;concrete=False
        def validate(term,depth=0):
            nonlocal nodes,concrete
            nodes+=1
            if depth>12 or nodes>48:raise ValueError('狩猎条件过于复杂')
            if term[0] in ('and','or'):
                validate(term[1],depth+1);validate(term[2],depth+1)
            elif term[0]=='not':validate(term[1],depth+1)
            elif term[0]!='cmp' or term[1] not in allowed or len(term[2])>240:
                raise ValueError('狩猎搜索词包含不支持的字段或条件')
            elif term[2].strip('*?'):concrete=True
        validate(node)
        if not concrete:raise ValueError('狩猎条件需要具体的元数据条件')
        where,args,complete=hunt_sql_pushdown(node,True)
        if not complete:raise ValueError('狩猎条件不能执行有界结构化查询')
        try:context=self.summary_context(params.get('target'))
        except sqlite3.Error:raise RuntimeError('关联检索上下文读取未完成') from None
        first,last=context['first_ts'],context['last_ts']
        if not all(isinstance(stamp,(int,float)) and math.isfinite(stamp) for stamp in (first,last)):
            raise ValueError('事件缺少有效时间')
        low=max(first-900,last-1800);high=last+900
        conditions=['ts>=?','ts<=?',*where];bound=[low*1000,high*1000,*args]
        display='('+query+') AND time:['+str(low)+' TO '+str(high)+']'
        session=context.get('session_id')
        if session:
            conditions.append("COALESCE(session_id,'')<>?");bound.append(session)
            display+=' AND NOT session_id:'+json.dumps(session)
        else:
            # Without session identity, exclude the anchor's event type and timestamp.
            anchor_type = context['anchor']['type']
            conditions.append('NOT (type=? AND ts/1000.0=?)')
            bound.extend([anchor_type, first])
            display += ' AND NOT (type:'+json.dumps(anchor_type)+' AND time:'+str(first)+')'
        condition=' AND '.join(conditions)
        with self.db.lock:
            self.db._hunt_functions()
            try:
                total=self.db.conn.execute('SELECT COUNT(*) FROM events WHERE '+condition,bound).fetchone()[0]
                ids=[row[0] for row in self.db.conn.execute("""WITH matched AS (
                    SELECT id,ts,type,session_id FROM events WHERE """+condition+"""), ranked AS (
                    SELECT id,ts,ROW_NUMBER() OVER (PARTITION BY
                      CASE WHEN COALESCE(session_id,'')!='' THEN session_id ELSE 'row:'||id END
                      ORDER BY (type NOT IN ('session','flow')) DESC,ts DESC,id DESC) position FROM matched)
                    SELECT id FROM ranked WHERE position=1 ORDER BY ts DESC,id DESC LIMIT 4""",bound)]
                records=self.db.context_records('id IN ('+','.join('?' for _ in ids)+')',ids,len(ids)) if ids else []
                sessions=list(dict.fromkeys(row['session_id'] for row in records if row.get('session_id')))
                if sessions:
                    known=dict(self.db.conn.execute('SELECT session_id,COUNT(*) FROM events WHERE session_id IN ('+
                        ','.join('?' for _ in sessions)+') AND '+EventDB.DETECTION_SQL+' GROUP BY session_id',sessions))
                    for row in records:
                        if row.get('session_id'):row['_retained_detections']=known.get(row['session_id'],0)
            except sqlite3.Error:raise RuntimeError('关联检索超时、中断或未完成') from None
        return dict(query=display,predicate=query,total=total,records=records,scope='related',range=[low,high],
                    excluded_current_session=bool(session),sampled=total>len(records))

    def cache_stats(self):
        try:
            process = {key:int(value.split()[0])*1024 for line in Path('/proc/self/status').read_text().splitlines()
                       for key,value in [line.split(':',1)] if key in ('VmRSS','VmHWM')}
        except (OSError,ValueError):
            process = {}
        return dict(responses=self.cache.stats(),budget_bytes=self.cache_budget,
                    read_workers=self.data.read_workers,statistics_batch_size=self.analytics.batch_size,
                    statistics_duty_percent=self.analytics.duty_percent,
                    record_buffer_bytes=sum(getattr(pool,'bytes',0) for pool in (self.store.events,self.store.strong)),
                    offset_bytes=sys.getsizeof(self.store.offsets),
                    minute_index_bytes=object_bytes(self.store.minute_index)+object_bytes(self.store.buckets),
                    process_rss_bytes=process.get('VmRSS'),process_peak_bytes=process.get('VmHWM'),
                    statistics_ready=self.analytics.ready,statistics_error=self.analytics.error)

    @data_query(pages=True)
    def hunt(self, params):
        try:
            window = int(params.get("window") or 60)
        except (TypeError, ValueError):
            window = 60
        try:
            offset = max(0, int(params.get("offset") or 0))
        except (TypeError, ValueError):
            offset = 0
        try:
            limit = min(CSV_EXPORT_LIMIT if params.get("format") == "csv" else 500, max(1, int(params.get("limit") or 100)))
        except (TypeError, ValueError):
            limit = 100
        query = (params.get("q") or "").strip()
        # 时间范围：优先用安全事件页那套 from/to（预设或自定义），否则按 window 分钟
        if params.get("all") == "1":
            low_all, high_all = self.db.history_range()
            params = dict(params, **{"from": str(low_all), "to": str(high_all)})
        raw_from = params.get("from")
        raw_to = params.get("to")
        if raw_from or raw_to:
            try:
                low_ts = float(raw_from) if raw_from else now() - window * 60
                high_ts = float(raw_to) if raw_to else now()
            except (TypeError, ValueError):
                return {"error": "时间区间参数无法解析（应为 Unix 秒）", "total": 0,
                        "events": [], "query": query}
            if not (math.isfinite(low_ts) and math.isfinite(high_ts)) or high_ts < low_ts:
                return {"error": "时间区间无效", "total": 0, "events": [], "query": query}
            window = max(1, int((high_ts - low_ts) / 60) + 1)
        else:
            low_ts, high_ts = now() - window * 60, now()

        query = (params.get("q") or "").strip()
        matcher = None
        db_matcher = None
        matcher_spec = None
        query_spec = None
        exact_cpu_scan = False
        need_raw = False
        push_sql, push_args = [], []
        used = set()
        if query:
            try:
                node = hunt_parse(query)
            except HuntError as exc:
                return {"error": "查询语法错误: %s" % exc, "total": 0, "events": [], "query": query}
            icase = (params.get("icase") or "") in ("1", "true", "yes")
            query_spec=(node,icase)
            matcher = lambda ev: hunt_match(node, ev, icase)  # noqa: E731
            used = hunt_used_fields(node)
            need_raw = any(field not in DB_COLUMN_FIELDS for field in used)
            push_sql, push_args, push_full = hunt_sql_pushdown(node, icase)
            if node[0]=='cmp' and node[1]=='tuple_hash' and re.fullmatch('[0-9a-f]{64}',node[2]):
                push_sql,push_args = self.db.association_filter('tuple:'+node[2])
                push_full=True
            if not used.isdisjoint(MITRE_FIELDS) and getattr(self.db,'cpu',None) is not None:
                exact_cpu_scan=push_full
                push_sql,push_args,_=hunt_sql_pushdown(node,icase,metadata=False)
                push_full=False;need_raw=True
            db_matcher = None if push_full else matcher
            if db_matcher is not None:matcher_spec=(node,icase)
        source = (params.get("source") or "").strip()
        if source == "file":
            extra = dict(matcher_spec=query_spec,cancelled=getattr(self.db,'cpu_cancelled',None)) if getattr(self.store,'cpu',None) is not None else {}
            total, rows = self.store.search_history(window=window, matcher=matcher,
                                                   limit=limit, offset=offset,**extra)
            return {"total": total, "events": rows, "query": query, "source": "file"}
        explicit_range = bool(raw_from or raw_to)
        # 显式时间区间：只用事件库，避免回落到"以现在为终点"的内存缓冲
        if explicit_range and source != "memory":
            # A pinned rolling page keeps the scan budget of its first page.
            max_scan = 300000 if params.get('window') and params.get('all') != '1' else 120000
            total, rows = self.db.search_range(low_ts, high_ts, matcher=db_matcher,
                                                     limit=limit, offset=offset,
                                                     need_raw=need_raw, max_scan=float('inf') if exact_cpu_scan else max_scan,
                                                     fields=used,
                                                     list_view=params.get('view')=='list',
                                                     push=(push_sql, push_args) if push_sql else None,matcher_spec=matcher_spec)
            return {"total": total, "events": rows, "query": query, "source": "db",
                    "range": [low_ts, high_ts], "truncated": self.db.last_truncated}
        # 默认走事件库（有索引、覆盖完整）；库为空时退回内存缓冲
        if source != "memory":
            total, rows = self.db.search_range(low_ts, high_ts, matcher=db_matcher,
                                                     limit=limit, offset=offset,
                                                     need_raw=need_raw, fields=used, max_scan=float('inf') if exact_cpu_scan else 300000,
                                                     list_view=params.get('view')=='list',
                                                     push=(push_sql, push_args) if push_sql else None,matcher_spec=matcher_spec)
            if total or source == "db" or params.get('view')=='list':
                return {"total": total, "events": rows, "query": query, "source": "db",
                        "range": [low_ts, high_ts], "truncated": self.db.last_truncated}
        # 显式勾选"检索日志"时才扫文件（扫 200MB 要几秒，不默认做）
        extra = dict(matcher_spec=query_spec,cancelled=getattr(self.db,'cpu_cancelled',None)) if getattr(self.store,'cpu',None) is not None else {}
        total, rows = self.store.query(window=window,offset=offset,limit=limit,matcher=matcher,**extra)
        return {"total": total, "events": rows, "query": query, "source": "memory"}

