def suppress_remove_many(sids, gid=None, required=False):
    """One pass and one atomic write, including inactive suppression comments."""
    targets = {signature_key(sid, gid) if gid is not None else signature_key(sid) for sid in sids}
    with threshold_lock():
        try:
            with open(THRESHOLD_CONF, encoding="utf-8") as handle:
                lines = handle.readlines()
        except FileNotFoundError:
            lines = []
        keep, removed, entries = [], set(), 0
        for line in lines:
            match = _SUPPRESS_IDS.match(suppression_line(line))
            token = signature_key(match[2], match[1]) if match and int(match[1]) and int(match[2]) else None
            if token in targets:
                removed.add(token); entries += 1
            else:
                keep.append(line)
        if required and targets - removed:
            raise ValueError("部分抑制条目已变化，请刷新后重试")
        if removed:
            atomic_text(THRESHOLD_CONF, "".join(keep))
    return {"ok": True, "removed": len(removed), "removed_entries": entries,
            "message": "已保存移除 %d 个 SID 的抑制，点击‘应用更改’生效" % len(removed)}


def _append_line(path, line):
    """追加一行；文件末尾没有换行时先补一个，避免和最后一行粘在一起"""
    data = b""
    try:
        with open(path, "rb") as handle:
            data = handle.read()
    except OSError:
        data = b""
    with open(path, "ab") as handle:
        if data and not data.endswith(b"\n"):
            handle.write(b"\n")
        handle.write(line.encode("utf-8") + b"\n")


_SELECTOR_MARKER_RE = re.compile(r"\s*#\s*ips-web-selector-b64=([A-Za-z0-9_\-=]+)\s*$")


def canonical_selector(value):
    text = str(value or "").strip()
    if text.isdigit():
        return "sid:" + str(int(text))
    kind, separator, code = text.partition(":")
    if not separator:
        return text
    kind, code = kind.lower().strip(), code.strip()
    if kind=='group-source':
        source,name=parse_group(text)
        return group_selector(name,source)
    if kind == "sid" and code.isdigit():
        code = str(int(code))
    elif kind == 'sid' and re.fullmatch(r'\d+:\d+',code):
        return signature_selector(code)
    if kind == "group" and code.endswith(".rules"):
        code = code[:-6]
    return kind + ":" + code


def configured_selectors(scope, gov=None):
    gov = governance_state() if gov is None else gov
    if scope == "disable":
        values = [row["value"] for row in gov["disable"]]
    elif scope == "action":
        values = [row["value"] for row in gov["drop"]] + [row["selector"] for row in gov["action"]]
    elif scope == "suppress":
        values = [signature_selector(row['sid'], row.get('gid',1)) for row in gov['suppress'] if row['sid'] and row.get('gid',1)]
        values += [row['selector'] for row in gov.get('suppress_groups',[])]
    else:
        values = []
    return {canonical_selector(value) for value in values}


def selector_configured(value, configured):
    value = canonical_selector(value)
    if value in configured:
        return True
    if value.startswith('group-source:'):
        source,name=parse_group(value)
        return any(item.startswith(('group:','group-source:')) and group_matches(item,name,source) for item in configured)
    if value.startswith("group:") and not any(ch in value[6:] for ch in "*?["):
        return any(item.startswith("group:") and (fnmatch.fnmatchcase(value[6:], item[6:]) or
                   fnmatch.fnmatchcase(value[6:] + ".rules", item[6:])) for item in configured)
    return False


def _selector_marker(value):
    encoded = base64.urlsafe_b64encode(value.encode("utf-8")).decode("ascii")
    return " # ips-web-selector-b64=" + encoded


def _selector_from_line(line):
    match = _SELECTOR_MARKER_RE.search(line.rstrip("\n"))
    if not match:
        return None
    try:
        return base64.urlsafe_b64decode(match.group(1).encode("ascii")).decode("utf-8")
    except (ValueError, UnicodeDecodeError):
        return None


def _glob_prefix_regex(value):
    out = []
    for ch in value:
        if ch == "*":
            out.append(".*")
        elif ch == "?":
            out.append(".")
        else:
            out.append(re.escape(ch))
    return "".join(out)


def _selector_filter(value):
    """把控制台选择器翻译成 ips-snort-rules 真正支持的过滤器。

    drop.conf / modify.conf 的 parse_rule_match 只认：纯数字 SID（gid=1）、group:、re:；
    不认 sid: 前缀，也没有 msg:。msg 转成针对规则原文 msg:"... 的 re:。
    """
    text = (value or "").strip()
    match = re.match(r"^(sid|msg):(.+)$", text, re.S)
    if not match:
        return text
    kind, raw = match.group(1), match.group(2).strip()
    if kind == "sid":
        return raw if raw.isdigit() else text
    return 're:msg:"' + _glob_prefix_regex(raw)


def _selector_config_line(value, modify=False):
    line = _selector_filter(value)
    if modify:
        # 控制台保存原始选择器；候选生成器写出 Snort 原生 reject。
        line = shlex.quote(line) + " ^drop reject"
    return line + _selector_marker(value)


def _selector_metadata_line(value):
    # 私有标记用于识别控制台 reject 配套记录。
    return ("metadata-add " + shlex.quote(_selector_filter(value)) + " ipsweb.reject true" +
            _selector_marker(value))


def _modify_config_parts(config):
    """Read current and legacy console metadata syntax without losing quoted matchers."""
    try:
        return shlex.split(config)
    except ValueError:
        return []


def _is_reject_metadata(config):
    parts = _modify_config_parts(config)
    return (len(parts) == 4 and parts[-2:] == ["ipsweb.reject", "true"] and
            (parts[0] == "metadata-add" or parts[1] == "metadata-add"))


def normalize_selector_conf(path, modify=False):
    """迁移旧格式：sid:/msg: 在 drop/modify 配置里无法解析，改写成支持的过滤器。"""
    try:
        with open(path, "r", encoding="utf-8") as handle:
            lines = handle.readlines()
    except OSError:
        return
    metadata_selectors = set()
    if modify:
        for line in lines:
            selector = _selector_from_line(line)
            config = line.strip().rsplit(" #", 1)[0].strip()
            if _is_reject_metadata(config):
                parts = _modify_config_parts(config)
                selector = selector or (parts[1] if parts[0] == "metadata-add" else parts[0])
                metadata_selectors.add(selector)
    changed = False
    out = []
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            out.append(line)
            continue
        selector = _selector_from_line(line)
        config = stripped.rsplit(" #", 1)[0].strip()
        if selector is None:
            if modify:
                parts = _modify_config_parts(config)
                if _is_reject_metadata(config):
                    selector = parts[1] if parts[0] == "metadata-add" else parts[0]
                elif len(parts) == 3 and parts[-2] == "^drop" and parts[-1] in ("reject", "rejectboth"):
                    selector = parts[0]
            elif re.match(r"^(sid|msg):", config):
                selector = config
        if selector is None:
            out.append(line)
            continue
        is_metadata = modify and _is_reject_metadata(config)
        if is_metadata:
            expected_line = _selector_metadata_line(selector)
        else:
            expected_line = _selector_config_line(selector, modify)
        expected = expected_line.rsplit(" #", 1)[0].strip()
        if config == expected:
            if modify and not is_metadata and selector not in metadata_selectors:
                out.append(_selector_metadata_line(selector) + "\n")
                metadata_selectors.add(selector)
                changed = True
            out.append(line)
            continue
        if modify and not is_metadata and selector not in metadata_selectors:
            out.append(_selector_metadata_line(selector) + "\n")
            metadata_selectors.add(selector)
        out.append(expected_line + "\n")
        changed = True
    if not changed:
        return
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        handle.writelines(out)
    try:
        os.chmod(tmp, os.stat(path).st_mode & 0o777)
    except OSError:
        pass
    os.replace(tmp, path)


def disable_add(value):
    text = canonical_selector(value)
    if not re.fullmatch(r"(?:group|group-source|sid|msg):[^\r\n]+", text):
        return False, "格式应为 group:xxx / sid:1234 / msg:..."
    if selector_configured(text, configured_selectors("disable")):
        return False, "已存在"
    try:
        with open(DISABLE_CONF, "r", encoding="utf-8") as handle:
            if any(_selector_line_match(line, text) for line in handle):
                return False, "已存在"
    except OSError:
        pass
    _append_line(DISABLE_CONF, _selector_config_line(text))
    return True, "需运行 ips-snort-rules 生效"


def action_add(action, selector):
    action = (action or "").strip().lower()
    selector = canonical_selector(selector)
    if action not in ("drop", "reject"):
        return False, "动作只能是 drop 或 reject"
    if not re.fullmatch(r"(?:sid|msg):[^\r\n]+", selector):
        return False, "范围写 sid:1234 或 msg:前缀*"
    try:
        with open(ACTION_CONF, encoding="utf-8") as handle:
            lines = handle.readlines()
    except FileNotFoundError:
        lines = []
    # One selector has one action; changing it must not require deleting it first.
    kept = []
    for line in lines:
        parts = line.strip().split(None, 1)
        if len(parts) == 2 and parts[0] in ("drop", "reject") and canonical_selector(parts[1]) == selector:
            continue
        kept.append(line if line.endswith("\n") else line + "\n")
    kept.append(action + " " + selector + "\n")
    temp = ACTION_CONF + ".tmp"
    with open(temp, "w", encoding="utf-8") as handle:
        handle.writelines(kept)
    os.replace(temp, ACTION_CONF)
    return True, "已保存动作"


def action_remove(selector):
    selector = (selector or "").strip()
    try:
        with open(ACTION_CONF, "r", encoding="utf-8") as handle:
            lines = handle.readlines()
    except OSError:
        return False, "没有覆盖项"
    keep, removed = [], False
    for line in lines:
        parts = line.strip().split(None, 1)
        if len(parts) == 2 and parts[1].strip() == selector:
            removed = True
            continue
        keep.append(line)
    if not removed:
        return False, "未找到"
    with open(ACTION_CONF, "w", encoding="utf-8") as handle:
        handle.writelines(keep)
    return True, "已移除，更新规则集后恢复原动作"


def _selector_line_match(line, selector, modify=False):
    """按控制台选择器匹配配置行，兼容旧格式与翻译后的过滤器。"""
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        return False
    marker = _selector_from_line(line)
    config = stripped.rsplit(" #", 1)[0].strip()
    if ((marker and canonical_selector(marker) == canonical_selector(selector)) or
            (not modify and canonical_selector(config) == canonical_selector(selector))):
        return True
    if marker == selector or stripped == selector:
        return True
    if _selector_filter(marker or "") == _selector_filter(selector):
        return True
    target = _selector_filter(selector)
    if modify:
        parts = _modify_config_parts(config)
        return (parts in ([target, "^drop", "rejectboth"], [target, "^drop", "reject"]) or
                (_is_reject_metadata(config) and
                 (parts[1] if parts[0] == "metadata-add" else parts[0]) == target))
    return config == target


def drop_add(value):
    text = canonical_selector(value)
    if not re.fullmatch(r"(?:group|group-source|sid|msg|re):[^\r\n]+", text):
        return False, "格式应为 group:xxx / sid:1234 / msg:...（支持 * 通配）"
    try:
        with open(DROP_CONF, "r", encoding="utf-8") as handle:
            if any(_selector_line_match(line, text) for line in handle):
                return False, "已存在"
    except OSError:
        pass
    _append_line(DROP_CONF, _selector_config_line(text))
    return True, "已写入 drop.conf，需更新规则集生效"


def drop_remove(value):
    text = (value or "").strip()
    try:
        with open(DROP_CONF, "r", encoding="utf-8") as handle:
            lines = handle.readlines()
    except OSError:
        return False, "drop.conf 不存在"
    keep, removed = [], False
    for line in lines:
        if _selector_line_match(line, text):
            removed = True
            continue
        keep.append(line)
    if not removed:
        return False, "未找到"
    with open(DROP_CONF, "w", encoding="utf-8") as handle:
        handle.writelines(keep)
    reject_remove(text)     # 配套清掉 modify.conf 里的 reject 行，避免孤儿
    return True, "已从 drop.conf 移除，需更新规则集生效"


def _reject_pair_state(selector):
    """返回 (是否已有 reject 改写行, 是否已有 metadata 标记行)。"""
    has_modify = False
    has_metadata = False
    try:
        with open(MODIFY_CONF, "r", encoding="utf-8") as handle:
            lines = list(handle)
    except OSError:
        return has_modify, has_metadata
    for line in lines:
        if canonical_selector(_selector_from_line(line)) != canonical_selector(selector):
            continue
        config = line.strip().rsplit(" #", 1)[0].strip()
        parts = _modify_config_parts(config)
        if len(parts) >= 3 and parts[-2:] == ["^drop", "reject"]:
            has_modify = True
        if _is_reject_metadata(config):
            has_metadata = True
    return has_modify, has_metadata


def reject_add(value):
    """把 drop.conf 条目切换为 reject：drop.conf 保持不动，在 modify.conf 加配套行。

    modify.conf 在 drop.conf 之后运行（^drop→reject），所以 noalert 规则不会被误改。
    sid:/msg: 会先翻译成 ips-snort-rules 实际支持的数字 SID / re: 过滤器。
    metadata-add 私有标记用于识别控制台 reject 配套记录。
    """
    text = canonical_selector(value)
    if not re.fullmatch(r"(?:group|group-source|sid|msg|re):[^\r\n]+", text):
        return False, "格式应为 group:xxx / sid:1234 / msg:... / re:...（支持 * 通配）"
    has_modify, has_metadata = _reject_pair_state(text)
    if has_modify:
        return False, "该条目已是 reject"
    ok, msg = drop_add(text)
    if not ok and "已存在" not in msg:
        return False, msg
    if not has_metadata:
        _append_line(MODIFY_CONF, _selector_metadata_line(text))
    _append_line(MODIFY_CONF, _selector_config_line(text, modify=True))
    return True, "已切换为 reject，需更新规则集生效"


def reject_remove(value):
    """撤掉 reject 配套行，条目回落为普通 drop。"""
    text = (value or "").strip()
    try:
        with open(MODIFY_CONF, "r", encoding="utf-8") as handle:
            lines = handle.readlines()
    except OSError:
        return False, "modify.conf 不存在"
    keep, removed = [], False
    for line in lines:
        if _selector_line_match(line, text, modify=True):
            removed = True
            continue
        keep.append(line)
    if not removed:
        return False, "该条目不是 reject"
    with open(MODIFY_CONF, "w", encoding="utf-8") as handle:
        handle.writelines(keep)
    return True, "已切换为 drop，需更新规则集生效"


def disable_remove(value):
    text = (value or "").strip()
    try:
        with open(DISABLE_CONF, "r", encoding="utf-8") as handle:
            lines = handle.readlines()
    except OSError:
        return False, "disable.conf 不存在"
    keep, removed = [], False
    for line in lines:
