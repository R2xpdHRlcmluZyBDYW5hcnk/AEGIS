def load_config(path):
    cfg = dict(DEFAULT_CONFIG)
    if path and os.path.isfile(path):
        with open(path, "r", encoding="utf-8") as fh:
            cfg.update(json.load(fh))
    return cfg


def main(argv=None):
    parser = argparse.ArgumentParser(description="Snort NDR console")
    parser.add_argument("--config", default="/etc/ips-web.conf")
    parser.add_argument("--bind")
    parser.add_argument("--port", type=int)
    parser.add_argument("--gen-password", action="store_true")
    parser.add_argument("--prepare-thresholds", action="store_true")
    parser.add_argument("--test-rules", action="store_true")
    args = parser.parse_args(argv)

    if args.prepare_thresholds or args.test_rules:
        rule_file = os.environ.get("OUTPUT_FILENAME") if args.test_rules else None
        result = prepare_thresholds([rule_file] if rule_file else None)
        print("[suppress] 生效 %d 条，待规则启用 %d 条" % (result["active"], result["pending"]))
        if args.test_rules:
            from snort_engine import BINARY
            from session_logger import plugin_arguments
            result = subprocess.run([BINARY, *plugin_arguments(), "-T", "-c", SNORT_CONF], check=False)
            return result.returncode
        return 0

    if args.gen_password:
        pw = secrets.token_urlsafe(12)
        print(f"password        : {pw}")
        print(f"password_pbkdf2 : {make_password_hash(pw)}")
        return 0

    cfg = load_config(args.config)
    if os.environ.get("IPS_WEB_ISOLATED") == "1":
        from ips_control import SOCKET
        cfg["rule_manager_socket"] = SOCKET
        cfg["event_db"] = os.path.join(os.environ.get("STATE_DIRECTORY", "/var/lib/ips-web"), "snort-ndr.db")
    if args.bind:
        cfg["bind"] = args.bind
    if args.port:
        cfg["port"] = int(args.port)
    if not password_configured(cfg):
        print("WARNING: no password hash is set — login is DISABLED until one is configured",
              file=sys.stderr)

    Handler.app = App(cfg)
    Handler.config = cfg
    schedule_stop = threading.Event()
    workers=[]
    server = BoundedHTTPServer((cfg["bind"], int(cfg["port"])), Handler)
    if Handler.app.control:
        from ips_control import RemoteSchedule
        Handler.app.rule_schedule = RemoteSchedule(Handler.app.control)
    else:
        Handler.app.rule_schedule = RuleUpdateSchedule(Handler.app.sys)
        workers.append(threading.Thread(target=Handler.app.rule_schedule.run,args=(schedule_stop,),name='rule-schedule',daemon=True))
    workers.extend([threading.Thread(target=Handler.app.sys.sampler,
                                    args=(Handler.app.stop, Handler.app.sample_overview_runtime),name='engine-rates',daemon=True),
                    threading.Thread(target=Handler.app.db_loop,name='event-ingest',daemon=True)])
    for worker in workers:worker.start()
    Handler.app.network.start()
    Handler.app.analytics.start()
    Handler.app.data.start()
    print(f"ips-web listening on {cfg['bind']}:{cfg['port']}", flush=True)
    def shutdown(_signum, _frame):
        threading.Thread(target=server.shutdown, daemon=True).start()
    signal.signal(signal.SIGTERM, shutdown)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        schedule_stop.set()
        Handler.app.stop.set()
        server.server_close()
        Handler.app.network.close()
        Handler.app.data.close()
        Handler.app.analytics.close()
        for worker in workers:worker.join(timeout=5)
        with Handler.app.store.lock:
            Handler.app.db.flush()
        shared_cpu().close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
