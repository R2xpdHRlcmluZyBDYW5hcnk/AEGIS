def _hunt_number(value):
    text = str(value).strip()
    return int(text) if re.fullmatch(r'[+-]?\d+',text) else float(text)


def _hunt_num(actual, value):
    if actual is None:
        return False
    for op in (">=", "<=", "!=", ">", "<", "="):
        if value.startswith(op):
            try:
                target = _hunt_number(value[len(op):])
                number = _hunt_number(actual)
            except (TypeError, ValueError):
                return False
            return {">=": number >= target, "<=": number <= target, "!=": number != target,
                    ">": number > target, "<": number < target, "=": number == target}[op]
    try:
        return _hunt_number(actual) == _hunt_number(value)
    except (TypeError, ValueError):
        return False


