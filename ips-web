def rule_write(app, method, path, body):
    if method == "POST" and path == "/api/actions/reload":
        return (app.sys.reload_rules())
    if method == "POST" and path == "/api/actions/update":
        return (app.sys.update_rules())
    if method == "POST" and path == "/api/rules/schedule":
        return (app.rule_schedule.configure(body))
    if method == "POST" and path == "/api/actions/apply":
        return (app.sys.update_rules(offline=True))
    if method == "POST" and path == "/api/hunt/rules":
        ok, msg = hunt_rule_add(body.get("rule"))
        if ok:
            app.sys.reload_rules()
        return ({"ok": ok, "message": msg})
    if method == "DELETE" and path.startswith("/api/hunt/rules/"):
        ok, msg = hunt_rule_delete(unquote(path.rsplit("/", 1)[-1]))
        if ok:
            app.sys.reload_rules()
        return ({"ok": ok, "message": msg})
    if method == "POST" and path == "/api/rules/suppress-groups":
        result = suppress_groups_add(_batch_values(body, "groups", "group"), _batch_values(body, "sids", "sid"))
        if result.get("added") or result.get('added_groups'):
            app.sys.reload_rules()
        return (result)
    if method == "POST" and path == "/api/rules/suppress-groups/remove":
        return suppress_groups_remove(_batch_values(body, "groups", "group"))
    if method == 'DELETE' and path.startswith('/api/rules/suppress-group/'):
        return suppress_groups_remove([unquote(path.rsplit('/',1)[-1])])
    if method == "POST" and path == "/api/rules/suppress":
        sids = _batch_values(body, "sids", "sid")
        added, errors = 0, []
        for sid in sids:
            ok, _msg = suppress_add(sid)
            if ok:
                added += 1
            else:
                errors.append(str(sid))
        if added:
            app.sys.reload_rules()
        return (_batch_result(added, errors,
                                        "已抑制 %d 条，规则重载中（约 40 秒）" % added))
    if method == "DELETE" and path.startswith("/api/rules/suppress/"):
        ok, msg = suppress_remove(unquote(path.rsplit("/", 1)[-1]))
        if ok:
            app.sys.reload_rules()
        return ({"ok": ok, "message": msg})
    if method == "POST" and path == "/api/rules/action":
        selectors = _batch_values(body, "selectors", "selector")
        added, errors = 0, []
        for selector in selectors:
            configured = configured_selectors("action")
            if selector_configured(selector, configured) and (body.get("replace") is not True or canonical_selector(selector) not in configured):
                ok, msg = False, "已配置，请编辑现有条目"
            elif any(canonical_selector(row["value"]) == canonical_selector(selector) for row in governance_state()["drop"]):
                ok, msg = False, "已有更新阶段动作，请编辑原条目"
            else:
                ok, msg = action_add(body.get("action"), selector)
            if ok:
                added += 1
            else:
