def managed_rule_files():
    roots={Path(RULES_FILE).parent,Path(DIST_RULES_DIR)}
    paths=set()
    for root in roots:
        if not root.is_dir() or root.is_symlink(): continue
        for path in root.rglob('*.rules'):
            if path == Path(RULES_FILE): continue  # Generated merged output is not a source group.
            if path.is_relative_to(Path(UPDATE_CACHE_DIR)): continue
            if path.is_symlink() or any(parent.is_symlink() for parent in path.parents) or not path.is_file(): continue
            if path.stat().st_size>128<<20: continue
            paths.add(path)
            if len(paths)>10000: raise ValueError('规则目录文件数量超过限制')
    return sorted(paths)


def active_rule_paths():
    paths={Path(p) for p in (RULES_FILE,LOCAL_RULES,HUNT_RULES,BAN_RULES)}
    allowed=managed_rule_files()
    texts=[Path(SNORT_CONF)]
    seen=set()
    while texts:
        path=texts.pop()
        if path in seen: continue
        seen.add(path)
        try: text=path.read_text(encoding='utf-8',errors='replace')
        except OSError: continue
        for name in re.findall(r'^\s*include\s+([^\s;]+\.rules)\s*$',text,re.M):
            candidate=Path(name)
            if not candidate.is_absolute(): candidate=path.parent/candidate
            if candidate in allowed and candidate not in paths:
                paths.add(candidate);texts.append(candidate)
    return sorted(paths)


def _source_cache_metadata():
    try:
        from rule_sources import definitions
        custom = definitions(SOURCES_DIR)
        with open(os.path.join(UPDATE_CACHE_DIR, "sources.json"), encoding="utf-8") as handle:
            return {key: (item['source'], custom[item['source']]['enabled'] if item['source'] in custom else os.path.isfile(os.path.join(SOURCES_DIR,item['source'].replace('/','-')+'.yaml')))
                    for key, item in json.load(handle).items()}
    except (OSError, ValueError, KeyError, TypeError):
        return {}


def rule_group_catalog():
    """Inventory all cached archives and distribution groups without extracting files."""
    snapshot=pinned_catalog(_GROUP_CACHE)
    if snapshot is not None:return snapshot
    cached = sorted(glob.glob(os.path.join(UPDATE_CACHE_DIR, "*")))
    dist = managed_rule_files()
    active = active_rule_paths()
    paths = cached + [str(p) for p in dist] + sorted(glob.glob(os.path.join(SOURCES_DIR, '*'))) + [str(p) for p in active] + [DISABLE_CONF]
    builtins = builtin_catalog(SNORT_CONF)
    key = [('builtin', tuple(builtins))]
    for path in paths:
        try:
            info = os.stat(path)
            key.append((path, info.st_ino, info.st_mtime_ns, info.st_size))
        except OSError:
            continue
    with _GROUP_LOCK:
        if _GROUP_CACHE["key"] == key:
            return pin_catalog(_GROUP_CACHE,_GROUP_CACHE['rows'])
        compiled, compiled_names, compiled_actions = set(), {}, {}
        for path in active:
          try:
            for _,records in RULE_INVENTORY.read(path):
                for record in records:
                    if record.enabled:
                        compiled.add(record.token);compiled_actions[record.token]=record.action
                        compiled_names[record.token]=record.message
          except OSError:
            pass
        source_map = _source_cache_metadata()
        groups, origins, origin_ranks, names, members = {}, {}, {}, {}, {}
        rule_records, group_records = {}, {}

        def collect(name, records, source, enabled, group_name=None):
            source=source or '未知来源'
            name = group_name or os.path.basename(name)[:-6]
            row = groups.setdefault((name, source), {"name": name, "label": group_display_name(name, source), "source": source,
                "source_enabled": enabled, "total": 0, "compiled": 0, "blockable": 0})
            for record in records:
                gid,sid_value=record.gid,record.token;line=record.line
                members.setdefault((name, source), set()).add(sid_value)
                rank = (enabled is True, bool(source), record.enabled)
                origin = {"group": name, "source": source}
                rule_line = record.line
                group_records.setdefault((name,source),{})[sid_value]=dict(gid=gid,sid=record.sid,line=rule_line,
                    msg=record.message,policy_managed=group_name is None,
                    action=compiled_actions.get(sid_value,record.action),enabled=sid_value in compiled,
                    origins=[origin])
                if sid_value not in origin_ranks or rank > origin_ranks[sid_value]:
                    origins[sid_value] = [origin]; origin_ranks[sid_value] = rank
                    rule_records[sid_value] = dict(gid=gid, sid=record.sid, line=rule_line,policy_managed=group_name is None,
                        msg=record.message,
                        action=compiled_actions.get(sid_value, record.action),
                        enabled=sid_value in compiled)
                    names[sid_value] = record.message
                elif rank == origin_ranks[sid_value] and origin not in origins[sid_value]:
                    origins[sid_value].append(origin)
                row["total"] += 1
                if sid_value in compiled:
                    row["compiled"] += 1
                    if enabled is not False and ('noalert' not in line or not re.search(r";\s*noalert\s*;", line)):
                        row["blockable"] += 1

        for path in cached:
            base = os.path.basename(path).split("-", 1)[-1]
            source, enabled = source_map.get(os.path.basename(path).split("-", 1)[0], ("", None))
            try:
                if base.endswith(('.tar.gz','.tgz','.tar','.rules')):
                    for name,records in RULE_INVENTORY.read(path):collect(base if base.endswith('.rules') else name,records,source,enabled)
            except (OSError,TarError):
                continue
        for path in dist:
            try:
                local=not path.is_relative_to(Path(DIST_RULES_DIR))
                group=('local/'+path.relative_to(Path(RULES_FILE).parent).with_suffix('').as_posix()) if local else path.relative_to(Path(DIST_RULES_DIR)).with_suffix('').as_posix()
                for _,records in RULE_INVENTORY.read(path):collect(str(path),records,'本地目录' if local else 'Snort',True,group)
                groups[(group,'本地目录' if local else 'Snort')]['policy_managed']=False
            except OSError:
                continue
        from snort_rules import selectors as read_selectors
        disabled=read_selectors(DISABLE_CONF)
        for token, record in builtins.items():
            record=dict(record,enabled=not builtin_disabled(record,disabled))
            name, source = record['group'], 'Snort 内置'
            row = groups.setdefault((name, source), dict(name=name,
                label=BUILTIN_LABELS.get(record['module'], record['module']) + ' GID ' + str(record['gid']),
                source=source, source_enabled=True, builtin=True, total=0, compiled=0, blockable=0))
            row['total'] += 1; row['compiled'] += int(record['enabled'])
            members.setdefault((name, source), set()).add(token)
            origins[token] = [dict(group=name, source=source)]
            names[token] = record['msg']
            if record['enabled']: compiled_actions[token] = record['action']
            else:compiled_actions.pop(token,None)
            rule_records[token] = record
            group_records.setdefault((name,source),{})[token]=dict(record,origins=origins[token])
        rows = sorted(groups.values(), key=lambda row: (row["name"], row["source"]))
        for row in rows:
            row['selector']=group_selector(row['name'],row['source'])
            row['total']=len(members.get((row['name'],row['source']),()))
            row['compiled']=sum(token in compiled_actions for token in members.get((row['name'],row['source']),()))
        names.update(compiled_names)
        disabled,available=set(),set()
        for row in rows:(disabled if row.get('source_enabled') is False else available).update(members.get((row['name'],row['source']),()))
        _GROUP_CACHE.update(key=key, rows=rows, origins=origins, names=names,hidden=disabled-available,
                            members=members, actions=compiled_actions, rule_records=rule_records,group_records=group_records)
        return pin_catalog(_GROUP_CACHE,rows)


@catalog_read
def rule_group_members(name, source=None):
    return [signature_row(row) for row in _rule_group_rows(name,source)[0]]


def _rule_group_rows(name, source=None, query='', offset=0, limit=None):
    """Keep undecorated members for filtering; serialize only the requested page."""
    rule_group_catalog()
    sids = set()
    for (group, origin), values in _GROUP_CACHE.get("members", {}).items():
        if group == name and (source is None or source == origin):
            sids.update(values)
    names, actions = _GROUP_CACHE.get("names", {}), _GROUP_CACHE.get("actions", {})
    records={token:record for (group,origin),values in _GROUP_CACHE.get('group_records',{}).items()
             if group==name and (source is None or source==origin) for token,record in values.items()}
    needle=query.strip().lower()
    tokens=sorted((token for token in sids if not needle or needle in str(signature_identity(token)[1])
                   or needle in records.get(token,{}).get('msg',names.get(token,'未识别')).lower()),key=signature_identity)
    total=len(tokens)
    tokens=tokens[offset:offset+limit] if limit is not None else tokens[offset:]
    return [dict(records.get(token,_GROUP_CACHE.get('rule_records', {}).get(token, {})),
                gid=signature_identity(token)[0], sid=signature_identity(token)[1],
                msg=records.get(token,{}).get('msg',names.get(token, '未识别')), action=actions.get(token, ''), enabled=token in actions)
            for token in tokens],total


