    return True, "ok"


_PENDING_SUPPRESS = "# ips-web-pending-suppress "
_SUPPRESS_IDS = re.compile(r"^\s*suppress\s+gen_id\s+(\d+)\s*,\s*sig_id\s+(\d+)(?=\s*(?:,|$))")
_THRESHOLD_THREAD_LOCK = threading.RLock()
_ACTIVE_IDS_CACHE = {}


def suppression_line(raw):
    text = raw.strip()
    if text.startswith(_PENDING_SUPPRESS):
        try:
            decoded = base64.urlsafe_b64decode(text[len(_PENDING_SUPPRESS):]).decode("utf-8")
            if _SUPPRESS_IDS.match(decoded) and "\n" not in decoded and "\r" not in decoded:
                return decoded
        except (ValueError, UnicodeError):
            pass
    return raw.rstrip("\r\n")


@contextmanager
def threshold_lock():
    with _THRESHOLD_THREAD_LOCK:
        with open(THRESHOLD_CONF + ".ips-web-lock", "a") as handle:
            try:
                import fcntl
            except ImportError:
                yield
            else:
                fcntl.flock(handle, fcntl.LOCK_EX)
                try:
                    yield
                finally:
                    fcntl.flock(handle, fcntl.LOCK_UN)


def active_rule_ids(rule_files=None):
    paths = rule_files
    if paths is None:
        paths = [str(path) for path in active_rule_paths()]
    key = []
    for path in paths:
        try:
            stat = os.stat(path); key.append((path, stat.st_mtime_ns, stat.st_size))
        except OSError:
            continue
    builtins = builtin_catalog(SNORT_CONF)
    if not key and not builtins:
        return None  # Inventory unavailable: preserve rather than disable policies.
    key.append(('builtin', tuple(builtins)))
    if _ACTIVE_IDS_CACHE.get("key") == key:
        return _ACTIVE_IDS_CACHE["ids"]
    ids = {signature_identity(token) for token in builtins}
    for path, _, _ in key[:-1]:
        with open(path, encoding="utf-8", errors="replace") as handle:
            text = handle.read().replace("\\\r\n", "").replace("\\\n", "")
        for line in text.splitlines():
            if not re.match(r"^\s*(?:alert|block|drop|reject\w*|pass)\s", line):
                continue
            sid = re.search(r"\bsid\s*:\s*(\d+)", line)
            gid = re.search(r"\bgid\s*:\s*(\d+)", line)
            if sid:
                ids.add((int(gid.group(1)) if gid else 1, int(sid.group(1))))
    _ACTIVE_IDS_CACHE.update(key=key, ids=ids)
    return ids


def atomic_text(path, text):
    temporary = path + ".ips-web-tmp"
    try:
        with open(temporary, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(text)
        if os.path.exists(path):
            os.chmod(temporary, os.stat(path).st_mode & 0o777)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def write_thresholds(text, rule_files=None):
    ids = active_rule_ids(rule_files)
    output, active, pending = [], 0, 0
    for raw in text.splitlines(keepends=True):
        original = suppression_line(raw)
        match = _SUPPRESS_IDS.match(original)
        if not match:
            output.append(raw); continue
        gid, sid = map(int, match.groups())
        if ids is None:
            output.append(raw); continue
        valid = (gid, sid) in ids or (gid == 0 or sid == 0)
        if valid:
            output.append(original + "\n"); active += 1
        else:
            output.append(_PENDING_SUPPRESS + base64.urlsafe_b64encode(original.encode("utf-8")).decode("ascii") + "\n"); pending += 1
    rendered = "".join(output)
    try:
        with open(THRESHOLD_CONF, encoding="utf-8") as handle:
            current = handle.read()
    except FileNotFoundError:
        current = None
    if rendered != current:
        atomic_text(THRESHOLD_CONF, rendered)
    lua = []
    group_ids={signature_identity(token) for token in group_suppression_members()}
    for raw in output:
        match = _SUPPRESS_IDS.match(raw)
        if not match:
            continue
        gid, sid = map(int, match.groups())
        if (gid,sid) in group_ids:continue
        entry = {"gid": gid, "sid": sid}
        track = re.search(r"\btrack\s+(by_src|by_dst)", raw)
        address = re.search(r"\bip\s+([^,\s]+)", raw)
        fields = ["gid = " + str(gid), "sid = " + str(sid)]
        if track:
            fields.append("track = " + json.dumps(track[1]))
        if address:
            ip_network(address[1], strict=False)
            fields.append("ip = " + json.dumps(address[1]))
        lua.append("    { " + ", ".join(fields) + " }")
    for gid,sid in sorted(group_ids):
        if ids is None or (gid,sid) in ids:
            lua.append('    { gid = %d, sid = %d }' % (gid,sid))
    native_path = SUPPRESS_LUA
    from snort_rules import selectors as read_selectors
    disabled=read_selectors(DISABLE_CONF)
    states=['alert (gid:%d; sid:%d; enable:no;)' % signature_identity(token)
            for token,record in builtin_catalog(SNORT_CONF).items() if builtin_disabled(record,disabled)]
    atomic_text(native_path, 'suppress = {\n'+',\n'.join(lua)+'\n}\nips.states = [[\n'+'\n'.join(states)+'\n]]\n')
    return {"active": active, "pending": pending, "changed": rendered != current}


def prepare_thresholds(rule_files=None):
    with threshold_lock():
        try:
            with open(THRESHOLD_CONF, encoding="utf-8") as handle:
                text = handle.read()
        except FileNotFoundError:
            text = ""
        return write_thresholds(text, rule_files)


@catalog_read
def governance_state(details=False):
    suppress, disabled = [], []
    try:
        with open(THRESHOLD_CONF, "r", encoding="utf-8") as handle:
            for line in handle:
                text = suppression_line(line).strip()
                if text.startswith("suppress") and "sig_id" in text:
                    match = _SUPPRESS_IDS.match(text)
                    suppress.append({"gid": int(match[1]), "sid": int(match[2]), "line": text,
                                     **({"pending": True} if line.startswith(_PENDING_SUPPRESS) else {})})
    except OSError:
        pass
    try:
        with open(DISABLE_CONF, "r", encoding="utf-8") as handle:
            for line in handle:
                text = line.strip()
                if text and not text.startswith("#"):
                    config = text.rsplit(" #", 1)[0].strip()
                    value = _selector_from_line(line) or config
                    disabled.append({"value": canonical_selector(value)})
    except OSError:
        pass
    reject_set = set()
    reject_filters = set()
    try:
        with open(MODIFY_CONF, "r", encoding="utf-8") as handle:
            for line in handle:
                stripped = line.strip()
                if not stripped or stripped.startswith("#"):
                    continue
                config = stripped.rsplit(" #", 1)[0].strip()
                parts = config.split()
                if (len(parts) < 3 or parts[-2] != "^drop" or
                        parts[-1] not in ("reject", "rejectboth")):
                    continue
                # 优先读控制台写入的选择器标记；兼容旧的 <选择器> ^drop reject
                selector = canonical_selector(_selector_from_line(line) or parts[0])
                reject_set.add(selector)
                reject_filters.add(_selector_filter(selector))
    except OSError:
        pass
    drop = []
    try:
        with open(DROP_CONF, "r", encoding="utf-8") as handle:
            for line in handle:
                stripped = line.strip()
                if not stripped or stripped.startswith("#"):
                    continue
                config = stripped.rsplit(" #", 1)[0].strip()
                selector = canonical_selector(_selector_from_line(line) or config)
                drop.append({"value": selector,
                             "reject": _selector_filter(selector) in reject_filters})
    except OSError:
        pass
    action = []
    try:
        with open(ACTION_CONF, "r", encoding="utf-8") as handle:
            for line in handle:
                parts = line.strip().split(None, 1)
                if len(parts) == 2 and not parts[0].startswith("#"):
                    action.append({"action": parts[0], "selector": canonical_selector(parts[1])})
    except OSError:
        pass
    if details:
        rule_group_catalog()
        for row in disabled + drop:
            row["name"] = selector_name(row["value"])
        for row in action:
            row["name"] = selector_name(row["selector"])
        for row in suppress:
            row['name'] = selector_name(signature_selector(row['sid'], row['gid'])) if row['gid'] and row['sid'] else '全局抑制'
    group_rows=[]
    for value in group_suppression_policies():
        source,name=parse_group(value);members=group_suppression_members([value])
        group_rows.append(dict(selector=value,name=name,source=source or '全部来源',total=len(members)))
    return {"suppress": suppress,"suppress_groups":group_rows, "disable": disabled, "drop": drop,
            "reject": sorted(reject_set), "action": action}


def _batch_values(body, plural, single):
    """Batch values are deduplicated without silently truncating user selections."""
    raw = body.get(plural)
    if not isinstance(raw, list):
        raw = [body.get(single)] if body.get(single) else []
    seen, out = set(), []
    for item in raw:
        text = str(item or "").strip()
        if text and text not in seen:
            seen.add(text)
            out.append(text)
    return out


def _batch_result(added, errors, success_msg):
