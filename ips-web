class Sessions:
    def __init__(self, ttl):
        self.ttl = ttl
        self.lock = threading.Lock()
        self.items = {}

    def create(self, user, ip):
        token = secrets.token_urlsafe(32)
        with self.lock:
            self._prune()
            self.items[token] = {"user": user, "ip": ip, "created": now(),
                                 "expires": now() + self.ttl}
        return token

    def get(self, token):
        if not token:
            return None
        with self.lock:
            item = self.items.get(token)
            if not item:
                return None
            if item["expires"] < now():
                self.items.pop(token, None)
                return None
            item["expires"] = now() + self.ttl
            return dict(item)

    def drop(self, token):
        with self.lock:
            self.items.pop(token, None)

    def _prune(self):
        stamp = now()
        for key in [k for k, v in self.items.items() if v["expires"] < stamp]:
            self.items.pop(key, None)


