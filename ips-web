def suppress_add(sid):
    try:
        gid, sid = signature_identity(sid)
    except (TypeError, ValueError):
        return False, "无效 sid"
    if not 1 <= sid <= 4294967295:
        return False, "无效 sid"
    with threshold_lock():
        try:
            with open(THRESHOLD_CONF, encoding="utf-8") as handle:
                text = handle.read()
        except FileNotFoundError:
            text = ""
        if any((match := _SUPPRESS_IDS.match(suppression_line(line))) and tuple(map(int,match.groups())) == (gid,sid) for line in text.splitlines()):
            return False, "已在抑制列表"
        text += ('\n' if text and not text.endswith('\n') else '') + 'suppress gen_id %d, sig_id %d\n' % (gid,sid)
        write_thresholds(text)
    return True, "ok"


