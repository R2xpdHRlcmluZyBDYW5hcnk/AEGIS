def _hunt_sql_text(column, value, icase, substring=False, glob_empty=False):
    text = "COALESCE(%s, '')" % column
    expression = ("CASE WHEN %s GLOB '*[^ -~]*' THEN hunt_fold(%s) ELSE lower(%s) END" % (text, column, text)
                  if icase else text)
    needle = value.lower() if icase else value
    if '*' in needle or '?' in needle:
        pattern = '*' + needle + '*' if substring else needle
        condition = 'hunt_glob(%s, ?)' % expression
        if not glob_empty:
            condition = "(%s != '' AND %s)" % (expression, condition)
        return [condition], [pattern], True
    if substring:
        return ['instr(%s, ?) > 0' % expression], [needle], True
    return ['%s = ?' % expression], [needle], True


def _hunt_disjunctions(node, limit=128):
    """Bounded disjunctive terms let SQLite use an index for each OR branch."""
    if not node or node[0] not in ('and','or'):
        return [[node]]
    if node[0]=='or' and hunt_used_fields(node)=={'flow_id'}:
        return [[node]]
    left,right = _hunt_disjunctions(node[1],limit),_hunt_disjunctions(node[2],limit)
    if left is None or right is None:
        return None
    if node[0]=='or':
        return left+right if len(left)+len(right)<=limit else None
    if len(left)*len(right)>limit:
        return None
    return [a+b for a in left for b in right]


def hunt_sql_pushdown(node, icase=False, metadata=True):
    terms = _hunt_disjunctions(node) if node else None
    if terms and len(terms)>1:
        branches,args = [],[]
        for conjunction in terms:
            clauses = []
            for term in conjunction:
                where,values,complete = _hunt_sql_pushdown(term,icase,metadata)
                if not complete:
                    return _hunt_sql_pushdown(node,icase,metadata)
                clauses.extend(where);args.extend(values)
            branches.append('('+' AND '.join(clauses)+')')
        if len(args)<=900:
            return ['('+' OR '.join(branches)+')'],args,True
    return _hunt_sql_pushdown(node,icase,metadata)


def _hunt_sql_pushdown(node, icase=False, metadata=True):
    """把简单条件翻译成 SQL：返回 (where 片段列表, 参数列表, 是否全部下推)"""
    if not node:
        return [], [], False
    kind = node[0]
    if kind == "and":
        lw, la, lf = _hunt_sql_pushdown(node[1], icase, metadata)
        rw, ra, rf = _hunt_sql_pushdown(node[2], icase, metadata)
        return lw + rw, la + ra, (lf and rf)
    if kind == 'or':
        lw, la, lf = _hunt_sql_pushdown(node[1], icase, metadata)
        rw, ra, rf = _hunt_sql_pushdown(node[2], icase, metadata)
        if lf and rf:
            return ['((' + ' AND '.join(lw) + ') OR (' + ' AND '.join(rw) + '))'], la + ra, True
        return [], [], False
    if kind == 'not':
        where, args, full = _hunt_sql_pushdown(node[1], icase, metadata)
        return (['NOT COALESCE((' + ' AND '.join(where) + '), 0)'], args, True) if full else ([], [], False)
    if kind == 'bare':
        columns = ('sig', 'src', 'dst', 'app', 'reason', 'cat', 'proto', 'type')
        text = " || ' ' || ".join("COALESCE(%s, '')" % (FLOW_SIG_SQL if column == 'sig' else column) for column in columns)
        return _hunt_sql_text('(' + text + ')', node[1], icase, substring=True, glob_empty=True)
    if kind != "cmp":
        return [], [], False
    field, value = node[1], node[2]
    if field == 'community':
        if value=='*':
            return ["community IS NOT NULL AND community!=''"],[],True
        if not any(char in value for char in '*?'):
            # Opaque Base64 identities are case-sensitive; keep the native association index usable.
            return ['community=?'],[value],True
        return _hunt_sql_text('community',value,False)
    if field == 'session_id' and re.fullmatch(r'[0-9a-fA-F]{32}:[0-9a-fA-F]{16}', value):
        # Engine session IDs are stored in lowercase. Keep exact lookups on the session index.
        return ['session_id=?'], [value.lower() if icase else value], True
    if field == 'tuple_hash':
        expression = "CASE WHEN COALESCE(community,'')='' AND COALESCE(flow_id,0)<=0 THEN tuple_hash(src,sport,dst,dport,proto) END"
        if value=='*':
            return [expression+' IS NOT NULL'],[],True
        return _hunt_sql_text(expression,value.lower(),False)
    if field in MITRE_FIELDS:
        if not metadata:return [],[],False
        return ['length(raw) > 0 AND hunt_metadata(raw, ?, ?, ?)'], [field, value, int(icase)], True
    if field == 'level':
        level = HUNT_LEVEL_ALIASES.get(value.strip().lower(), value.strip().lower())
        if level == '*':
            return ["(sev >= 1 OR (type IN ('alert','drop') AND sid > 0))"], [], True
        if level == 'unknown':
            return ["COALESCE(sev,0)<1 AND type IN ('alert','drop') AND sid > 0"], [], True
        if level in ('high', 'medium'):
            return ['sev = ?'], [1 if level == 'high' else 2], True
        return (['sev >= 3'], [], True) if level == 'low' else (['0'], [], True)
    column = SQL_FIELD_COLUMNS.get(field)
    if not column:
        return [], [], False
    if field == 'httpver':
        column = "(CASE WHEN type='quic' THEN '' WHEN COALESCE(httpver, '')='' AND (type='http2' OR (type='http' AND app='http2')) THEN 'HTTP/2' ELSE COALESCE(httpver, '') END)"
    if field == 'sig':
        column = FLOW_SIG_SQL
    if value == '*':
        return ["%s IS NOT NULL AND %s != ''" % (column, column)], [], True
    if field in ('src', 'dst') and '/' in value:
        return ['hunt_network(%s, ?)' % column], [value], True
    if field in ('src','dst') and not any(char in value for char in '*?'):
        try:
            address = ip_address(value)
        except ValueError:
            pass
        else:
            if address.version==4 or not icase:
                return [column+'=?'],[value],True
            # ASCII case variants fall inside these binary bounds; retain exact text semantics.
            return [column+'>=? AND '+column+'<=? AND lower('+column+')=?'],[value.upper(),value.lower(),value.lower()],True
    if field in SQL_NUMERIC:
        match = re.fullmatch(r"(>=|<=|!=|>|<|=)?\s*([+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?)\s*", value)
        if not match:
            return [], [], False
        op = match.group(1) or "="
        token = match.group(2)
        try:
            number = _hunt_number(token)
            finite = math.isfinite(number)
        except (ValueError,OverflowError):
            return [], [], False
        if not finite:
            return [], [], False
        if isinstance(number,int) and not -(1 << 63) <= number < (1 << 63):
            number = float(number)
        return ["%s %s ?" % (column, op)], [number], True
    adjust = SQL_CASE.get(field)
    if adjust and not any(ch in value for ch in '*?'):
        normalized = value.lower() if adjust == "lower" else value.upper()
        return ["%s = ?" % column], [normalized], True
    return _hunt_sql_text(column, value, icase or field in HUNT_CI_FIELDS, field in HUNT_SUBSTRING_FIELDS)


def hunt_match(node, ev, icase=False):
    kind = node[0]
    if kind == "and":
        return hunt_match(node[1], ev, icase) and hunt_match(node[2], ev, icase)
    if kind == "or":
        return hunt_match(node[1], ev, icase) or hunt_match(node[2], ev, icase)
    if kind == "not":
        return not hunt_match(node[1], ev, icase)
    if kind == "bare":
        needle = node[1]
        signature = flow_summary(*(ev.get(key) for key in ('app','proto','state','reason','sig'))) if ev.get('type') == 'flow' else ev.get('sig')
        haystack = " ".join(str((signature if key == 'sig' else ev.get(key)) or "") for key in
                            ("sig", "src", "dst", "app", "reason", "cat", "proto", "type"))
        if icase:
            needle = needle.lower()
            haystack = haystack.lower()
        if "*" in needle or "?" in needle:
            return fnmatch.fnmatchcase(haystack, "*" + needle + "*")
        return needle in haystack
    field, value = node[1], node[2]
    actual = ev.get(field)
    if field=='level' and not actual and ev.get('type') in ('alert','drop') and ev.get('sig_id'):
        actual='unknown'
    if field == 'community':
        icase = False
    if field == 'tuple_hash':
        actual = None if ev.get('community') or ev.get('community_id') or flow_identifier(ev.get('flow_id')) else tuple_hash(ev.get('src'),ev.get('sport'),ev.get('dst'),ev.get('dport'),ev.get('proto'))
        value = value.lower()
    if field == 'httpver':
        actual = http_version(ev.get('type'), ev.get('app'), actual)
    if field == 'sig' and ev.get('type') == 'flow':
        actual = flow_summary(*(ev.get(key) for key in ('app','proto','state','reason','sig')))
    if field in MITRE_FIELDS:
        values = actual if isinstance(actual, list) else [actual]
        values = [item for item in values if isinstance(item, str) and item]
        if value.strip() == '*':
            return bool(values)
        for item in values:
            query = value
            if icase or field.endswith('_id'):
                item, query = item.lower(), query.lower()
            if '*' in query or '?' in query:
                pattern = '*' + query + '*' if field in HUNT_SUBSTRING_FIELDS else query
                if fnmatch.fnmatchcase(item, pattern):
                    return True
            elif ((query in item) if field in HUNT_SUBSTRING_FIELDS else (query == item)):
                return True
        return False
    if value.strip() == "*":
        # Lucene 惯例：field:* 表示"该字段有值"，排除空串/NULL（level:* = 只留有严重度的事件）
        return actual not in (None, "")
    if field == "level":
        return HUNT_LEVEL_ALIASES.get(value.strip().lower(), value.strip().lower()) == (actual or "")
    if field in HUNT_NUMBER_FIELDS:
        return _hunt_num(actual, value)
    if field in ("src", "dst") and "/" in value:
        try:
            net = ip_network(value, strict=False)
        except ValueError:
            return False
        try:
            return ip_address(actual) in net
        except ValueError:
            return False
    text = "" if actual is None else str(actual)
    if icase:
        text = text.lower()
        value = value.lower()
    if field in HUNT_CI_FIELDS:
        # 枚举类字段（proto/action/dir/type/app/state/...）不区分大小写，
        # eve.json 里是 "TCP"、用户通常写 "tcp"
        text = text.lower()
        value = value.lower()
    if "*" in value or "?" in value:
        if not text:
            return False
        pattern = value
        if field in HUNT_SUBSTRING_FIELDS:
            # 子串字段：通配符按“包含”处理，sni:*.google.com / sni:google* 都能命中
            if not pattern.startswith("*"):
                pattern = "*" + pattern
            if not pattern.endswith("*"):
                pattern += "*"
        return fnmatch.fnmatchcase(text, pattern)
    if field in HUNT_SUBSTRING_FIELDS:
        return value in text
    return text == value


# -- 自定义狩猎规则（独立文件，ips-snort-rules 不会覆盖）------------------
def hunt_rules_list():
    out = []
    try:
        with open(HUNT_RULES, "r", encoding="utf-8") as handle:
            for line in handle:
                text = line.strip()
                if not text or text.startswith("#"):
                    continue
                match = re.search(r"\bsid\s*:\s*(\d+)", text)
                out.append({"sid": int(match.group(1)) if match else None, "line": text})
    except OSError:
        pass
    return out


def hunt_rule_structure_valid(text):
    depth = 0
    quoted = escaped = False
    for char in text:
        if escaped:
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == '"':
            quoted = not quoted
        elif not quoted:
            if char == "(":
                depth += 1
            elif char == ")":
                depth -= 1
                if depth < 0:
                    return False
    return depth == 0 and not quoted and not escaped


def hunt_rule_add(rule):
    text = (rule or "").strip()
    if not text:
        return False, "规则为空"
    if "\n" in text or "\r" in text:
        return False, "规则不能包含换行"
    if not re.match(r"^(alert|block|drop|pass|reject|log)\s+", text):
        return False, "必须以 alert/block/drop/pass/reject/log 开头"
    if not hunt_rule_structure_valid(text):
        return False, "括号或引号不匹配"
    if not text.endswith(")"):
        return False, "规则必须以 ) 结尾"
    existing = hunt_rules_list()
    used = {item["sid"] for item in existing if item["sid"]}
    match = re.search(r"\bsid\s*:\s*(\d+)", text)
    if match:
        sid = int(match.group(1))
        if sid in used:
            return False, "sid %d 已存在" % sid
    else:
        sid = 9200001
        while sid in used:
            sid += 1
        text = text[:-1].rstrip() + " sid:%d;)" % sid
    if not os.path.exists(HUNT_RULES):
        with open(HUNT_RULES, "w", encoding="utf-8") as handle:
            handle.write("# ips-web 自定义狩猎规则（ips-snort-rules 不会覆盖）\n")
    with open(HUNT_RULES, "a", encoding="utf-8") as handle:
        handle.write(text + "\n")
    return True, "sid:%d" % sid


def hunt_rule_delete(sid):
    try:
        sid = int(sid)
    except (TypeError, ValueError):
        return False, "无效 sid"
    keep, removed = [], False
    try:
        with open(HUNT_RULES, "r", encoding="utf-8") as handle:
            for line in handle:
                match = re.search(r"\bsid\s*:\s*(\d+)", line)
                if match and int(match.group(1)) == sid:
                    removed = True
