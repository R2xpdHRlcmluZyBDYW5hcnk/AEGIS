def html_escape(text):
    return (str(text).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            .replace('"', "&quot;").replace("'", "&#39;"))


def parse_ts(value):
    """eve.json 的 timestamp: 2026-10-28T15:14:45.828464+0800"""
    if not value:
        return 0.0
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=timezone.utc)
        return parsed.timestamp()
    except Exception:
        return 0.0


def human_bytes(n):
    try:
        n = float(n)
    except Exception:
        return "-"
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1024 or unit == "TB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{int(n)} B"
        n /= 1024.0
    return "-"


def password_configured(config):
    return bool((config.get("password_pbkdf2") or "").strip()
                or (config.get("password_sha256") or "").strip())


def make_password_hash(password, iterations=PASSWORD_PBKDF2_ITERATIONS):
    salt = secrets.token_bytes(16)
    digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, iterations)
    return "pbkdf2-sha256$%d$%s$%s" % (
        iterations, base64.b64encode(salt).decode("ascii"),
        base64.b64encode(digest).decode("ascii"))


def verify_password(password, config):
    encoded = (config.get("password_pbkdf2") or "").strip()
    if encoded:
        try:
            scheme, rounds, salt_text, digest_text = encoded.split("$", 3)
            if scheme != "pbkdf2-sha256":
                return False
            iterations = int(rounds)
            if not 10000 <= iterations <= 10000000:
                return False
            salt = base64.b64decode(salt_text, validate=True)
            expected = base64.b64decode(digest_text, validate=True)
            actual = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, iterations)
            return hmac.compare_digest(actual, expected)
        except (ValueError, TypeError):
            return False
    expected_sha256 = (config.get("password_sha256") or "").strip().lower()
    if not expected_sha256:
        return False
    actual_sha256 = hashlib.sha256(password.encode("utf-8")).hexdigest()
    return hmac.compare_digest(actual_sha256, expected_sha256)


def _csv_cell(value):
    text = "" if value is None else str(value)
    if text.lstrip().startswith(("=", "+", "-", "@")):
        return "'" + text
    return text


def events_csv(events):
    output = io.StringIO(newline="")
    writer = csv.writer(output)
    writer.writerow(["time", "type", "severity", "sid", "signature", "source",
                     "source_port", "destination", "destination_port", "protocol", "action"])
    for ev in events:
        writer.writerow([
            iso(ev.get("ts")), ev.get("type"), ev.get("sev"), ev.get("sig_id"),
            _csv_cell(ev.get("sig")), _csv_cell(ev.get("src")), ev.get("sport"),
            _csv_cell(ev.get("dst")), ev.get("dport"), ev.get("proto"), ev.get("action"),
        ])
    return "\ufeff" + output.getvalue()


# --------------------------------------------------------------------------
# 事件存储（增量 tail）
# --------------------------------------------------------------------------
# --------------------------------------------------------------------------
# 事件库（SQLite 索引；按时间窗口查询，容量到顶自动回收）
# --------------------------------------------------------------------------
class EventDB:
    """事件库：SQLite 索引，覆盖狩猎搜索用到的全部字段"""
    MAX_RELATED_TUPLES = 32
    MAX_RELATED_FLOWS = 128

    CAP_BYTES = DB_CAP_BYTES
    RETENTION_DAYS = DB_RETENTION_DAYS
    BATCH = 200
    MIN_CAP_MIB = 64
    MAX_CAP_MIB = 1048576

    @classmethod
    def validate_cap_mib(cls, value):
        if type(value) is not int or not cls.MIN_CAP_MIB <= value <= cls.MAX_CAP_MIB:
            raise ValueError("容量上限须为 64 至 1048576 MiB 的整数")
        return value * (1 << 20)

    def configure_capacity(self, value):
        capacity = self.validate_cap_mib(value)
        with self.lock:
            atomic_text(self.path + '.settings.json', json.dumps({'cap_mib': value}) + '\n')
            self.cap = capacity
        return self.stats()

    # 列名 -> 记录字段；None 表示特殊处理（ts 存毫秒、raw 压缩、size 改名 fsize）
    COLUMNS = [
        *[(field, field) for field in __import__("snort_engine").EVENT_FIELDS.values()],
        ("ts", None), ("type", "type"), ("sev", "sev"), ("sid", "sig_id"),
        ("src", "src"), ("sport", "sport"), ("dst", "dst"), ("dport", "dport"),
        ("ip_version", "ip_version"),
        ("proto", "proto"), ("app", "app"), ("sig", "sig"), ("raw", None),
        ("sni", "sni"), ("host", "host"), ("dnsname", "dns"), ("url", "url"),
        ("ua", "ua"), ("fname", "file"), ("httpver", "httpver"), ("alpn", "alpn"),
        ("ja3", "ja3"), ("ja3s", "ja3s"), ("ja4", "ja4"), ("tlsver", "tlsver"),
        ("status", "status"), ("ct", "ct"), ("clen", "clen"), ("fsize", "size"),
        ("cat", "cat"), ("reason", "reason"), ("action", "action"), ("dir", "dir"),
        ("iif", "iif"), ("flow_id", "flow_id"), ("community", "community"),
        ("vlan", "vlan"), ("pkt_src", "pkt_src"), ("gid", "gid"), ("rev", "rev"),
        ("tx", "tx"), ("icmp_type", "icmp_type"), ("icmp_code", "icmp_code"),
        ("state", "state"), ("magic", "magic"), ("md5", "md5"), ("sha1", "sha1"),
        ("sha256", "sha256"), ("rrtype", "rrtype"), ("rcode", "rcode"),
        ("answers", "answers"), ("method", "method"), ("referrer", "referrer"),
        ("subject", "subject"), ("issuer", "issuer"), ("anom", "anom"),
        ("tier", None),
        ("event_key", None),
        ("alert_suppressed", "alert_suppressed"),
        ("bytes_toserver", "bytes_toserver"), ("bytes_toclient", "bytes_toclient"),
        ("pkts_toserver", "pkts_toserver"), ("pkts_toclient", "pkts_toclient"),
        ("flow_start", "flow_start"), ("flow_end", "flow_end"), ("flow_age", "flow_age"),
    ]
    TIER1_TYPES = {"alert", "drop", "anomaly", "fileinfo"}
    REC_KEY_COLUMN = {
        "dns": "dnsname", "file": "fname", "size": "fsize", "sig_id": "sid",
        "level": None,
    }
    NUMERIC_COLUMNS = {"ts", "sev", "sid", "tier", "alert_suppressed", "sport", "dport", "ip_version", "status",
                       "clen", "fsize", "flow_id", "vlan", "gid", "rev", "tx",
                       "icmp_type", "icmp_code", "bytes_toserver", "bytes_toclient",
                       "pkts_toserver", "pkts_toclient", "flow_start", "flow_end", "flow_age", "observed_first", "observed_last",
                       "dns_ttl", "wire_bytes_toserver", "wire_bytes_toclient", *__import__('snort_engine').PACKET_NUMBER_FIELDS,
                       *["appid_"+name+"_id" for name in ("service","client","payload","misc","referred")]}

    def __init__(self, path, cap=None, retention_days=None):
        self.path = path
        self.conn = None
        self.cap = cap or self.CAP_BYTES
        self.retention_days = retention_days or self.RETENTION_DAYS
        self.lock = threading.RLock()
        self.last_error = ""
        self.write_error = ""
        self.write_blocked = False
        # Read-only request copies share the observation with the live writer.
        self.read_health = {}
        try:
            with open(self.path + '.settings.json', encoding='utf-8') as handle:
                self.cap = self.validate_cap_mib(json.load(handle)['cap_mib'])
        except FileNotFoundError:
            pass
        except (OSError, ValueError, TypeError, KeyError) as exc:
            self.last_error = '读取事件库容量设置失败: ' + str(exc)
        self.query_state = threading.local()
        self.last_truncated = False
        self.buf = []
        self.last_flush = 0.0
        self.last_maint = 0.0
        self.summary_cache = {}
        self.visibility_cache = {}
        self.network_generation = 0
        self.stream_cutoff = None
        self.names = [name for name, _ in self.COLUMNS]
        self.select_sql = ("SELECT " + ", ".join(self.names) + " FROM events"
                           " WHERE ts >= ? AND ts <= ?")
        self.insert_sql = ("INSERT OR IGNORE INTO events (" + ", ".join(self.names) +
                           ") VALUES (" + ",".join("?" * len(self.names)) + ")")
        try:
            self.conn = sqlite3.connect(path, check_same_thread=False, timeout=10)
            self.conn.execute("PRAGMA journal_mode=WAL")
            self.conn.execute("PRAGMA synchronous=FULL")
            self.conn.execute("PRAGMA auto_vacuum=INCREMENTAL")
            self.conn.execute("PRAGMA journal_size_limit=67108864")
            defs = []
            for column, _ in self.COLUMNS:
                if column == "id":
                    continue
                sql_type = "INTEGER" if column in self.NUMERIC_COLUMNS else "TEXT"
                defs.append("%s %s" % (column, sql_type))
            defs.insert(0, "id INTEGER PRIMARY KEY")
            # Only an identical source record is a duplicate. Timestamp, tuple
            # and SID can coincide across generators, packets and sessions.
            self.conn.execute("CREATE TABLE IF NOT EXISTS events (%s)" % ", ".join(defs))
            self.conn.execute('CREATE TABLE IF NOT EXISTS event_state (key TEXT PRIMARY KEY,value TEXT NOT NULL)')
            self.conn.execute('INSERT OR IGNORE INTO event_state VALUES(?,?)',('clear_epoch',secrets.token_hex(16)))
            floor=self.conn.execute("SELECT value FROM event_state WHERE key='stream_cutoff'").fetchone()
            if floor: self.stream_cutoff=json.loads(floor[0])
            existing = {row[1] for row in self.conn.execute("PRAGMA table_info(events)")}
            for column, _ in self.COLUMNS:
                if column not in existing:
                    sql_type = "INTEGER" if column in self.NUMERIC_COLUMNS else "TEXT"
                    self.conn.execute("ALTER TABLE events ADD COLUMN %s %s" % (column, sql_type))
            self.conn.execute("PRAGMA busy_timeout = 8000")
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_events_tier_ts ON events(tier, ts)")
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_events_ts ON events(ts)")
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_events_type_ts ON events(type, ts)")
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_events_flow_ts ON events(flow_id, ts)")
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_events_session_ts ON events(session_id, ts) WHERE session_id IS NOT NULL")
            indexes = [row[1] for row in self.conn.execute('PRAGMA index_list(events)')]
            if not any([r[2] for r in self.conn.execute('PRAGMA index_info("'+name.replace('"','""')+'")')] == ['community','ts'] for name in indexes):
                self.conn.execute('CREATE INDEX IF NOT EXISTS idx_events_community_ts ON events(community,ts)')
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_events_dns_overview ON events(ts,dnsname) WHERE type='dns'")
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_events_tls_overview ON events(ts,sni) WHERE type='tls'")
            self.conn.execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_events_key ON events(event_key)"
                              " WHERE event_key IS NOT NULL")
            self.conn.commit()
        except sqlite3.Error as exc:  # noqa: BLE001
            if self.conn is not None:
                try:self.conn.close()
                except sqlite3.Error:pass
            self.conn = None
            self._write_failure(exc)

    # -- 写入 ---------------------------------------------------------
    def _write_failure(self, exc):
        message = str(exc)
        if message != self.write_error:
            print('Event database write failed: ' + message, file=sys.stderr, flush=True)
        self.last_error = self.write_error = message
        code = getattr(exc, 'sqlite_errorcode', 0) & 255
        if code in (sqlite3.SQLITE_CORRUPT, sqlite3.SQLITE_NOTADB):
            # Structural corruption requires offline repair. Preserve the
            # pending batch and stop further writes and retention on the source.
            self.write_blocked = True

    def _rollback_write(self, exc):
        try:
            self.conn.rollback()
        except sqlite3.Error as rollback_error:
            self._write_failure(rollback_error)
            self.write_blocked = True
        self._write_failure(exc)

    def note_read_failure(self, exc):
        code = (getattr(exc, 'sqlite_errorcode', 0) or 0) & 255
        if code in (sqlite3.SQLITE_CORRUPT, sqlite3.SQLITE_NOTADB):
            self.read_health['fault'] = dict(message=str(exc), at=now())

    def _values(self, rec, raw):
        values = []
        for column, key in self.COLUMNS:
            if column == "ts":
                # Keep sub-millisecond precision; adjacent transactions must not collapse.
                values.append(rec["ts"] * 1000)
            elif column == "event_key":
                values.append(hashlib.sha256((repr(rec["ts"]) + "\n" + raw).encode("utf-8")).hexdigest())
            elif column == "raw":
                # Native envelopes retain protocol evidence and exact 64-bit
                # values beyond the indexed projection. Retention remains bounded.
                keep_raw = (rec.get('_native_snort') or rec.get('observer') or rec.get("type") == "alert" or
                            (rec.get("type") == "drop" and rec.get("sig_id")))
                values.append(zlib.compress(raw.encode("utf-8", "replace"), 6)
                              if keep_raw else b"")
            elif column in ("dnsname",):
                values.append(rec.get("dns") or "")
            elif column in ("fname",):
                values.append(rec.get("file") or "")
            elif column == "tier":
                etype = rec.get("type")
                rule_drop = etype == "drop" and rec.get("sig_id")
                values.append(1 if (etype in ("alert", "anomaly", "fileinfo") or rule_drop) else 2)
            elif column in ("fsize",):
                value = rec.get("size")
                values.append(value if value != "" else None)
            else:
                value = rec.get(key)
                if value is None or value == "":
                    values.append(None if column in self.NUMERIC_COLUMNS else "")
                else:
                    values.append(value)
        return values

    def add(self, rec, raw):
        if self.conn is None:
            return
        try:
            values = self._values(rec, raw)
        except (TypeError, ValueError, KeyError):
            return
        return self.add_prepared(values)

    def add_prepared(self, values):
        if self.conn is None or values is None:
            return
        with self.lock:
            self.buf.append(values)
            flush = len(self.buf) >= self.BATCH
        if flush:
            self.flush()
        return values[self.names.index('event_key')]

    def flush(self):
        if self.conn is None or self.write_blocked or not self.buf:
            return
        inserted = 0
        with self.lock:
            if self.write_blocked or not self.buf:
                return
            rows, self.buf = self.buf, []
            try:
                cursor = self.conn.executemany(self.insert_sql, rows)
                self.conn.commit()
                inserted = cursor.rowcount
                self.last_error = ""
                self.write_error = ""
            except sqlite3.Error as exc:  # noqa: BLE001
                self.buf = rows + self.buf
                self._rollback_write(exc)
        self.last_flush = now()
        on_commit = getattr(self, 'on_insert_commit', None)
        if inserted > 0 and on_commit is not None:
            on_commit()

    # -- 回收 ---------------------------------------------------------
    def _size(self):
        total = 0
        for suffix in ("", "-wal", "-shm"):
            try:
                total += os.path.getsize(self.path + suffix)
            except OSError:
                pass
        return total

    def _used_pages_bytes(self):
        pages = self.conn.execute('PRAGMA page_count').fetchone()[0]
        free = self.conn.execute('PRAGMA freelist_count').fetchone()[0]
        page_size = self.conn.execute('PRAGMA page_size').fetchone()[0]
        return (pages - free) * page_size

    def maintain(self, force=False):
        """分层回收：小批量删除，避免长时间持锁把查询卡住"""
        if self.conn is None or self.write_blocked:
            return
        if not force and now() - self.last_maint < 300:
            return
        self.last_maint = now()
        self.flush()
        if self.write_blocked or (self.write_error and self.buf):
            return
        now_ms = int(now() * 1000)
        t1_cut = now_ms - DB_TIER1_DAYS * 86400 * 1000
        t2_cut = now_ms - DB_TIER2_HOURS * 3600 * 1000
        deleted = 0
        with self.lock:
            try:
                for _ in range(40):
                    cur = self.conn.execute(
                        "DELETE FROM events WHERE id IN (SELECT id FROM events"
                        " WHERE tier = 2 AND ts < ? LIMIT 5000)", (t2_cut,))
                    self.conn.commit()
                    if cur.rowcount > 0:
                        self.network_generation += 1
                    if cur.rowcount <= 0:
                        break
                    deleted += cur.rowcount
                for _ in range(20):
                    cur = self.conn.execute(
                        "DELETE FROM events WHERE id IN (SELECT id FROM events"
                        " WHERE tier = 1 AND ts < ? LIMIT 5000)", (t1_cut,))
                    self.conn.commit()
                    if cur.rowcount > 0:
                        self.network_generation += 1
                    if cur.rowcount <= 0:
                        break
                    deleted += cur.rowcount
                # 容量到顶：优先删上下文层
                size = self._used_pages_bytes()
                guard = 0
                while size > self.cap and guard < 20:
                    guard += 1
                    cur = self.conn.execute(
                        "DELETE FROM events WHERE id IN (SELECT id FROM events"
                        " WHERE tier = 2 ORDER BY ts ASC LIMIT 5000)")
                    self.conn.commit()
                    if cur.rowcount > 0:
                        self.network_generation += 1
                    if cur.rowcount <= 0:
                        cur = self.conn.execute(
                            "DELETE FROM events WHERE id IN (SELECT id FROM events"
                            " ORDER BY ts ASC LIMIT 5000)")
                        self.conn.commit()
                        if cur.rowcount > 0:
                            self.network_generation += 1
                        if cur.rowcount <= 0:
                            break
                    size = self._used_pages_bytes()
                if deleted or self._size() > self.cap:
                    self.conn.execute("PRAGMA incremental_vacuum(2000)").fetchall()
                    self.conn.commit()
                    self.conn.execute("PRAGMA wal_checkpoint(PASSIVE)").fetchone()
                self.last_error = self.write_error = ''
            except sqlite3.Error as exc:  # noqa: BLE001
                self._rollback_write(exc)

    # -- 行转换 -------------------------------------------------------
    def _row_lite(self, row, keys):
        """构造只含指定字段的轻量记录，用于过滤（比构造全量字典快很多）"""
        pairs = dict(zip(self.names, row))
        rec = {"ts": (pairs.get("ts") or 0) / 1000.0, "type": pairs.get("type") or ""}
        for key in keys:
            if key == 'tuple_hash':
                rec[key] = None if pairs.get('session_id') or pairs.get('community') or flow_identifier(pairs.get('flow_id')) else tuple_hash(pairs.get('src'),pairs.get('sport'),pairs.get('dst'),pairs.get('dport'),pairs.get('proto'))
                continue
            column = self.REC_KEY_COLUMN.get(key, key)
            if not column:
                if key == "level":
                    sev = pairs.get("sev") or 0
                    rec["level"] = ("high" if sev == 1 else "medium" if sev == 2
                                    else "low" if sev >= 3 else "unknown" if rec['type'] in ('alert','drop') and pairs.get('sid') else "")
                continue
            value = pairs.get(column)
            rec[key] = http_version(rec['type'], pairs.get('app'), value) if key == 'httpver' else ("" if value is None else value)
        if rec['type'] == 'flow' and 'sig' in keys:
            rec['sig'] = flow_summary(*(pairs.get(key) for key in ('app','proto','state','reason','sig')))
        if rec['type']=='flow' and pairs.get('native_uid') not in (None,''):
            rec.pop('flow_start',None);rec.pop('flow_end',None)
        return rec

    def _row(self, row, matcher=None, need_raw=False):
        pairs = dict(zip(self.names, row))
        sev = pairs.get("sev") or 0
        rec = {
            "ts": (pairs.get("ts") or 0) / 1000.0,
            "type": pairs.get("type") or "",
            "sev": sev,
            "sig_id": pairs.get("sid"),
            "sig": pairs.get("sig") or "",
            "src": pairs.get("src") or "", "sport": pairs.get("sport"),
            "dst": pairs.get("dst") or "", "dport": pairs.get("dport"),
            "proto": pairs.get("proto") or "", "app": pairs.get("app") or "",
            "cat": pairs.get("cat") or "", "reason": pairs.get("reason") or "",
            "action": pairs.get("action") or "", "dir": pairs.get("dir") or "",
            "iif": pairs.get("iif") or "", "level": "",
            "sni": pairs.get("sni") or "", "host": pairs.get("host") or "",
            "dns": pairs.get("dnsname") or "", "url": pairs.get("url") or "",
            "ua": pairs.get("ua") or "", "file": pairs.get("fname") or "",
            "httpver": http_version(pairs.get('type'), pairs.get('app'), pairs.get('httpver')), "alpn": pairs.get("alpn") or "",
            "ja3": pairs.get("ja3") or "", "ja3s": pairs.get("ja3s") or "",
            "ja4": pairs.get("ja4") or "", "tlsver": pairs.get("tlsver") or "",
            "status": pairs.get("status") if pairs.get("status") is not None else "",
            "ct": pairs.get("ct") or "",
            "clen": pairs.get("clen") if pairs.get("clen") is not None else "",
            "size": pairs.get("fsize") if pairs.get("fsize") is not None else "",
            "flow_id": pairs.get("flow_id") if pairs.get("flow_id") is not None else "",
            "community": pairs.get("community") or "",
            "community_id": pairs.get("community") or "",
            "vlan": pairs.get("vlan") if pairs.get("vlan") is not None else "",
            "pkt_src": pairs.get("pkt_src") or "",
            "gid": pairs.get("gid") if pairs.get("gid") is not None else "",
            "rev": pairs.get("rev") if pairs.get("rev") is not None else "",
            "tx": pairs.get("tx") if pairs.get("tx") is not None else "",
            "icmp_type": pairs.get("icmp_type") if pairs.get("icmp_type") is not None else "",
            "icmp_code": pairs.get("icmp_code") if pairs.get("icmp_code") is not None else "",
            "state": pairs.get("state") or "", "magic": pairs.get("magic") or "",
            "md5": pairs.get("md5") or "", "sha1": pairs.get("sha1") or "",
            "sha256": pairs.get("sha256") or "",
            "rrtype": pairs.get("rrtype") or "", "rcode": pairs.get("rcode") or "",
            "answers": pairs.get("answers") or "",
            "method": pairs.get("method") or "", "referrer": pairs.get("referrer") or "",
            "subject": pairs.get("subject") or "", "issuer": pairs.get("issuer") or "",
            "anom": pairs.get("anom") or "",
        }
        for field in __import__("snort_engine").EVENT_FIELDS.values():
            rec[field] = pairs.get(field) if pairs.get(field) is not None else ""
        if rec['type'] == 'flow':
            rec['sig'] = flow_summary(*(rec.get(key) for key in ('app','proto','state','reason','sig')))
        for key in ("bytes_toserver", "bytes_toclient", "pkts_toserver", "pkts_toclient", "flow_start", "flow_end", "flow_age"):
            if key in ('flow_start','flow_end') and rec['type']=='flow' and rec.get('native_uid') not in (None,''):
                continue
            if pairs.get(key) is not None:
                rec[key] = pairs[key]
        if sev == 1:
            rec["level"] = "high"
        elif sev == 2:
            rec["level"] = "medium"
        elif sev >= 3:
            rec["level"] = "low"
        elif rec['type'] in ('alert','drop') and rec.get('sig_id'):
            rec['level'] = 'unknown'
        flow = flow_identifier(rec['flow_id'])
        hashed = None if rec.get('session_id') or rec['community'] else tuple_hash(rec['src'],rec['sport'],rec['dst'],rec['dport'],rec['proto'])
        rec['tuple_hash'] = hashed if not flow else None
        if flow and hashed:
            rec['association_flow_id'] = str(flow)
        if matcher is not None and need_raw:
            try:
                parsed = EventStore._parse(
                    zlib.decompress(pairs.get("raw")).decode("utf-8", "replace").encode("utf-8"))
            except Exception:  # noqa: BLE001
                parsed = None
            if parsed:
                rec = parsed[0]
                rec["id"] = None
        return rec

    def _security_from(self, where, dedup=False):
        if not dedup:
            return " FROM events" + where
        self._association_functions()
        keys = ("ts", "gid", "sid", "rev", "sig", "src", "sport", "dst", "dport",
                "proto", "tx")
        matching = " AND ".join("a.%s IS e.%s" % (key, key) for key in keys)
        identity = "CASE WHEN COALESCE(e.session_id,'')!='' THEN e.session_id END"
        association = 'a.session_id = '+identity
        return (" FROM (SELECT e.* FROM events e" + where +
                " AND (e.type = 'alert' OR ("+identity+") IS NULL OR NOT EXISTS (SELECT 1 FROM events a"
                " WHERE a.type = 'alert' AND " + matching + ' AND '+association+ ")))")

    def _association_functions(self):
        with self.lock:
            if self.conn is not None and getattr(self,'_association_connection',None) is not self.conn:
                self.conn.create_function('tuple_hash',5,tuple_hash,deterministic=True)
                self._association_connection = self.conn

    def _hunt_functions(self):
        with self.lock:
            if getattr(self, '_query_functions_connection', None) is not self.conn:
                self.conn.create_function('hunt_fold', 1, lambda value: str(value or '').lower(), deterministic=True)
                self.conn.create_function('hunt_glob', 2, lambda value, pattern: fnmatch.fnmatchcase(str(value or ''), pattern), deterministic=True)
                self.conn.create_function('hunt_network', 2, _hunt_sql_network, deterministic=True)
                self.conn.create_function('hunt_metadata', 4, _hunt_sql_metadata, deterministic=True)
                self.conn.create_function('flow_summary', 5, flow_summary, deterministic=True)
                self._query_functions_connection = self.conn

    @staticmethod
    def _association_value(prefix=''):
        field = lambda name: prefix+name
        hashed = 'tuple_hash('+','.join(field(k) for k in ('src','sport','dst','dport','proto'))+')'
        flow = field('flow_id')
        return ("CASE WHEN COALESCE("+field('community')+",'')!='' THEN 'community:'||"+field('community')+
                " WHEN "+hashed+" IS NOT NULL THEN CASE WHEN COALESCE("+flow+",0)>0 THEN 'flow:'||"+
                flow+"||':'||"+hashed+" ELSE 'tuple:'||"+hashed+' END END')

    @property
    def last_truncated(self):
        return getattr(self.query_state, 'truncated', False)

    @last_truncated.setter
    def last_truncated(self, value):
        self.query_state.truncated = value

    # -- 查询 ---------------------------------------------------------
    def _fetch_many(self, statements):
        return fetch_many(self.conn,statements,getattr(self,'parallel',None))

    def search_range(self, low, high, types=None, matcher=None, limit=100, offset=0,
                     max_scan=300000, need_raw=False, push=None, fields=None, dedup=False,
                     list_view=False, matcher_spec=None, include_total=True):
        self.last_truncated = False
        if self.conn is None:
            return 0, []
        self._association_functions()
        low = low * 1000
        high = high * 1000
        push_sql, push_args = (push or ([], []))
        conditions = ["ts >= ?", "ts <= ?"]
        args = [low, high]
        if push_sql:
            conditions.extend(push_sql)
            args.extend(push_args)
        if types:
            conditions.append("type IN (%s)" % ",".join("?" * len(types)))
            args.extend(types)
        source = self._security_from(" WHERE " + " AND ".join(conditions), dedup)
        selected = self.names
        if list_view:
            wanted = LIST_COLUMNS | {'session_id','native_uid'} | {self.REC_KEY_COLUMN.get(key, key) for key in fields or ()}
            if 'tuple_hash' in (fields or ()):
                wanted.update(('community','flow_id'))
            if need_raw:
                wanted.add('raw')
            selected = [name for name in self.names if name in wanted]
        base = "SELECT " + ('id, ' if list_view else '') + ", ".join(selected) + source

        def unpack(row):
            if not list_view:
                return row, None
            pairs = dict(zip(selected, row[1:]))
            identity = str(row[0]) + ':' + (pairs.get('event_key') or 't' + str(pairs.get('ts')))
            return tuple(pairs.get(name) for name in self.names), identity
        with self.lock:
            self._hunt_functions()
            if matcher is None:
                try:
                    page = base + " ORDER BY ts DESC LIMIT ? OFFSET ?"
                    if include_total:
                        counts, records = self._fetch_many([
                            ("SELECT COUNT(*)" + source,args), (page,args+[limit,offset])])
                        total = counts[0][0] or 0
                    else:
                        records = self.conn.execute(page, args+[limit,offset]).fetchall()
                        total = None
                    if not records:
                        return total, []
                    raw_idx = self.names.index("raw")
                    rows = []
                    for row in records:
                        row, identity = unpack(row)
                        rec = self._row(row, matcher=need_raw, need_raw=need_raw)
                        if row[raw_idx] and not list_view:
                            try:
                                rec["_raw"] = zlib.decompress(row[raw_idx]).decode(
                                    "utf-8", "replace")
                            except Exception:  # noqa: BLE001
                                pass
                        rows.append(list_record(rec, identity,network=list_view=='network') if list_view else rec)
                    return total, rows
                except sqlite3.Error as exc:  # noqa: BLE001
                    self.last_error = str(exc)
                    self.note_read_failure(exc)
                    message = '事件查询中断或超时，请重试或缩小时间范围' if str(exc)=='interrupted' else '事件查询失败：'+str(exc)
                    raise RuntimeError(message) from exc
            matched = 0
            out = []
            try:
                cursor = self.conn.execute(base + " ORDER BY ts DESC", args)
            except sqlite3.Error as exc:  # noqa: BLE001
                self.last_error = str(exc)
                self.note_read_failure(exc)
                message = '事件查询中断或超时，请重试或缩小时间范围' if str(exc)=='interrupted' else '事件查询失败：'+str(exc)
                raise RuntimeError(message) from exc
            scanned = 0
            used_keys = set(fields or ())
            used_keys.update({"type", "ts"})
            truncated = False
            if matcher_spec is not None and getattr(self,'cpu',None) is not None:
                first=cursor.fetchmany(256)
                if len(first)>=128:
                    from event_processing import match_hunt_rows
                    scan={'count':0,'truncated':False}
                    def candidates():
                        for raw in chain(first,cursor):
                            scan['count']+=1
                            if scan['count']>max_scan:
                                scan['truncated']=True;break
                            yield unpack(raw)
                    def weight(item):
                        return 128+sum(len(value) if isinstance(value,(str,bytes)) else 8 for value in item[0])
                    batches=byte_batches(candidates(),size=weight)
                    node,icase=matcher_spec
                    jobs=((batch,self.names,used_keys,need_raw,node,icase) for batch in batches)
                    for hits in self.cpu.ordered(match_hunt_rows,jobs,cancelled=getattr(self,'cpu_cancelled',None)):
                        for row,identity,lite in hits:
                            matched+=1
                            if matched>offset and len(out)<limit:
                                rec=lite if need_raw else self._row(row)
                                blob=row[self.names.index('raw')]
                                if blob and not list_view:
                                    try:rec['_raw']=zlib.decompress(blob).decode('utf-8','replace')
                                    except Exception:pass
                                rec['id']=None
                                out.append(list_record(rec,identity,network=list_view=='network') if list_view else rec)
                    self.last_truncated=scan['truncated']
                    return matched,out
                cursor=iter(first)
            for row in cursor:
                row, identity = unpack(row)
                scanned += 1
                if scanned > max_scan:
                    truncated = True
                    break
                lite = (self._row_lite(row, used_keys) if not need_raw
                        else self._row(row, matcher, need_raw))
                if not matcher(lite):
                    continue
                matched += 1
                if matched > offset and len(out) < limit:
                    rec = self._row(row) if not need_raw else lite
                    blob = row[self.names.index("raw")]
                    if blob and not list_view:
                        try:
                            rec["_raw"] = zlib.decompress(blob).decode("utf-8", "replace")
                        except Exception:  # noqa: BLE001
                            pass
                    rec["id"] = None
                    out.append(list_record(rec, identity,network=list_view=='network') if list_view else rec)
            self.last_truncated = truncated
            return matched, out

    def read_record(self, token, include_raw=True):
        ident, separator, expected = str(token).partition(':')
        if not separator or not ident.isdigit() or len(ident) > 19:
            raise ValueError('事件标识无效')
        with self.lock:
            columns = [name for name in self.names if include_raw or name != 'raw']
            row = self.conn.execute('SELECT '+', '.join(columns)+' FROM events WHERE id=?',
                                    (int(ident),)).fetchone() if self.conn is not None else None
        if row is None:
            return None
        pairs = dict(zip(columns, row))
        actual = pairs.get('event_key') or 't' + str(pairs.get('ts'))
        if not hmac.compare_digest(expected, actual):
            return None
        record = self._row(tuple(pairs.get(name) for name in self.names))
        record['record_id'] = token
        raw = None
        raw_text = ''
        if pairs.get('raw'):
            try:
                raw_text = zlib.decompress(pairs['raw']).decode('utf-8')
                raw = json.loads(raw_text)
            except (ValueError, zlib.error):
                pass
        return dict(record=record, raw=raw if raw is not None else dict(record), raw_text=raw_text)

    def context_records(self, conditions, arguments, limit=1, oldest=False):
        """Internal fixed predicates; project facts without fetching payload blobs."""
        columns = ['id', *[name for name in self.names if name != 'raw']]
        direction = 'ASC' if oldest else 'DESC'
        with self.lock:
            rows = self.conn.execute('SELECT '+','.join(columns)+' FROM events WHERE '+conditions+
                ' ORDER BY ts '+direction+',id '+direction+' LIMIT ?', [*arguments, limit]).fetchall()
        output = []
        for row in rows:
            pairs = dict(zip(columns, row))
            record = self._row(tuple(pairs.get(name) for name in self.names))
            record['_context_id'] = pairs['id']
            record['record_id'] = str(pairs['id']) + ':' + (pairs.get('event_key') or 't' + str(pairs.get('ts')))
            output.append(record)
        return output

    def session_context(self, session):
        """Retained facts and bounded representative evidence for one exact session."""
        if not isinstance(session, str) or not re.fullmatch(r'[0-9a-f]{32}:[0-9a-f]{16}',session):
            raise ValueError('引擎会话 ID 无效')
        with self.lock:
            stats = self.conn.execute('SELECT COUNT(*),MIN(ts),MAX(ts) FROM events WHERE session_id=?',[session]).fetchone()
            if not stats or not stats[0]:
                return None
            kinds = dict(self.conn.execute('SELECT type,COUNT(*) FROM events WHERE session_id=? GROUP BY type',[session]))
            actions = dict(self.conn.execute("SELECT action,COUNT(*) FROM events WHERE session_id=? AND type IN ('alert','drop') AND COALESCE(action,'')!='' GROUP BY action",[session]))
        records, used = [], set()
        def collect(predicate='', args=(), limit=1, oldest=False):
            rows = self.context_records('session_id=?'+(' AND '+predicate if predicate else ''),[session,*args],limit,oldest)
            for row in rows:
                if row['_context_id'] not in used:
                    used.add(row['_context_id']);records.append(row)
        # Include detection/disposition and connection outcome before protocol details.
        collect("type IN ('alert','drop')",limit=2)
        collect("type IN ('alert','drop') AND action IN ('blocked','drop','reject','reset')")
        collect("type='flow' OR (type='quic' AND flow_start IS NOT NULL)")
        if kinds.get('session'):collect("type='session'")
        for kind in ('dns','tls','http','anomaly','fileinfo'):
            if kinds.get(kind):
                collect('type=?',[kind])
        collect(oldest=True)
        collect()
        return dict(scope='session', session_id=session, total_records=stats[0],
                    first_ts=stats[1]/1000, last_ts=stats[2]/1000,
                    event_counts=kinds, action_counts=actions, records=records)

    def search(self, window=60, matcher=None, limit=100, offset=0, max_scan=300000):
        return self.search_range(now() - window * 60, now() + 5, matcher=matcher,
                                 limit=limit, offset=offset, max_scan=max_scan)

    def stats(self):
        info = {"path": self.path, "size": self._size(), "rows": 0,
                "oldest": 0, "newest": 0, "cap": self.cap, "error": self.write_error or self.last_error,
                "min_cap_mib": self.MIN_CAP_MIB, "max_cap_mib": self.MAX_CAP_MIB}
        if self.conn is None:
            return info
        with self.lock:
            try:
                row = self.conn.execute("SELECT COUNT(*), MIN(ts), MAX(ts) FROM events").fetchone()
                info["rows"] = row[0] or 0
                info["oldest"] = (row[1] or 0) / 1000.0
                info["newest"] = (row[2] or 0) / 1000.0
            except sqlite3.Error as exc:  # noqa: BLE001
                info["error"] = str(exc)
                self.note_read_failure(exc)
        return info

    @staticmethod
    def _incident_key():
        return "CASE WHEN COALESCE(session_id,'')!='' THEN 'session:'||session_id ELSE " + EventDB._event_identity() + " END"

    @staticmethod
    def _event_identity(prefix=''):
        return "COALESCE('event:'||"+prefix+"event_key,'record:'||"+prefix+"id||':'||"+prefix+'ts)'

    def _incident_source(self, low_ms, high_ms, types=('alert','drop'), candidates=None, signed=True):
        """Only engine-owned session IDs merge records. Missing IDs stay independent."""
        columns = 'id,type,session_id,community,flow_id,event_key,ts,sev,sid,sig,src,dst,sport,dport,proto,app,action,cat,gid'
        kinds = ('type IN ('+','.join('?' for _ in types)+') AND ') if types else ''
        scope,args = candidates or ('',[])
        where=' WHERE '+kinds+'ts>=? AND ts<=?'+(' AND '+self.DETECTION_SQL if signed else '')+(' AND ('+scope+')' if scope else '')
        sql = 'WITH incident_events AS MATERIALIZED (SELECT '+columns+','+self._incident_key()+ ' AS incident_id'+self._security_from(where,dedup=signed)+') '
        return sql,list(types or ())+[low_ms,high_ms]+args

    def incident_filter(self, identity):
        if identity.startswith('session:'):
            return ['session_id=?'],[identity.removeprefix('session:')]
        if identity.startswith('event:'):
            return ['event_key=?'],[identity.removeprefix('event:')]
        if identity.startswith('record:'):
            _,record_id,stamp = identity.split(':',2)
            return ['id=?','ts=?'],[int(record_id),float(stamp)]
        raise ValueError('安全事件关联标识无效')

    def association_filter(self, identity):
        self._association_functions()
        if identity.startswith('session:'):
            return ['session_id=?'],[identity.removeprefix('session:')]
        if identity.startswith('community:'):
            return ['community=?'],[identity.split(':',1)[1]]
        if identity.startswith('event:'):
            return ['event_key=?'],[identity.split(':',1)[1]]
        if identity.startswith('flow:'):
            _,flow,hashed = identity.split(':',2)
            return ["COALESCE(community,'')=''",'flow_id=?','tuple_hash(src,sport,dst,dport,proto)=?'],[int(flow),hashed]
        if identity.startswith('tuple:') and hasattr(self,'summary_cursor'):
            # Stored tuples are candidate indexes, not authoritative incident identities.
            return ["COALESCE(community,'')=''",'COALESCE(flow_id,0)<=0',
                    '(id IN (SELECT id FROM summaries.facts WHERE association=?) OR (id>? AND '+self._association_value()+'=?))'],[identity,self.summary_cursor,identity]
        return [self._association_value()+'=?'],[identity]

    def security_incidents(self, low, high, sev=None, proto=None, q="", offset=0, limit=50,
                           incident_id=None, signature_limit=3):
        self._association_functions()
        low_ms, high_ms = low*1000,high*1000
        key = 'incident_id'
        membership = None
        if incident_id:
            membership = self.incident_filter(incident_id)
            source,source_args = self._incident_source(low_ms,high_ms,candidates=(' AND '.join(membership[0]),membership[1]))
        else:
            source,source_args = self._incident_source(low_ms,high_ms)
        conditions,args = ["ts>=?","ts<=?"],[low_ms,high_ms]
        if sev is not None:
            conditions.append('sev=?');args.append(sev)
        if proto:
            conditions.append('LOWER(proto)=?');args.append(proto.lower())
        if q:
            columns=('sig','src','dst','app','cat','proto','sport','dport','community')
            conditions.append('('+' OR '.join("INSTR(LOWER(COALESCE("+c+",'')),?)>0" for c in columns)+')')
            args.extend([q.lower()]*len(columns))
        if incident_id:
            conditions.append('incident_id=?');args.append(incident_id)
        where=' WHERE '+' AND '.join(conditions)
        with self.lock:
            try:
                count_sql=source+'SELECT COUNT(*) FROM (SELECT '+key+' FROM incident_events'+where+' GROUP BY '+key+')'
                selected='SELECT id,session_id AS community,ts,sev,sid,sig,src,dst,sport,dport,proto,action,cat,incident_id,gid FROM incident_events'+where
                sql=source+', picked AS ('+selected+"), grouped AS (\n                  SELECT incident_id,MAX(community) AS community,MIN(ts) AS first_ts,MAX(ts) AS last_ts,\n                    COALESCE(MIN(NULLIF(sev,0)),0) AS severity,COUNT(*) AS n,\n                    COUNT(DISTINCT COALESCE(gid,1)||':'||COALESCE(sid,'')||':'||sig) AS signatures,\n                    MAX(action IN ('blocked','drop','reject')) AS blocked\n                  FROM picked GROUP BY incident_id), ranked AS (\n                  SELECT *,ROW_NUMBER() OVER(PARTITION BY incident_id ORDER BY ts DESC,id DESC) AS rn FROM picked)\n                  SELECT g.incident_id,g.community,g.first_ts,g.last_ts,g.severity,g.n,g.signatures,\n                    r.src,r.dst,r.sport,r.dport,r.proto,g.blocked,r.sig,r.sid,r.cat\n                  FROM grouped g JOIN ranked r ON r.incident_id=g.incident_id AND r.rn=1\n                  ORDER BY g.last_ts DESC,g.incident_id LIMIT ? OFFSET ?"
                counts,rows=self._fetch_many([(count_sql,source_args+args),(sql,source_args+args+[limit,offset])])
                total=counts[0][0]
                ids=[row[0] for row in rows]
                signatures,blocked={},set()
                if ids:
                    marks=','.join('?' for _ in ids)
                    if membership:
                        dropped = self.conn.execute("SELECT 1 FROM events WHERE type='drop' AND ts>=? AND ts<=? AND action IN ('blocked','drop','reject') AND "+' AND '.join(membership[0])+' LIMIT 1',[low_ms,high_ms]+membership[1]).fetchone()
                        blocked = {incident_id} if dropped else set()
                    elif not incident_id:
                        drop_source,drop_args = self._incident_source(low_ms,high_ms,types=('alert','drop'),signed=False)
                        blocked={r[0] for r in self.conn.execute(drop_source+"SELECT DISTINCT incident_id FROM incident_events WHERE type='drop' AND ts>=? AND ts<=? AND action IN ('blocked','drop','reject') AND incident_id IN ("+marks+')',drop_args+[low_ms,high_ms]+ids)}
                    hits = 'SELECT incident_id,sig,sid,sev,cat,gid,COUNT(*) AS n,MIN(ts) AS first_ts,MAX(ts) AS last_ts FROM incident_events'+where+' AND '+key+' IN ('+marks+') GROUP BY '+key+',sig,sid,sev,cat,gid'
                    signatures_sql = source+', hits AS ('+hits+'), ranked AS (SELECT *,ROW_NUMBER() OVER(PARTITION BY incident_id ORDER BY n DESC,CASE WHEN sev>0 THEN sev ELSE 99 END,sig,sid) AS rn FROM hits) SELECT incident_id,sig,sid,sev,cat,gid,n,first_ts,last_ts FROM ranked WHERE rn<=?'
                    for ident,sig,sid,severity,cat,gid,n,first,last in self.conn.execute(signatures_sql,source_args+args+ids+[signature_limit]):
                        signatures.setdefault(ident,[]).append(dict(sig=sig or '',sid=sid,gid=gid or 1,sev=severity or 0,cat=cat or '',count=n,first_ts=first/1000,last_ts=last/1000))
                incidents=[]
                for row in rows:
                    items=signatures.get(row[0]) or []
                    items.sort(key=lambda item:(-item['count'],item['sev'] or 99,item['sig']))
                    primary=items[0] if items else dict(sig=row[13] or '',cat=row[15] or '')
                    incidents.append(dict(id=row[0],session_id=row[1] or '',community_id='',
                        tuple_hash='',
                        association_flow_id=row[0].split(':',2)[1] if row[0].startswith('flow:') else '',
                        first_ts=row[2]/1000,last_ts=row[3]/1000,ts=row[3]/1000,sev=row[4],
                        alert_count=row[5],signature_count=row[6],src=row[7] or '',dst=row[8] or '',
                        sport=row[9],dport=row[10],proto=row[11] or '',
                        action='blocked' if row[12] or row[0] in blocked else 'allowed',
                        sig=primary['sig'],cat=primary['cat'],signatures=items[:signature_limit]))
                return total,incidents
            except sqlite3.Error as exc:
                self.last_error=str(exc)
                self.note_read_failure(exc)
                message = '安全事件查询中断或超时，请重试或缩小时间范围' if str(exc)=='interrupted' else '安全事件查询失败：'+str(exc)
                raise RuntimeError(message) from exc

    def history_range(self):
        with self.lock:
            newest = self.conn.execute("SELECT MAX(ts) FROM events").fetchone()[0] if self.conn else None
        return 0, max(now(), (newest or 0) / 1000)

    def flow_range(self, flow_id):
        with self.lock:
            row = self.conn.execute('SELECT MIN(ts),MAX(ts) FROM events WHERE flow_id=?',
                                    (flow_id,)).fetchone() if self.conn else None
        if not row or row[0] is None:
            return None
        return {'from': math.floor(row[0] / 60000) * 60,
                'to': math.ceil(row[1] / 60000) * 60}

    def community_range(self, community):
        with self.lock:
            row = self.conn.execute('SELECT MIN(ts),MAX(ts) FROM events WHERE community=?',
                                    (community,)).fetchone() if self.conn else None
        if not row or row[0] is None:
            return None
        return {'from':math.floor(row[0]/60000)*60,'to':math.ceil(row[1]/60000)*60}

    def related_investigation(self, community='', endpoints=None, flow=None):
        """Build a visible predicate from every tuple of one identity; no transitive joins."""
        unique = {}
        flow_keys = set()
        with self.lock:
            self._hunt_functions()
            rows = self.conn.execute('SELECT DISTINCT src,sport,dst,dport,proto,flow_id FROM events WHERE community=?',
                                     (community,)) if community else [(*endpoints,flow)] if endpoints else []
            for row in rows:
                if row is None or len(row)!=6:
                    continue
                src,sport,dst,dport,proto,record_flow = row
                try:
                    source,destination = ip_address(src),ip_address(dst)
                    if source.version!=destination.version or sport is None or dport is None:
                        continue
                    sport,dport = int(sport),int(dport)
                    proto = str(proto or '').strip().upper()
                    if not (0<=sport<=65535 and 0<=dport<=65535) or not proto:
                        continue
                except (TypeError,ValueError):
                    continue
                key = (proto,tuple(sorted(((source.packed,sport),(destination.packed,dport)))))
                item = unique.setdefault(key,dict(endpoints=(src,sport,dst,dport,proto),flows=set()))
                if (identified_flow:=flow_identifier(record_flow)) is not None:
                    item['flows'].add(identified_flow)
                    flow_keys.add((key,identified_flow))
                if len(unique)>self.MAX_RELATED_TUPLES:
                    raise ValueError('关联五元组过多，请手动指定需要调查的端点条件')
                if len(flow_keys)>self.MAX_RELATED_FLOWS:
                    raise ValueError('关联 Flow ID 过多，请手动指定需要调查的流与端点条件')
            quote = lambda value:json.dumps(value,ensure_ascii=False)
            predicates = []
            for item in unique.values():
                src,sport,dst,dport,proto = item['endpoints']
                forward = 'src: '+quote(src)+' AND sport: '+str(sport)+' AND dst: '+quote(dst)+' AND dport: '+str(dport)
                reverse = 'src: '+quote(dst)+' AND sport: '+str(dport)+' AND dst: '+quote(src)+' AND dport: '+str(sport)
                flows = ' OR '.join(['NOT flow:>0']+['flow: '+str(value) for value in sorted(item['flows'])])
                predicates.append('(proto: '+quote(proto)+' AND (('+forward+') OR ('+reverse+')) AND ('+flows+'))')
            primary = 'community_id: '+quote(community) if community else ''
            fallback = '(NOT community_id:* AND ('+' OR '.join(predicates)+'))' if predicates else ''
            query = ' OR '.join(part for part in (primary,fallback) if part)
            if not query:
                raise ValueError('缺少完整五元组，无法准备关联查询')
            if len(urlencode({'q':query}))>48000:
                raise ValueError('关联查询过长，请手动指定需要调查的端点条件')
            clauses,args,complete = hunt_sql_pushdown(hunt_parse(query),True)
            if not complete:
                raise RuntimeError('无法准备关联查询')
            if len(args)>900:
                raise ValueError('关联查询条件过多，请手动指定需要调查的流与端点条件')
            bounds = self.conn.execute('SELECT MIN(ts),MAX(ts) FROM events WHERE '+' AND '.join(clauses),args).fetchone()
        if not bounds or bounds[0] is None:
            raise ValueError('未找到可调查的关联记录')
        return dict(query=query,tuple_count=len(unique),flow_count=len(flow_keys),
                    **{'from':math.floor(bounds[0]/60000)*60,'to':math.ceil(bounds[1]/60000)*60})

    def association_range(self, identity):
        clauses,args = self.association_filter(identity)
        with self.lock:
            row=self.conn.execute('SELECT MIN(ts),MAX(ts) FROM events WHERE '+' AND '.join(clauses),args).fetchone()
        return {'from':math.floor(row[0]/60000)*60,'to':math.ceil(row[1]/60000)*60} if row and row[0] is not None else None

    def incident_investigation(self, identity):
        """The hunt predicate and incident drawer use the same exact session identity."""
        if not re.fullmatch(r'session:[0-9a-f]{32}:[0-9a-f]{16}',identity):
            raise ValueError('此事件没有引擎会话 ID，不能合并调查')
        session=identity.removeprefix('session:')
        with self.lock:
            bounds=self.conn.execute('SELECT MIN(ts),MAX(ts) FROM events WHERE session_id=?',[session]).fetchone()
        if not bounds or bounds[0] is None:
            raise ValueError('未找到可调查的关联记录')
        return dict(query='session_id: '+json.dumps(session),tuple_count=0,flow_count=1,
                    **{'from':math.floor(bounds[0]/60000)*60,'to':math.ceil(bounds[1]/60000)*60})

    def security_incident(self, incident_id, low, high, network_offset=0, network_limit=50,
                          list_view=False):
        total, incidents = self.security_incidents(
            low, high, incident_id=incident_id, limit=1, signature_limit=500)
        if not total or not incidents:
            return None
        incident = incidents[0]
        if incident.get('session_id'):
            low, high = self.history_range()
            _, complete = self.security_incidents(low, high, incident_id=incident_id, limit=1, signature_limit=500)
            if not complete:
                return None
            incident = complete[0]
        alert_push = self.incident_filter(incident_id)
        alert_push=(alert_push[0]+[self.DETECTION_SQL],alert_push[1])
        alert_total, alerts = self.search_range(
            low, high, types=["alert","drop"], push=alert_push, limit=500,dedup=True)
        attack = {}
        def merge_attack(raw):
            try:
                metadata = attack_metadata(json.loads(raw))
            except (ValueError, TypeError):
                return
            for field, values in metadata.items():
                target = attack.setdefault(field, [])
                target.extend(value for value in values if value not in target)
        for alert in alerts:
            merge_attack(alert.get('_raw'))
        if alert_total > len(alerts):
            with self.lock:
                remaining = self.conn.execute(
                    "SELECT raw"+self._security_from(" WHERE ts >= ? AND ts <= ? AND type IN ('alert','drop') AND " +
                    " AND ".join(alert_push[0]),dedup=True) +
                    " ORDER BY ts DESC LIMIT -1 OFFSET ?",
                    [low * 1000, high * 1000] + alert_push[1] + [len(alerts)])
                for (blob,) in remaining:
                    if blob:
                        try:
                            merge_attack(zlib.decompress(blob))
                        except zlib.error:
                            pass
        context_low, context_high = low, high
        relation = 'session' if incident.get('session_id') else 'event'
        clauses,args = self.incident_filter(incident_id)
        network_total, network = self.search_range(
            context_low, context_high, push=(clauses, args), limit=network_limit, offset=network_offset,
            list_view='network' if list_view else False)
        if list_view:
            _, alerts = self.search_range(low,high,types=['alert','drop'],push=alert_push,limit=500,list_view=True,dedup=True)
        incident["network_count"] = network_total
        return {
            "incident": incident, "alerts": alerts, "network": network, "attack": attack,
            "relation": relation, "context_range": [context_low, context_high],
            "network_offset": network_offset, "network_limit": network_limit,
            "truncated": alert_total > len(alerts),
        }

    def network_summary(self, start, end, rolling=False):
        """Synchronous SQL helper; HTTP requests use NetworkSnapshots instead."""
        stamp = now()
        if self.conn is None:
            return dict(self.empty_network(), error=self.last_error or '事件库不可用')
        key = (start, end, rolling)
        with self.lock:
            cached = self.visibility_cache.get(key)
            if cached and stamp-cached[0] < 30:
                return cached[1]
            # Rolling windows move together; reuse only when both boundaries move by
            # the same amount. Explicit custom ranges are cached by their exact bounds.
            for old_key, (created, result) in self.visibility_cache.items():
                moving_together = abs((start-old_key[0])-(end-old_key[1])) < .001
                fixed_start = rolling == 'fixed_start' and start == old_key[0]
                if rolling and rolling == old_key[2] and stamp-created < 30 and (moving_together or fixed_start) and abs(end-old_key[1]) < 30:
                    return result
            try:
                result = self.compute_network_summary(self.conn, start, end)
                self.visibility_cache = {key:(stamp,result)}
                return result
            except sqlite3.Error as exc:
                self.last_error = str(exc)
                self.note_read_failure(exc)
                return dict(self.empty_network(), error=str(exc))

    @staticmethod
    def empty_network(value=0):
        return dict(records=value, flows=value, dns=value, tls=value, addresses=value,
                    bytes=value, bidirectional=value, one_way=value, newest=value, source_count=value, destination_count=value,
                    applications=[], protocols=[], dns_names=[], tls_names=[],
                    sources=[], event_types=[],log_sources=[],log_destinations=[])

    @staticmethod
    def compute_network_summary(conn, start, end, push=None, parallel=None):
        from overview_metrics import summarize
        return summarize(conn,start,end,push=push,parallel=parallel)

    # Detection and enforcement are overlapping facts, not exclusive log types.
    DETECTION_SQL = "(type='alert' OR (type='drop' AND sid>0 AND alert_suppressed IS NULL))"
    BLOCKED_SQL = "(type='drop' OR action='blocked')"

    def security_summary(self, window=60, topn=5, etype="all", start=None, end=None, dedup=False,
                         push=None, panel=False):
        """Indexed, unsampled security events; ordinary protocol logs stay in hunting."""
        stamp = now()
        low = int((stamp - window * 60 if start is None else start) * 1000)
        high = int((stamp if end is None else end) * 1000)
        empty = {"total": 0, "alerts": 0, "drops": 0, "high": 0,
                 "sources_count": 0, "destinations_count": 0, "newest": 0,
                 "signatures": [], "sources": [], "destinations": [],
                 "ports": [], "protocols": [], "reasons": [], "source": "db"}
        if self.conn is None:
            return dict(empty, error=self.last_error or "事件库不可用")
        with self.lock:
            cache_key = (window, topn, etype, start, end, dedup,repr(push),panel)
            cached = self.summary_cache.get(cache_key)
            if cached and stamp - cached[0] < 5:
                return cached[1]
            conditions = " WHERE ts >= ? AND ts <= ? AND type IN ('alert','drop')"
            args = (low, high)
            if etype in ("alert", "drop"):
                conditions += " AND type = ?"
                args += (etype,)
            if push and push[0]:
                conditions += ' AND '+' AND '.join(push[0])
                args += tuple(push[1])
            where = self._security_from(conditions, dedup)
            outer = " WHERE " if dedup else " AND "
            try:
                statements = [(
                    "SELECT COUNT(*), SUM("+self.DETECTION_SQL+"), SUM("+self.BLOCKED_SQL+
                    "), SUM("+self.DETECTION_SQL+" AND sev=1)" +
                    ", COUNT(DISTINCT NULLIF(src,'')), COUNT(DISTINCT NULLIF(dst,'')), MAX(ts)" +
                    where, args),
                    ("SELECT sig, sev, sid, COUNT(*)" + where +
                     " GROUP BY sig, sev, sid ORDER BY COUNT(*) DESC, sig LIMIT ?", args + (topn,))]
                dimensions = (("sources", "src", "ip"),("destinations", "dst", "ip"),
                              ("reasons", "reason", "reason"))
                if not panel:
                    for _,column,_ in dimensions:
                        statements.append(("SELECT " + column + ", COUNT(*)" + where +
                            outer + column + " != '' GROUP BY " + column +
                            " ORDER BY COUNT(*) DESC, " + column + " LIMIT ?", args + (topn,)))
                    statements.extend([
                        ("SELECT proto, COUNT(*)" + where + " GROUP BY proto ORDER BY COUNT(*) DESC", args),
                        ("SELECT dport, proto, COUNT(*)" + where + outer +
                         "dport IS NOT NULL GROUP BY dport, proto ORDER BY COUNT(*) DESC LIMIT ?",args+(topn,)),
                        ("SELECT MIN(ts) FROM events",())])
                rows = self._fetch_many(statements)
                row = rows[0][0]
                result = dict(empty, total=row[0], alerts=row[1] or 0, drops=row[2] or 0,
                              high=row[3] or 0, sources_count=row[4],
                              destinations_count=row[5], newest=(row[6] or 0) / 1000)
                result["signatures"] = [{"sig": sig, "sev": sev, "sid": sid, "count": count}
                    for sig, sev, sid, count in rows[1]]
                if not panel:
                    for (key,_,label),items in zip(dimensions,rows[2:5]):
                        result[key] = [{label:value,"count":count} for value,count in items]
                    result["protocols"] = [{"proto":proto,"count":count} for proto,count in rows[5]]
                    result["ports"] = [{"port": str(port) + '/' + proto.lower(), "count": count}
                        for port, proto, count in rows[6]]
                    result["oldest"] = (rows[7][0][0] or 0) / 1000
                self.summary_cache = {key: value for key, value in self.summary_cache.items() if stamp - value[0] < 5}
                if len(self.summary_cache) >= 64:
                    self.summary_cache.clear()
                self.summary_cache[cache_key] = (stamp, result)
                return result
            except sqlite3.Error as exc:
                self.last_error = str(exc)
                return dict(empty, error=str(exc))

    def security_series(self, minutes, bucket, start=None, end=None, push=None):
        span = bucket * 60
        high = now() if end is None else end
        low = high - minutes * 60 if start is None else start
        start, end = int(low // span) * span, int(high // span) * span
        counts = {}
        if self.conn is not None:
            conditions = " WHERE ts >= ? AND ts <= ? AND type IN ('alert','drop')"
            args = [span * 1000, low * 1000, high * 1000]
            if push and push[0]:
                conditions += ' AND '+' AND '.join(push[0])
                args.extend(push[1])
            source = self._security_from(conditions, dedup=True)
            with self.lock:
                try:
                    rows = self.conn.execute(
                        "SELECT CAST(ts / ? AS INTEGER), SUM("+self.DETECTION_SQL+
                        "), SUM("+self.BLOCKED_SQL+")" + source + " GROUP BY 1", args).fetchall()
                    for slot, alerts, drops in rows:
                        counts[(slot * span, 'alert')] = alerts or 0
                        counts[(slot * span, 'drop')] = drops or 0
                except sqlite3.Error as exc:
                    self.last_error = str(exc)
        return [{"t": slot, "alerts": counts.get((slot, "alert"), 0),
                 "drops": counts.get((slot, "drop"), 0)}
                for slot in range(start, end + 1, span)]

    def clear(self, stream_cutoff=None):
        with self.lock:
            if self.conn is None or self.write_blocked:
                return False
            try:
                self.summary_cache.clear()
                self.visibility_cache.clear()
                self.conn.execute("DELETE FROM events")
                self.conn.execute("UPDATE event_state SET value=? WHERE key='clear_epoch'",(secrets.token_hex(16),))
                self.conn.execute('INSERT INTO event_state VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value',('stream_cutoff',json.dumps(stream_cutoff)))
                self.conn.commit()
                self.buf=[]
                self.stream_cutoff=stream_cutoff
                self.network_generation += 1
                self.read_health.clear()
                # Keep the request bounded; normal maintenance reclaims free pages.
                self.last_error = ''
                return True
            except sqlite3.Error as exc:  # noqa: BLE001
                self._rollback_write(exc)
                return False


class StoredNetworkStats:
    """Rebuildable disk projection: time buckets and frequencies, never raw evidence."""
    COLUMNS = ('id','ts','type','event_key','b','src','dst','app','proto','dnsname','sni',
               'volume','bidirectional','one_way','community','sport','dport','association','session_id','orig_pkts','resp_pkts')

    def __init__(self, db, batch_size=1024, duty_percent=20):
        self.db = db
        self.batch_size = max(128,min(8192,int(batch_size)))
        self.duty_percent = max(5,min(80,float(duty_percent)))
        self.path = db.path + '.summary.db'
        self.stop = threading.Event()
        self.thread = None
        self.lock = threading.Lock()
        self.connections = set()
        self.generation = -1
        self.ready = False
        self.error = ''

    @staticmethod
    def install(conn):
        conn.executescript('''
        CREATE TABLE IF NOT EXISTS meta(k TEXT PRIMARY KEY,v TEXT NOT NULL);
        CREATE TABLE IF NOT EXISTS facts(id INTEGER PRIMARY KEY,ts REAL,type TEXT,event_key TEXT,
          b INTEGER,src TEXT,dst TEXT,app TEXT,proto TEXT,dnsname TEXT,sni TEXT,
          volume INTEGER,bidirectional INTEGER,one_way INTEGER,community TEXT,sport INTEGER,dport INTEGER,association TEXT);
        CREATE INDEX IF NOT EXISTS facts_ts ON facts(ts);
        CREATE INDEX IF NOT EXISTS facts_src_ts ON facts(src,ts) WHERE type='flow';
        CREATE TABLE IF NOT EXISTS counts(b INTEGER,type TEXT,n INTEGER,PRIMARY KEY(b,type)) WITHOUT ROWID;
        CREATE TABLE IF NOT EXISTS flows(b INTEGER,src TEXT,dst TEXT,app TEXT,proto TEXT,
          n INTEGER,volume INTEGER,bidirectional INTEGER,one_way INTEGER,
          PRIMARY KEY(b,src,dst,app,proto)) WITHOUT ROWID;
        CREATE TABLE IF NOT EXISTS names(b INTEGER,type TEXT,name TEXT,n INTEGER,
          PRIMARY KEY(b,type,name)) WITHOUT ROWID;
        CREATE TRIGGER IF NOT EXISTS fact_add AFTER INSERT ON facts BEGIN
          INSERT INTO counts VALUES(NEW.b,NEW.type,1) ON CONFLICT(b,type) DO UPDATE SET n=n+1;
        END;
        CREATE TRIGGER IF NOT EXISTS fact_remove AFTER DELETE ON facts BEGIN
          UPDATE counts SET n=n-1 WHERE b=OLD.b AND type=OLD.type;
          DELETE FROM counts WHERE b=OLD.b AND type=OLD.type AND n<=0;
        END;
        CREATE TRIGGER IF NOT EXISTS flow_add AFTER INSERT ON facts WHEN NEW.type='flow' BEGIN
          INSERT INTO flows VALUES(NEW.b,NEW.src,NEW.dst,NEW.app,NEW.proto,1,NEW.volume,NEW.bidirectional,NEW.one_way)
          ON CONFLICT(b,src,dst,app,proto) DO UPDATE SET n=n+1,volume=volume+NEW.volume,
            bidirectional=bidirectional+NEW.bidirectional,one_way=one_way+NEW.one_way;
        END;
        CREATE TRIGGER IF NOT EXISTS flow_remove AFTER DELETE ON facts WHEN OLD.type='flow' BEGIN
          UPDATE flows SET n=n-1,volume=volume-OLD.volume,bidirectional=bidirectional-OLD.bidirectional,
            one_way=one_way-OLD.one_way WHERE b=OLD.b AND src=OLD.src AND dst=OLD.dst AND app=OLD.app AND proto=OLD.proto;
          DELETE FROM flows WHERE b=OLD.b AND src=OLD.src AND dst=OLD.dst AND app=OLD.app AND proto=OLD.proto AND n<=0;
        END;
        CREATE TRIGGER IF NOT EXISTS name_add AFTER INSERT ON facts
          WHEN (NEW.type='dns' AND NEW.dnsname!='') OR (NEW.type='tls' AND NEW.sni!='') BEGIN
          INSERT INTO names VALUES(NEW.b,NEW.type,CASE NEW.type WHEN 'dns' THEN NEW.dnsname ELSE NEW.sni END,1)
          ON CONFLICT(b,type,name) DO UPDATE SET n=n+1;
        END;
        CREATE TRIGGER IF NOT EXISTS name_remove AFTER DELETE ON facts WHEN OLD.type IN ('dns','tls') BEGIN
          UPDATE names SET n=n-1 WHERE b=OLD.b AND type=OLD.type
            AND name=CASE OLD.type WHEN 'dns' THEN OLD.dnsname ELSE OLD.sni END;
          DELETE FROM names WHERE b=OLD.b AND type=OLD.type AND n<=0;
        END;
        ''')
        columns={row[1] for row in conn.execute('PRAGMA table_info(facts)')}
        for name,kind in [('community','TEXT'),('sport','INTEGER'),('dport','INTEGER'),('association','TEXT'),('session_id','TEXT'),('orig_pkts','INTEGER'),('resp_pkts','INTEGER')]:
            if name not in columns:
                conn.execute('ALTER TABLE facts ADD COLUMN '+name+' '+kind)
        conn.execute('CREATE INDEX IF NOT EXISTS facts_association_ts ON facts(association,ts)')
        if dict(conn.execute('SELECT k,v FROM meta')).get('format')!='3':
            conn.execute('DELETE FROM facts')
            StoredNetworkStats.update(conn,cursor=0,ready=0,format=3)
            conn.commit()

    @staticmethod
    def state(conn):
        return dict(conn.execute('SELECT k,v FROM meta'))

    @staticmethod
    def update(conn, **values):
        conn.executemany('INSERT INTO meta VALUES(?,?) ON CONFLICT(k) DO UPDATE SET v=excluded.v',
                         [(key,str(value)) for key,value in values.items()])

    def _source_rows(self, conn, sql, args=(), one=False):
        try:
            cursor = conn.execute(sql, args)
            return cursor.fetchone() if one else cursor.fetchall()
        except sqlite3.Error as exc:
            self.db.note_read_failure(exc)
            raise RuntimeError('读取事件库失败：' + str(exc)) from exc

    def _reconcile(self, source, conn):
        """Bounded identity checks remove deleted/replaced rows after retention or restart."""
        self.ready = False
        self.update(conn, ready=0)
        conn.commit()
        after = 0
        rewind = None
        while not self.stop.is_set():
            rows = conn.execute('SELECT id,ts,type,event_key FROM facts WHERE id>? ORDER BY id LIMIT 512', (after,)).fetchall()
            if not rows:
                break
            placeholders = ','.join('?' for _ in rows)
            retained = {r[0]:r[1:] for r in self._source_rows(source,
                'SELECT id,ts,type,event_key FROM events WHERE id IN ('+placeholders+')', [r[0] for r in rows])}
            removed = [(r[0],) for r in rows if retained.get(r[0]) != r[1:]]
            replaced = [r[0] for r in rows if r[0] in retained and retained[r[0]] != r[1:]]
            if replaced:
                rewind = min(rewind if rewind is not None else min(replaced)-1,min(replaced)-1)
            conn.executemany('DELETE FROM facts WHERE id=?', removed)
            conn.commit()
            after = rows[-1][0]
            self.stop.wait(.005)
        maximum = self._source_rows(source, 'SELECT COALESCE(MAX(id),0) FROM events', one=True)[0]
        cursor = min(int(self.state(conn).get('cursor',0)), maximum)
        if rewind is not None:
            cursor = min(cursor,rewind)
        source_count = self._source_rows(source, 'SELECT COUNT(*) FROM events INDEXED BY idx_events_ts WHERE id<=?', (cursor,), one=True)[0]
        indexed_count = conn.execute('SELECT COUNT(*) FROM facts WHERE id<=?',(cursor,)).fetchone()[0]
        if source_count != indexed_count:
            cursor = 0
        self.update(conn, cursor=cursor)
        conn.commit()

    def sync(self, source, conn, initial=False, batch=1024):
        state = self.state(conn)
        cursor = int(state.get('cursor',0))
        generation = self.db.network_generation
        clear_epoch=self._source_rows(source, "SELECT value FROM event_state WHERE key='clear_epoch'", one=True)[0]
        if state.get('clear_epoch') != clear_epoch:
            self.ready=False
            # Dropping projection tables removes attached triggers without a slow
            # row-by-row reconciliation against already-cleared history.
            conn.executescript('DROP TABLE IF EXISTS facts; DROP TABLE IF EXISTS counts; DROP TABLE IF EXISTS flows; DROP TABLE IF EXISTS names;')
            self.install(conn)
            self.update(conn,cursor=0,ready=0,clear_epoch=clear_epoch)
            conn.commit()
            cursor=0;initial=True
        if initial or generation != self.generation:
            count = self._source_rows(source, 'SELECT COUNT(*) FROM events INDEXED BY idx_events_ts WHERE id<=?', (cursor,), one=True)[0]
            indexed = conn.execute('SELECT COUNT(*) FROM facts WHERE id<=?', (cursor,)).fetchone()[0]
            last = self._source_rows(source, 'SELECT ts,type,event_key FROM events WHERE id=?', (cursor,), one=True)
            known = conn.execute('SELECT ts,type,event_key FROM facts WHERE id=?', (cursor,)).fetchone()
            identity = str(os.stat(self.db.path).st_dev)+':'+str(os.stat(self.db.path).st_ino)
            if state.get('source') not in (None,identity):
                self.ready = False
                conn.execute('DELETE FROM facts')
                self.update(conn,cursor=0,ready=0)
                conn.commit()
                cursor = 0
            elif generation != self.generation and not initial or count != indexed or last != known:
                self._reconcile(source, conn)
                cursor = int(self.state(conn).get('cursor',0))
                if count > indexed:
                    cursor = 0
            self.update(conn, source=identity)
        stamp = now()
        rows = self._source_rows(source, '''SELECT id,ts,type,event_key,CAST(ts/60000 AS INTEGER),
          COALESCE(src,''),COALESCE(dst,''),COALESCE(app,''),COALESCE(proto,''),
          COALESCE(dnsname,''),COALESCE(sni,''),COALESCE(bytes_toserver+bytes_toclient,0),
          COALESCE(pkts_toserver>0 AND pkts_toclient>0,0),
          COALESCE((pkts_toserver>0)!=(pkts_toclient>0),0),COALESCE(community,''),sport,dport,
          COALESCE(session_id,''),COALESCE(pkts_toserver,0),COALESCE(pkts_toclient,0)
          FROM events WHERE id>? ORDER BY id LIMIT ?''', (cursor,batch))
        if getattr(self,'cpu',None) is not None and len(rows)>=512:
            from event_processing import projection_rows
            batches=byte_batches(rows,size=lambda _:1024)
            rows=[row for batch in self.cpu.ordered(projection_rows,batches,
                    cancelled=lambda:self.stop.is_set() or generation!=self.db.network_generation) for row in batch]
        else:
            rows=[(*row[:17], 'community:'+row[14] if row[14] else
                   ('tuple:'+hashed if (hashed:=tuple_hash(row[5],row[15],row[6],row[16],row[8])) else None),*row[17:]) for row in rows]
        conn.executemany('INSERT OR IGNORE INTO facts ('+','.join(self.COLUMNS)+') VALUES('+','.join('?' for _ in self.COLUMNS)+')',rows)
        cursor = rows[-1][0] if rows else cursor
        ready = len(rows) < batch and generation == self.db.network_generation and not self.stop.is_set()
        self.update(conn, cursor=cursor, ready=int(ready), as_of=stamp)
        conn.commit()
        self.generation, self.ready, self.error = generation, ready, ''
        return ready

    def start(self):
        self.thread = threading.Thread(target=self._run,name='stored-network-stats',daemon=True)
        self.thread.start()

    def _run(self):
        source = conn = None
        try:
            source = sqlite3.connect(Path(self.db.path).resolve().as_uri()+'?mode=ro',uri=True,timeout=1)
            source.execute('PRAGMA query_only=ON')
            source.execute('PRAGMA cache_size=-2048')
            conn = sqlite3.connect(self.path,timeout=1)
            conn.execute('PRAGMA journal_mode=WAL')
            conn.execute('PRAGMA synchronous=NORMAL')
            conn.execute('PRAGMA cache_size=-2048')
            self.install(conn)
            with self.lock:
                self.connections.update((source,conn))
            initial = True
            while not self.stop.is_set():
                batch_started = time.monotonic()
                try:
                    with self.lock:
                        complete = self.sync(source,conn,initial,self.batch_size)
                    initial = False
                except (sqlite3.Error,OSError,ValueError,TypeError,RuntimeError) as exc:
                    conn.rollback()
                    self.ready, self.error = False, str(exc)
                    initial, complete = True, True
                # Backfill yields most of its duty cycle to packet inspection and UI reads.
                pause = (time.monotonic()-batch_started)*(100/self.duty_percent-1)
                self.stop.wait(2 if complete else max(.05,min(5,pause)))
        except (sqlite3.Error,OSError,ValueError,TypeError) as exc:
            self.ready, self.error = False, str(exc)
        finally:
            with self.lock:
                self.connections.clear()
            if source is not None:
                source.close()
            if conn is not None:
                conn.close()

    def close(self):
        self.stop.set()
        with self.lock:
            for conn in self.connections:
                conn.interrupt()
        if self.thread is not None:
            self.thread.join(timeout=5)

    def summary(self, start, end, cancelled, parallel=True):
        if not self.ready or self.generation != self.db.network_generation:
            return None
        conn = None
        try:
            conn = sqlite3.connect(Path(self.path).resolve().as_uri()+'?mode=ro',uri=True,timeout=1)
            conn.execute('PRAGMA query_only=ON')
            conn.execute('PRAGMA cache_size=-2048')
            conn.set_progress_handler(cancelled,10000)
            conn.execute('BEGIN')
            pool = getattr(self.db,'query_pool',None)
            context = (pool.snapshot(SimpleNamespace(path=self.path,lock=self.lock),conn,cancelled=cancelled)
                       if parallel and pool is not None and not pool.stop.is_set() else nullcontext(None))
            with context as parallel:
                state = self.state(conn)
                if state.get('ready') != '1' or now()-float(state.get('as_of',0))>30:
                    return None
                result = self.aggregate(conn,start,end,parallel=parallel)
                result['as_of'] = float(state['as_of'])
                return result
        except (sqlite3.Error,ValueError,TypeError) as exc:
            if cancelled():
                raise
            self.error = str(exc)
            return None
        finally:
            if conn is not None:
                conn.close()

    @staticmethod
    def aggregate(conn,start,end,parallel=None):
        from overview_metrics import summarize
        return summarize(conn,start,end,table='facts',parallel=parallel)



class NetworkSnapshots:
    """One bounded worker publishes immutable network summaries for HTTP readers."""

    REFRESH_SECONDS = 30
    MAX_AGE_SECONDS = 180
    IDLE_SECONDS = 60
    # This is a single background reader, never an HTTP request or a pool lease.
    # A bounded longer pass can finish instead of restarting the same large sort.
    QUERY_SECONDS = 60
    QUERY_GAP_SECONDS = 1
    CPU_DUTY = 0.25
    MAX_ENTRIES = 8
    DEFAULT_KEY = ('rolling', 86400.0)

    def __init__(self, db, clock=time.monotonic, cache=None):
        self.db, self.clock = db, clock
        self.cache = cache if cache is not None else SharedCache(8 << 20)
        self.condition = threading.Condition()
        self.stop = threading.Event()
        self.thread = None
        self.connection = None
        self.generation = db.network_generation
        self.entries = OrderedDict()
        self.last_finished = float('-inf')
        self.next_refresh = float('-inf')
        self.entries[self.DEFAULT_KEY] = self._entry(prewarm=True)

    def _entry(self, prewarm=False):
        return dict(result=None, error='', used=self.clock(), due=0.0,
                    completed=0.0, running=False, failures=0, requested=False,
                    prewarm=prewarm, failure_at=None)

    def _active(self, entry, stamp):
        return entry['prewarm'] or (entry['requested'] and stamp-entry['used'] <= self.IDLE_SECONDS)

    @staticmethod
    def _first_requested(entry):
        return entry['requested'] and not entry['result'] and not entry['failures']

    def _scheduled_at(self, entry):
        # A newly opened range can get its first result during the refresh cooldown.
        # Refreshes and retries across all ranges share that cooldown.
        due = max(entry['due'], self.last_finished + self.QUERY_GAP_SECONDS)
        if self._first_requested(entry):
            return due
        return max(due, self.next_refresh)

    def _cache_key(self, key):
        return json.dumps(['network', self.generation, key], separators=(',', ':'))

    @staticmethod
    def _key(start, end, rolling):
        if rolling == 'fixed_start':
            return ('since', start)
        if rolling:
            return ('rolling', round(end - start, 3))
        return ('fixed', start, end)

    def _invalidate_locked(self):
        if self.generation != self.db.network_generation:
            self.generation = self.db.network_generation
            self.entries.clear()
            self.entries[self.DEFAULT_KEY] = self._entry()

    def get(self, start, end, rolling=False, push=None):
        """Never runs SQL or waits for a refresh, including on an empty cache."""
        key = self._key(start, end, rolling)
        if push and push[0]:
            key = ('filtered', key, tuple(push[0]), tuple(push[1]))
        with self.condition:
            self._invalidate_locked()
            entry = self.entries.get(key)
            if entry is None:
                if len(self.entries) >= self.MAX_ENTRIES:
                    victim = next(k for k, v in self.entries.items()
                                  if k != self.DEFAULT_KEY and not v['running'])
                    self.entries.pop(victim)
                entry = self.entries[key] = self._entry()
            entry['used'] = self.clock()
            entry['requested'] = True
            self.entries.move_to_end(key)
            self.condition.notify_all()
            snapshot = self.cache.get(self._cache_key(key)) if entry['result'] else None
            if snapshot is None and entry['result']:
                entry.update(result=None, due=0.0)
            stamp = self.clock()
            age = stamp - entry['completed'] if snapshot is not None else None
            available = snapshot is not None
            due = self._scheduled_at(entry)
            refreshing = entry['running'] or stamp >= due
            error = entry['error']
            if self.db.conn is None:
                error = self.db.last_error or '事件库不可用'
            if available:
                status = 'stale' if error or age > self.MAX_AGE_SECONDS else 'refreshing' if refreshing else 'ready'
                result = dict(snapshot)
            else:
                status = 'error' if error else 'pending'
                result = self.db.empty_network(None)
                result.update(range=None, as_of=None, computed_at=None)
            result.update(available=available, status=status, refreshing=refreshing,
                          requested_range=[start, end], refresh_seconds=self.REFRESH_SECONDS,
                          retry_seconds=max(0,due-stamp),age_seconds=age, error=error)
            return result

    def start(self):
        with self.condition:
            if self.thread is not None and self.thread.is_alive():
                return
            self.stop.clear()
            self.thread = threading.Thread(target=self._run, name='network-snapshots', daemon=True)
            self.thread.start()

    def health(self):
        with self.condition:
            self._invalidate_locked()
            stamp = self.clock()
            active = [entry for entry in self.entries.values()
                      if entry['running'] or self._active(entry, stamp)]
            observed = active or [self.entries[self.DEFAULT_KEY]]
            failed = [entry for entry in observed if entry['error']]
            if failed:
                latest = max(failed, key=lambda entry: entry['failure_at'] or 0)
                message = latest['error']
                if len(failed) > 1:
                    message = str(len(failed)) + ' 个统计范围更新失败。' + message
                return dict(state='error', message=message, at=latest['failure_at'])
            if any(entry['result'] and stamp-entry['completed'] <= self.MAX_AGE_SECONDS for entry in active):
                return dict(state='ok', message='已有近期统计结果')
            if not active and observed[0]['result']:
                return dict(state='ok', message='已有统计结果，打开概览时刷新')
            if any(entry['result'] for entry in active):
                return dict(state='warning', message='统计结果更新延迟')
            return dict(state='pending', message='等待首次统计结果')

    def close(self):
        self.stop.set()
        with self.condition:
            if self.connection is not None:
                self.connection.interrupt()
            self.condition.notify_all()
        if self.thread is not None:
            self.thread.join(timeout=5)

    def _compute(self, key, generation):
        if self.db.conn is None:
            raise RuntimeError(self.db.last_error or '事件库不可用')
        push = None
        if key[0] == 'filtered':
            _, key, clauses, args = key
            push = (clauses, args)
        end = now() if key[0] != 'fixed' else key[2]
        start = end - key[1] if key[0] == 'rolling' else key[1]
        from overview_metrics import resolve_bounds
        push=resolve_bounds(push,start,end)
        uri = Path(self.db.path).resolve().as_uri() + '?mode=ro'
        conn = sqlite3.connect(uri, uri=True, timeout=1)
        deadline = time.monotonic() + self.QUERY_SECONDS
        timed_out = [False]

        def cancelled():
            timed_out[0] = time.monotonic() >= deadline
            return timed_out[0] or self.stop.is_set() or generation != self.db.network_generation

        with self.condition:
            self.connection = conn
        try:
            conn.execute('PRAGMA query_only=ON')
            conn.execute('PRAGMA cache_size=-2048')
            conn.set_progress_handler(cancelled, 10000)
            conn.execute('BEGIN')
            analytics = getattr(self.db, 'analytics', None)
            result = analytics.summary(start,end,cancelled,parallel=False) if analytics is not None and not push else None
            if result is None:
                try:
                    result = (EventDB.compute_network_summary(conn,start,end,push=push) if push
                              else EventDB.compute_network_summary(conn,start,end))
                except sqlite3.Error as exc:
                    self.db.note_read_failure(exc)
                    raise
            if cancelled():
                raise sqlite3.OperationalError('interrupted')
            return dict(result, computed_at=now())
        except sqlite3.Error as exc:
            if timed_out[0]:
                raise TimeoutError('网络统计计算超时') from exc
            raise
        finally:
            conn.set_progress_handler(None, 0)
            try:
                conn.rollback()
            finally:
                with self.condition:
                    self.connection = None
                conn.close()

    def _run(self):
        while not self.stop.is_set():
            with self.condition:
                self._invalidate_locked()
                stamp = self.clock()
                active = [(k, v) for k, v in self.entries.items() if self._active(v, stamp)]
                if not active:
                    self.condition.wait()
                    continue
                ready = [(k,v) for k,v in active if self._scheduled_at(v) <= stamp]
                key, entry = (min(ready,key=lambda pair:(not self._first_requested(pair[1]),pair[1]['due'],-pair[1]['used'])) if ready
                              else min(active, key=lambda pair: self._scheduled_at(pair[1])))
                wait = self._scheduled_at(entry) - stamp
                if wait > 0:
                    self.condition.wait(timeout=min(wait, 1))
                    continue
                entry.update(running=True, prewarm=False)
                generation = self.generation
            result, error = None, ''
            cpu_started = time.thread_time()
            try:
                result = self._compute(key, generation)
            except Exception as exc:  # Keep serving the last success while a bounded retry waits.
                error = '网络统计更新失败：' + str(exc)
            cpu_elapsed = time.thread_time() - cpu_started
            with self.condition:
                self.last_finished = self.clock()
                cooldown = cpu_elapsed * (1/self.CPU_DUTY - 1)
                self.next_refresh = max(self.next_refresh, self.last_finished + cooldown)
                self._invalidate_locked()
                if self.stop.is_set():
                    return
                if generation == self.generation and self.entries.get(key) is entry:
                    failures = entry['failures']+1 if error else 0
                    entry.update(running=False, error=error,
                                 failure_at=now() if error else None,
                                 failures=failures,due=self.clock() + (min(60,5*2**min(failures-1,4)) if error else self.REFRESH_SECONDS))
                    if result is not None:
                        self.cache.put(self._cache_key(key), result)
                        entry.update(result=True, completed=self.clock())


MITRE_FIELDS = ('mitre_tactic_id', 'mitre_technique_id', 'mitre_tactic_name', 'mitre_technique_name')
BASE_EVENT_TYPES = ('alert', 'drop', 'dns', 'http', 'tls', 'anomaly', 'fileinfo', 'flow', 'session')


def attack_metadata(obj):
    if not isinstance(obj, dict):
        return {}
    from snort_engine import native_event
    obj = native_event(obj)
    alert = obj.get('alert')
    metadata = alert.get('metadata') if isinstance(alert, dict) else None
    if not isinstance(metadata, dict):
        return {}
    result = {}
    for key in MITRE_FIELDS:
        raw = metadata.get(key)
        values = raw if isinstance(raw, list) else [raw]
        normalized = []
        for value in values:
            if not isinstance(value, str):
                continue
            parts = re.split(r'[\s,;|]+', value) if key.endswith('_id') else [value]
            for part in parts:
                part = part.strip()
                if key.endswith('_id'):
                    part = part.upper()
                    pattern = r'TA[0-9]{4}' if key == 'mitre_tactic_id' else r'T[0-9]{4}(?:\.[0-9]{3})?'
                    if not re.fullmatch(pattern, part):
                        continue
                if part and part not in normalized:
                    normalized.append(part)
        if normalized:
            result[key] = normalized
    return result


class EventStore:
    def __init__(self, path, maxlen=30000, initial_tail=32 << 20, detail_max=None,
                 offset_cap=800000, memory_budget=None):
        self.path = path
        self.maxlen = maxlen
        self.initial_tail = initial_tail
        self.detail_max = detail_max or maxlen
        self.lock = threading.Lock()
        self.events = deque(maxlen=maxlen)
        # 告警/拦截单独留一份，避免海量 dns/tls/quic 事件把它挤出缓冲
        self.strong = deque(maxlen=20000)
        self.compact = memory_budget is not None
        self.memory_budget = memory_budget
        self.minute_cap = None
        if memory_budget is not None:
            self.events = BoundedRecords(maxlen, memory_budget//2)
            self.strong = BoundedRecords(20000, memory_budget//4)
            offset_cap = min(offset_cap, max(1,memory_budget//16//8))
            self.minute_cap = max(1,memory_budget//16//512)
        # id -> 文件偏移（8 字节/条，独立于明细字典），用于回读任意历史事件
        self.offsets = array.array("Q")
        self.offset_base = 1
        self.offset_cap = offset_cap
        self.minute_index = {}      # 分钟 -> 该分钟第一条的字节偏移
        self.db = None
        self.next_id = 1
        self.offset = 0
        self.ino = None
        self.buf = b""
        self.last_ingest = 0.0
        self.pending = False
        self.worker_pids = set()
        self.buckets = {}          # minute -> [alerts, drops]
        self._series_cache = None  # 事件库分钟聚合的短缓存：(start, boundary), ts, rows
        self.last_error = ""

    # -- 解析单行 -------------------------------------------------------
    @staticmethod
    def _parse(line):
        try:
            from snort_engine import native_event
            obj = native_event(json.loads(line))
        except Exception:
            return None
        etype = obj.get("event_type")
        if etype not in BASE_EVENT_TYPES \
                and etype not in APP_EVENT_TYPES:
            return None
        ts = parse_ts(obj.get("timestamp"))
        if not ts:
            return None
        alert = obj.get("alert") or {}
        drop = obj.get("drop") or {}
        reason = drop.get("reason") or ""
        sig = ""
        cat = ""
        sev = 0
        action = ""
        if etype in ("alert", "drop"):
            sig = alert.get("signature") or (("engine drop: " + reason) if reason else "engine drop")
            cat = alert.get("category") or ""
            action = alert.get("action") or ("blocked" if etype == "drop" else "allowed")
            try:
                sev = int(alert.get("severity")) if alert.get("severity") else 0
            except Exception:
                sev = 0
        elif etype == "dns":
            dns = obj.get("dns") or {}
            queries = dns.get("queries") or []
            name = queries[0].get("rrname") if queries else dns.get("rrname")
            rrtype = queries[0].get("rrtype") if queries else dns.get("rrtype")
            if dns.get("type") == "response":
                answers = dns.get("answers") or []
                answer = answers[0].get("rrname") if answers else ""
                sig = "DNS answer %s %s" % (name or "?", answer or dns.get("rcode") or "")
            else:
                sig = "DNS %s %s" % (name or "?", rrtype or "")
        elif etype == "http":
            http = obj.get("http") or {}
            sig = "HTTP %s %s%s" % (http.get("http_method") or "", http.get("hostname") or "",
                                    http.get("url") or "")
            if http.get("status"):
                sig += " -> %s" % http.get("status")
        elif etype == "tls":
            tls = obj.get("tls") or {}
            sig = "TLS %s %s" % (tls.get("sni") or tls.get("subject") or "?", tls.get("version") or "")
        elif etype == 'session':
            labels={'start':'发起连接','first_observed':'首次观察','state':'连接状态变化',
                    'application':'应用识别更新','update':'流量更新','end':'跟踪结束'}
            native=obj.get('snort_native') or {}
            sig=labels.get(native.get('session_event'),'会话事件')
