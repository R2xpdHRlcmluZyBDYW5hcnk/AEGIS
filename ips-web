SOURCE_NAME_RE = re.compile(r"^[a-z0-9][a-z0-9./_-]*$")
_ANSI_CODES = re.compile(r"\x1b\[[0-9;]*m")


def parse_source_catalog(text):
    """解析 ips-snort-rules list-sources 输出（含 ANSI 颜色码）为规则源目录"""
    catalog = []
    current = None
    for raw in text.splitlines():
        line = _ANSI_CODES.sub("", raw).strip()
        if not line:
            continue
        if line.startswith("Name:"):
            current = {"name": line[5:].strip(), "vendor": "", "summary": "",
                       "license": "", "subscribed": False, "enabled": False}
            catalog.append(current)
        elif current is not None:
            if line.startswith("Vendor:"):
                current["vendor"] = line[7:].strip()
            elif line.startswith("Summary:"):
                current["summary"] = line[8:].strip()
            elif line.startswith("License:"):
                current["license"] = line[8:].strip()
            elif line.startswith("Parameters:") and "secret-code" in line:
                # 需要订阅码的商业源，UI 只展示不提供启用
                current["subscribed"] = True
    return catalog


def parse_enabled_sources(text):
    """解析 ips-snort-rules list-enabled-sources 输出"""
    enabled = set()
    for raw in text.splitlines():
        line = _ANSI_CODES.sub("", raw).strip()
        if line.startswith("- "):
            enabled.add(line[2:].strip())
    return enabled


# 规则文件索引（规则页搜索用）：msg/sid 提取 + classtype 可选
_RULE_LINE = re.compile(r'^(alert|block|drop|reject|pass)\s+\S+\s+.*?\(.*?\bmsg\s*:\s*"((?:\\.|[^"\\])*)".*?\bsid\s*:\s*(\d+)\s*;')
_RULE_CLASS = re.compile(r"classtype:([a-zA-Z0-9_-]+)")
_RULE_MESSAGE = re.compile(r'\bmsg\s*:\s*"((?:\\.|[^"\\])*)"')
