    @catalog_read
    def rules_index(self):
        """Read compiled and console-owned rule files, including custom rules without msg."""
        paths = [(RULES_FILE, None), (LOCAL_RULES, "本地规则"),
                 (HUNT_RULES, "手动规则"), (BAN_RULES, "封禁规则")]
        key = []
        for path, source in paths:
            try:
                info = os.stat(path)
                key.append((path, info.st_ino, info.st_mtime_ns, info.st_size))
            except OSError:
                continue
        builtins = builtin_catalog(SNORT_CONF)
        discovered=managed_rule_files()
        for path in discovered:
            try:
                info=path.stat();key.append((str(path),info.st_ino,info.st_mtime_ns,info.st_size))
            except OSError:continue
        key.append(('builtin', tuple(builtins)))
        rule_group_catalog()
        key.append(('catalog',tuple(_GROUP_CACHE.get('key') or ())))
        cached = getattr(self, "_rules_index_cache", None)
        if cached and cached[0] == key:
            return cached[1]
        by_sid = {}
        for path, source in paths:
            try:
                for _,records in RULE_INVENTORY.read(path):
                    for record in records:
                        if not record.enabled:continue
                        line,gid,value=record.line,record.gid,record.token
                        if value in by_sid:
                            continue
                        category = _RULE_CLASS.search(line)
                        msg = record.message
                        by_sid[value] = dict(gid=gid, sid=record.sid, msg=msg, action=record.action,policy_managed=source is None,
                            classtype=category.group(1) if category else "", line=line,
                            search_text=line.casefold(), msg_lower=msg.lower(), enabled=True,
                            origins=[dict(source=source, group=os.path.basename(path))] if source else [])
            except OSError:
                continue
        rule_group_catalog()
        for token,row in _GROUP_CACHE.get('rule_records',{}).items():
            by_sid.setdefault(token,row)
        by_sid.update({token:_GROUP_CACHE.get('rule_records',{}).get(token,record) for token,record in builtins.items()})
        index = {'rules': [signature_row(row) for row in by_sid.values()], 'by_sid': by_sid}
        index['ordered']=sorted(index['rules'],key=lambda r:(r.get('gid',1),r['sid']),reverse=True)
        hidden=hidden_source_signatures()
        index['visible_ordered']=[row for row in index['ordered'] if signature_key(row['sid'],row.get('gid',1)) not in hidden]
        self._rules_index_cache = (key, index)
        return index if key[:-1] or builtins else None

    @catalog_read
    def rule_selection(self, selector, source=None, query="", offset=0, limit=50):
        """Resolve saved selectors against compiled, cached and custom rules, read-only."""
        selector = canonical_selector(selector)
        kind, _, code = selector.partition(":")
        if kind not in ("sid", "group","group-source", "msg", "re", "ban") or not code or len(selector) > 2000:
            raise ValueError("无效规则范围")
        index = self.rules_index() or {"rules": [], "by_sid": {}}
        rule_group_catalog()
        candidates = dict(_GROUP_CACHE.get("rule_records", {}))
        candidates.update(index["by_sid"])
        if kind in ("group","group-source"):
            selected,_pattern=parse_group(selector)
            if selected is not None:
                if source is not None and source!=selected:raise ValueError('规则分组来源不一致')
                source=selected
            names = {row["name"] for row in rule_group_catalog()
                     if group_matches(selector,row['name'],row['source']) and (source is None or row["source"] == source)}
            members = {signature_key(row['sid'], row.get('gid',1)): row for name in sorted(names) for row in _rule_group_rows(name, source)[0]}
            rows = [dict(candidates.get(sid, {}), **row) for sid, row in members.items()]
        elif kind == "sid":
            token = signature_key(code)
            rows = [candidates[token]] if token in candidates else []
        elif kind == "ban":
            if not any(row.get("value") == code for row in RuleBook.bans()):
                rows = []
            else:
                selected, ids = False, set()
                for line in RuleBook._render_rules(RuleBook.bans()).splitlines():
                    if line.startswith(("# ip ", "# domain ")):
                        selected = line.split(" ", 2)[2] == code
                    if selected and (match := re.search(r"\bsid:(\d+);", line)):
                        ids.add(int(match.group(1)))
                rows = [row for sid, row in index["by_sid"].items() if sid in ids]
        elif kind == "msg":
            prefix = code[:-1] if code.endswith("*") else code
            rows = [row for row in candidates.values() if row["msg"].startswith(prefix)]
        else:
            try:
                pattern = re.compile(code)
            except re.error as exc:
                raise ValueError("无效正则表达式：" + str(exc)) from exc
            rows = [row for row in candidates.values() if pattern.search(row.get("line", ""))]
        needle = str(query).strip().casefold()
        rows = sorted((row for row in rows if not needle or needle in
                       (str(row["sid"]) + " " + row.get("msg", "") + " " + row.get("line", "")).casefold()),
                      key=lambda row: signature_identity(row['sid'],row.get('gid',1)))
        offset, limit = max(0, int(offset)), max(1, min(200, int(limit)))
        return dict(selector=selector, rules=rules_with_origins(rows[offset:offset+limit]),
                    total=len(rows), offset=offset, limit=limit)

    @catalog_read
    def rules_search(self, query, limit=50, offset=0, browse=False, exclude="", include="", include_groups=True):
        """Search the complete catalog; page results without truncating the total."""
        q = (query or "").strip()
        if exclude not in ("", "disable", "action", "suppress"):
            return {"error": "无效操作类型", "total": 0, "rules": [], "groups": []}
        configured = configured_selectors(exclude) if exclude else set()
        included = canonical_selector(include) if include else ""
        def available(value):
            if not configured:return True
            if value.startswith('sid:'):return value==included or value not in configured
            return canonical_selector(value) == included or not selector_configured(value, configured)
        def manageable(row):
            if exclude=='disable': return row.get('builtin') or row.get('policy_managed') is not False
            if exclude=='action': return not row.get('builtin') and row.get('policy_managed') is not False
            return True
        limit, offset = max(1, min(200, int(limit))), max(0, int(offset))
        index = self.rules_index()
        if index is None:
            return {"error": "规则文件不可读", "total": 0, "rules": [], "groups": rule_groups()}
        hidden=hidden_source_signatures()
        def visible(row):
            return signature_key(row['sid'],row.get('gid',1)) not in hidden
        if not q:
            if 'ordered' not in index:index['ordered']=sorted(index['rules'],key=lambda r:signature_identity(r['sid'],r.get('gid',1)),reverse=True)
            if not configured and not exclude:
                ordered=index.get('visible_ordered')
                if ordered is None:ordered=[row for row in index['ordered'] if visible(row)]
            else:
                ordered = [row for row in index['ordered'] if visible(row) and available(row.get('selector') or signature_selector(row['sid'],row.get('gid',1))) and manageable(row)]
            if not browse:
                ordered = ordered[:20]
            if not include_groups:return dict(total=len(ordered),rules=rules_with_origins(ordered[offset:offset+limit]),offset=offset,limit=limit)
            restricted_groups={row['name'] for row in rule_group_catalog() if not manageable(row)}
            groups = [name for name in rule_groups() if available('group:'+name) and name not in restricted_groups]
            return {"total": len(ordered), "rules": rules_with_origins(ordered[offset:offset + limit]),
                    "group_rows":[row for row in rule_group_catalog() if manageable(row) and row.get('source_enabled') is not False and available(row.get('selector') or group_selector(row['name'],row['source']))],
                    "groups": groups, "group_labels": {row["name"]: row["label"] for row in _GROUP_CACHE["rows"] if row["name"] in groups},
                    "group_search": {name: " ".join(" ".join(str(row.get(field, "")) for field in ("name", "label", "source"))
                                                   for row in _GROUP_CACHE["rows"] if row["name"] == name) for name in groups},
                    "offset": offset, "limit": limit}
        exact_sid = q.lower().startswith("sid:")
        if exact_sid:
            q = q[4:].strip()
        if exact_sid and re.fullmatch(r'[0-9]+(?::[0-9]+)?', q):
            hit = index['by_sid'].get(signature_key(q))
            rows = [hit] if hit else []
        else:
            needle = q.casefold()
            catalog = rule_group_catalog()
            matching_origins = {(row["name"], row["source"]) for row in catalog
                                if any(needle in str(row.get(field, "")).casefold()
                                       for field in ("name", "label", "source"))}
            origin_sids = {sid for sid, origins in _GROUP_CACHE.get("origins", {}).items()
                           if any((origin["group"], origin["source"]) in matching_origins for origin in origins)}
            rows = [r for r in index['rules'] if signature_key(r['sid'],r.get('gid',1)) in origin_sids
                    or needle in r.get("search_text", "")
                    or any(needle in str(r.get(field, "")).casefold() for field in ("sid", "msg", "action", "classtype"))]
        rows = [row for row in rows if visible(row) and available(signature_selector(row['sid'],row.get('gid',1))) and manageable(row)]
        return {"total": len(rows), "rules": rules_with_origins(rows[offset:offset + limit]),
                "offset": offset, "limit": limit}

