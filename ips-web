    def component_health(self, service, queue, telemetry):
        def item(key, name, state, message, at=None):
            return dict(id=key, name=name, state=state, message=message, at=at)

        components = []
        if service.get('state') in ('failed','inactive') or service.get('pid') == 0:
            engine = ('error', 'Snort 进程未运行')
        elif telemetry.get('updating'):
            engine = ('pending', '规则任务进行中')
        elif service.get('state') != 'active':
            engine = ('pending', '尚未读取进程状态')
        elif telemetry.get('stale') or telemetry.get('error'):
            engine = ('warning', telemetry.get('error') or '引擎采样延迟')
        else:
            engine = ('ok', 'Snort 正在运行')
        components.append(item('engine', '检测引擎', *engine))

        if queue.get('listeners_known'):
            missing = {0,1,2,3} - {entry['id'] for entry in queue['queues']}
            nfqueue = ('error', '缺少监听的队列 ' + ', '.join(map(str, sorted(missing)))) if missing else ('ok', '四个队列均在监听')
        else:
            nfqueue = ('pending', '队列监听状态不可用')
        components.append(item('nfqueue', 'NFQUEUE', *nfqueue, at=queue.get('listeners_at')))

        fault = self.db.read_health.get('fault')
        if self.db.conn is None:
            components.append(item('event-read', '事件库读取', 'error', self.db.last_error or '事件库无法打开'))
        elif fault:
            components.append(item('event-read', '事件库读取', 'error', '检测到结构损坏。' + fault['message'], fault['at']))
        else:
            components.append(item('event-read', '事件库读取', 'ok', '尚未观测到结构性读取错误'))

        lag = self.ingest_lag()
        error = self.db.write_error or self.store.last_error
        if self.db.conn is None or self.db.write_blocked or error:
            ingest = ('error', error or '事件库无法入库')
        elif lag is None:
            ingest = ('warning', '暂时无法读取事件流进度')
        elif lag:
            ingest = ('ok', '正在入库，待处理 ' + str(lag) + ' 字节')
        else:
            ingest = ('ok', '事件流已追平')
        components.append(item('ingest', '事件入库', *ingest))

        if self.analytics.error:
            projection = ('error', self.analytics.error)
        elif self.analytics.ready:
            projection = ('ok', '已生成统计索引')
        else:
            projection = ('pending', '正在生成统计索引')
        components.append(item('projection', '网络统计索引', *projection))
        components.append(dict(id='network', name='网络统计结果', **self.network.health()))
        return components

