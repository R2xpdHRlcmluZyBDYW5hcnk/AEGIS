class RuleUpdateSchedule:
    """Persistent daily/weekly schedule, owned by the rule manager in isolated mode."""
    def __init__(self, sysinfo, path=None):
        self.sys = sysinfo
        self.path = path or RULE_SCHEDULE
        self.lock = threading.RLock()
        self.error = ""
        self.data = dict(enabled=False, frequency="daily", time="04:00", weekday=0,
                         next_run=0, last_run=None)
        try:
            with open(self.path, encoding="utf-8") as fh:
                saved = json.load(fh)
            self.validate(saved)
            if (not isinstance(saved.get("next_run"), (int, float)) or
                    not math.isfinite(saved["next_run"]) or saved["next_run"] < 0 or
                    saved.get("last_run") is not None and not isinstance(saved["last_run"], dict)):
                raise ValueError("定时记录无效")
            self.data.update(saved)
            if self.data.get("last_run", {}) and self.data["last_run"].get("state") == "running":
                self.data["last_run"]["state"] = "interrupted"
        except FileNotFoundError:
            pass
        except (OSError, ValueError, TypeError) as exc:
            self.error = "读取定时设置失败：" + str(exc)
            self.data["enabled"] = False

    @staticmethod
    def validate(value):
        if (not isinstance(value, dict) or type(value.get("enabled")) is not bool or
                value.get("frequency") not in ("daily", "weekly") or
                not isinstance(value.get("time"), str) or
                not re.fullmatch(r"(?:[01][0-9]|2[0-3]):[0-5][0-9]", value["time"]) or
                type(value.get("weekday")) is not int or not 0 <= value["weekday"] <= 6):
            raise ValueError("请选择每天或每周、有效时间和星期")

    @staticmethod
    def next_time(data, stamp):
        local = datetime.fromtimestamp(stamp)
        hour, minute = map(int, data["time"].split(":"))
        candidate = local.replace(hour=hour, minute=minute, second=0, microsecond=0)
        if data["frequency"] == "weekly":
            candidate += timedelta(days=(data["weekday"] - candidate.weekday()) % 7)
        if candidate.timestamp() <= stamp:
            candidate += timedelta(days=7 if data["frequency"] == "weekly" else 1)
        return candidate.timestamp()

    def _save(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        temporary = self.path + ".new"
        try:
            with open(temporary, "w", encoding="utf-8") as fh:
                json.dump(self.data, fh, ensure_ascii=False)
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(temporary, self.path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)

    def status(self):
        with self.lock:
            last = self.data.get("last_run") or {}
            return dict(self.data, timezone=time.strftime("%Z (UTC%z)"), error=self.error,
                        next_run_local=iso(self.data["next_run"]) if self.data["next_run"] else "",
                        last_started_local=iso(last["started"]) if last.get("started") else "")

    def configure(self, value):
        self.validate(value)
        with self.lock:
            previous = dict(self.data)
            self.data.update({key: value[key] for key in ("enabled", "frequency", "time", "weekday")})
            self.data["next_run"] = self.next_time(self.data, now()) if value["enabled"] else 0
            try:
                self._save()
            except OSError:
                self.data = previous
                raise
            self.error = ""
            return dict(ok=True, **self.status())

    def finished(self, job):
        with self.lock:
            self.data["last_run"] = {key: job.get(key) for key in ("state", "started", "finished", "rc")}
            self.data["last_run"]["lines"] = list(job["lines"])[-80:]
            try:
                self._save()
                self.error = ""
            except OSError as exc:
                self.error = "保存定时更新结果失败：" + str(exc)
                raise

    def tick(self):
        with self.lock:
            stamp = now()
            if not self.data["enabled"] or stamp < self.data["next_run"]:
                return
            # Leave overdue work pending while a manual update/application runs.
            if self.sys.update_status()["state"] == "running":
                return
            previous = dict(self.data)
            self.data["next_run"] = self.next_time(self.data, stamp)
            self.data["last_run"] = dict(state="running", started=stamp, finished=0, rc=None)
            try:
                self._save()  # Reserve before launch so a console restart cannot launch twice.
                self.error = ""
                result = self.sys.update_rules(on_complete=self.finished, trigger="scheduled")
            except Exception:
                self.data = previous
                raise
            if not result["ok"]:  # Manual job won the race; retry after it finishes.
                self.data = previous
                self._save()

    def run(self, stop):
        while not stop.is_set():
            try:
                self.tick()
            except Exception as exc:
                self.error = "定时更新失败：" + str(exc)
                sys.stderr.write(self.error + "\n")
            stop.wait(15)


class SysInfo:
    def telemetry(self):
        return {}

    def __init__(self):
        self.lock = threading.Lock()
        self.cache = {}
        self.prev = {}
        self.engine = Snort(ENGINE_SOCKET)
        self.reload_job = {"state": "idle", "last": "", "since": ""}
        self.rule_job = {"state": "idle", "started": 0, "finished": 0, "lines": deque(maxlen=300)}

    def cached(self, key, ttl, fn):
        with self.lock:
            hit = self.cache.get(key)
            if hit and now() - hit[0] < ttl:
                return hit[1]
        value = fn()
        with self.lock:
            self.cache[key] = (now(), value)
        return value

    @staticmethod
    def run(cmd, timeout=8):
        try:
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
            return proc.returncode, proc.stdout, proc.stderr
        except Exception as exc:  # noqa: BLE001
            return 1, "", str(exc)

    # -- Snort control -----------------------------------------------------
    def sc(self, command, ttl=3.0):
        def fetch():
            data = self.engine.call([command])
            if command in data:
                return {"ok": True, "message": data[command]}
            return {"ok": False, "error": data.get("__error__", "snort socket unavailable")}
        return self.cached("sc:" + command, ttl, fetch)

    def engine_meta(self):
        def fetch():
            data = self.engine.call(["version", "uptime", "running-mode", "capture-mode",
                                   "ruleset-reload-time"], timeout=6)
            return {
                "version": data.get("version"),
                "uptime": data.get("uptime") if data.get('uptime') is not None else self.service().get('uptime'),
                "running_mode": data.get("running-mode"),
                "capture_mode": data.get("capture-mode"),
                "reload_time_ms": _last_reload(data.get("ruleset-reload-time")),
                'error':data.get('__error__',''),
            }
        return self.cached("meta", 20.0, fetch)

    def counters(self):
        res = self.sc("dump-counters", ttl=4.0)
        return res.get("message", {}) if res.get("ok") else {}

    def ruleset(self):
        res = self.sc("ruleset-stats", ttl=8.0)
        if res.get("ok"):
            msg = res.get("message")
            if isinstance(msg, list) and msg:
                return msg[0]
            if isinstance(msg, dict):
                return msg
        return dict(error=res.get('error','无法读取引擎规则状态'),rules_loaded=None,rules_failed=None,rules_skipped=None)

    # -- 服务状态 -------------------------------------------------------
    def service(self):
        """ips.service 的状态 + snort 进程自身的资源占用"""
        def fetch():
            unit = {}
            rc, out, _ = self.run([
                "systemctl", "show", "ips", "--property",
                "ActiveState,SubState,NRestarts,ActiveEnterTimestamp",
            ], timeout=5)
            for line in out.splitlines():
                if "=" in line:
                    key, _, val = line.partition("=")
                    unit[key] = val

            pid = 0
            try:
                with open("/run/snort/snort.pid", encoding="utf-8") as fh:
                    pid = int(fh.read().strip())
            except (OSError, ValueError):
                pid = 0
            if pid and not os.path.isdir("/proc/%d" % pid):
                pid = 0

            uptime = None
            cpu_seconds = None
            memory = None
            if pid:
                try:
                    with open("/proc/%d/stat" % pid, encoding="utf-8") as fh:
                        fields = fh.read().rsplit(")", 1)[1].split()
                    utime, stime = int(fields[11]), int(fields[12])
                    starttime = int(fields[19])
                    hz = os.sysconf("SC_CLK_TCK")
                    with open("/proc/uptime", encoding="utf-8") as fh:
                        boot = float(fh.read().split()[0])
                    uptime = int(max(0.0, boot - starttime / float(hz)))
                    cpu_seconds = round((utime + stime) / float(hz), 1)
                except (OSError, ValueError, IndexError):
                    pass
                try:
                    with open("/proc/%d/status" % pid, encoding="utf-8") as fh:
                        for line in fh:
                            if line.startswith("VmRSS:"):
                                memory = int(line.split()[1]) * 1024
                                break
                except (OSError, ValueError):
                    pass

            return {
                "state": unit.get("ActiveState", "unknown"),
                "sub": unit.get("SubState", ""),
                "pid": pid,
                "uptime": uptime,
                "memory": memory,
                "cpu_seconds": cpu_seconds,
                "restarts": int(unit.get("NRestarts") or 0),
                "since": unit.get("ActiveEnterTimestamp", ""),
            }
        return self.cached("service", 4.0, fetch)

    # -- NFQUEUE 队列 ---------------------------------------------------
    @staticmethod
    def _nft_queue_counter():
        """读 nft 队列规则的 counter —— 真正进过 NFQUEUE 的包/字节数"""
        data = nft_query_table("inet", "ips")
        if not data:
            return None
        for obj in data.get("nftables", []):
            rule = obj.get("rule")
            if not rule:
                continue
            exprs = rule.get("expr") or []
            if not any("queue" in expr for expr in exprs):
                continue
            for expr in exprs:
                if "counter" in expr:
                    counter = expr["counter"]
                    return (counter.get("packets"), counter.get("bytes"))
        return None

    @staticmethod
    def _queue_listeners():
        queues, total, drops = [], 0, 0
        try:
            with open("/proc/net/netfilter/nfnetlink_queue", encoding="utf-8") as fh:
                for line in fh:
                    cols = line.split()
                    if len(cols) >= 6 and cols[0] in ("0", "1", "2", "3") and int(cols[1]):
                        backlog = int(cols[2])
                        total += backlog
                        drops += int(cols[5])
                        queues.append({"id": int(cols[0]), "backlog": backlog})
        except (OSError, ValueError):
            return None
        return dict(queues=queues, count=len(queues), queue_total=total, kernel_drops=drops,
                    listeners_known=True, listeners_at=now())

    def queue(self):
        def fetch():
            info = {"packets": None, "bytes": None, "kernel_drops": 0, "queue_total": 0,
                    "queues": [], "listeners_known": False, "ts": now()}
            # nft 的 counter 是唯一准确的“入队字节”：Snort 的 decoder.bytes 在
            # NFQ+GSO 下会把 GSO 报文重复计数（实测约 2.5 倍），不能用来算吞吐
            counter = self._nft_queue_counter()
            if counter:
                info["packets"], info["bytes"] = counter
            else:
                counters = self.counters()
                info["packets"] = (counters.get("decoder") or {}).get("pkts")
                info["bytes"] = (counters.get("decoder") or {}).get("bytes")
            listeners = self._queue_listeners()
            if listeners and now() - listeners['listeners_at'] <= 10:
                info.update(listeners)
            return info
        return self.cached("queue", 1.0, fetch)

    # -- 速率（dump-counters 采样）------------------------------------
    def stats(self):
        counters = self.counters()
        return {
            "packets": (counters.get("decoder") or {}).get("pkts")
                       or (counters.get("capture") or {}).get("kernel_packets"),
            "bytes": (counters.get("decoder") or {}).get("bytes"),
            "flows": (counters.get("flow") or {}).get("total"),
        }

    def rates(self):
        queue = self.queue()
        stamp = queue.get("ts") or now()
        values = {"packets": queue.get("packets"), "bytes": queue.get("bytes"), "ts": stamp}
        rates = {"pps": 0.0, "mbps": 0.0, "fps": 0.0}
        prev = self.prev.get("rates")
        if prev and values.get("packets") is not None and prev[1].get("packets") is not None:
            # 用采样时间戳算间隔：queue() 有 3s 缓存，用墙钟会把同一个样本算两次
            elapsed = stamp - (prev[1].get("ts") or 0)
            if elapsed >= 0.5:
                dp = values["packets"] - prev[1]["packets"]
                db = (values.get("bytes") or 0) - (prev[1].get("bytes") or 0)
                if dp >= 0:
                    rates["pps"] = round(dp / elapsed, 1)
                if db >= 0:
                    rates["mbps"] = round(db * 8.0 / elapsed / 1e6, 2)
        self.prev["rates"] = (stamp, values)
        self.latest_rates = rates
        return rates

    def current_rates(self):
        """后台采样线程算好的最近一次速率，API 只读这个，避免多客户端互相切碎间隔"""
        return dict(getattr(self, "latest_rates", {"pps": 0.0, "mbps": 0.0, "fps": 0.0}))

    def sampler(self, stop=None, after_sample=None):
        stop=stop if stop is not None else threading.Event()
        while not stop.is_set():
            try:
                self.rates()
                if after_sample is not None:
                    after_sample()
            except Exception:  # noqa: BLE001
                pass
            stop.wait(2)

    # -- 规则重载状态（本进程跟踪，不读日志）---------------------------
    def reload_state(self):
        job = self.reload_job
        if job.get("state") == "running":
            return {"state": "running", "since": job.get("since", "")}
        return {"state": "idle", "last": job.get("last", "")}

    # -- 磁盘 / 日志 ----------------------------------------------------
    def storage(self):
        out = {"disk": {}, "logs": []}
        try:
            usage = shutil.disk_usage(str(Path(EVE).parent))
            out["disk"] = {"total": usage.total, "used": usage.used, "free": usage.free}
        except OSError:
            pass
        paths = [EVE, *glob.glob(str(NATIVE_LOGS / '*file_connector_ndr_transmit')),
                 *glob.glob(str(NATIVE_LOGS / '*alert_json.txt'))]
        for path in paths[:128]:
            name = os.path.basename(path)
            try:
                st = os.stat(path)
                out["logs"].append({"name": name, "size": st.st_size,
                                    "mtime": int(st.st_mtime)})
            except OSError:
                pass
        return out

    def log_tail(self, name="snort.log", lines=40):
        path = os.path.join(str(NATIVE_LOGS), name)
        try:
            with open(path, "rb") as fh:
                fh.seek(max(0, os.path.getsize(path) - 32 * 1024))
                data = fh.read().decode("utf-8", "replace").splitlines()
            return data[-lines:]
        except OSError as exc:
            return [str(exc)]

    # -- 动作 -----------------------------------------------------------
    def reload_rules(self):
        with self.lock:
            if self.reload_job.get("state") == "running":
                return {"ok": False, "output": "reload already running"}
            self.reload_job = {"state": "running",
                               "since": time.strftime("%Y-%m-%d %H:%M:%S")}

        def worker():
            try:
                prepare_thresholds()
                data = self.engine.call(["ruleset-reload-rules"], timeout=300)
            except Exception as exc:
                data = {"__error__": str(exc)}
            with self.lock:
                self.reload_job = {
                    "state": "idle",
                    "last": time.strftime("%Y-%m-%d %H:%M:%S"),
                    "ok": "ruleset-reload-rules" in data,
                    "error": data.get("__error__", ""),
                }
                self.cache.pop("sc:ruleset-stats", None)

        threading.Thread(target=worker, daemon=True).start()
        return {"ok": True, "output": "reload started"}

    def update_rules(self, offline=False, on_complete=None, trigger="manual"):
        with self.lock:
            if self.rule_job["state"] == "running":
                return {"ok": False, "error": "already running"}
            job = {"state": "running", "kind": "apply" if offline else "update", "trigger": trigger, "started": now(), "finished": 0,
                   "lines": deque(maxlen=300)}
            self.rule_job = job

        def worker():
            try:
                command = [RULE_UPDATER, "--no-reload"]
                if offline:
                    command.append("--offline")
                proc = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=480)
                job["lines"].extend(proc.stdout.splitlines()[-300:])
                if proc.returncode:
                    raise RuntimeError("规则更新失败")
                prepare_thresholds()
                from session_logger import plugin_arguments
                subprocess.run(["/opt/ips-snort3/3.12.4.0/bin/snort", *plugin_arguments(), "-T", "-c", SNORT_CONF], check=True, timeout=300)
                result = self.engine.call(["ruleset-reload-rules"], timeout=300)
                if "ruleset-reload-rules" not in result:
                    raise RuntimeError(result.get("__error__", "规则重载失败"))
                job["rc"] = 0
            except Exception as exc:  # noqa: BLE001
                job["lines"].append("error: " + str(exc))
                job["rc"] = 1
            finally:
                job["state"] = "done"
                job["finished"] = now()
                with self.lock:
                    self.cache.pop("sc:ruleset-stats", None)
                if on_complete:
                    try:
                        on_complete(job)
                    except Exception as exc:
                        sys.stderr.write("Save scheduled update result failed: %s\n" % exc)

        threading.Thread(target=worker, daemon=True).start()
        return {"ok": True}

    def update_status(self):
        job = self.rule_job
        return {
            "state": job["state"],
            "started": job["started"],
            "finished": job["finished"],
            "rc": job.get("rc"),
            "kind": job.get("kind", "update"),
            "trigger": job.get("trigger", "manual"),
            "lines": list(job["lines"])[-80:],
        }


