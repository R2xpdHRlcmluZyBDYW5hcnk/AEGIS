def flow_summary(application, protocol, state, reason, signature=''):
    """Format derived flow labels without changing protocol or state evidence."""
    application, protocol, state, reason = (str(value or '').strip() for value in
                                             (application, protocol, state, reason))
    failed = application.lower() == 'failed'
    label = ('连接 ' + ((protocol if failed else application) or protocol)).strip()
    signature = str(signature or '')
    details = ''
    # Historical generated labels may contain the only surviving state or counters.
    legacy = re.match(r'^连接\s+(new|established|closed|bypassed)(?:\s*\u00b7\s*(.*))?$', signature, re.I)
    if legacy is None:
        legacy = re.match(r'^连接\s+.*?\s*\u00b7\s*(new|established|closed|bypassed)(?:\s*\u00b7\s*(.*))?$', signature, re.I)
    if legacy:
        state = state or legacy[1]
        details = re.sub(r'\s*\u00b7\s*', ' ', legacy[2] or '').strip()
    else:
        bracket = re.match(r'^连接.*?\s+\[\s*([^\]]+?)\s*\](?:\s+(.*))?$', signature)
        if bracket:
            state = state or bracket[1]
            details = bracket[2] or ''
            if failed:
                details = details.removeprefix('应用协议识别失败').strip()
    if state:
        label += ' [ %s ]' % state
    if failed:
        label += ' 应用协议识别失败'
    if not state and reason:
        label += ' 结束原因：' + reason
    if details:
        label += ' ' + details
    return label


FLOW_SIG_SQL = "(CASE WHEN type='flow' THEN flow_summary(app,proto,state,reason,sig) ELSE sig END)"


def list_record(record, identity=None, network=False):
    fields = LIST_FIELDS+('sni','dns') if network else LIST_FIELDS
    result = {key: record[key] for key in fields if key in record}
    result['sig'] = (record.get('sig') or record.get('sni') or record.get('dns')
                     or record.get('host') or record.get('reason') or record.get('type') or '')
    if record.get('type') == 'flow':
        result['sig'] = flow_summary(*(record.get(key) for key in ('app','proto','state','reason','sig')))
    if identity is not None:
        result['record_id'] = identity
    return result


def tuple_hash(src, sport, dst, dport, proto):
    """Bidirectional five-tuple key, kept separate from actual Community IDs."""
    try:
        protocol = str(proto or '').strip().upper()
        protocol = {'TCP':'6','UDP':'17','SCTP':'132','ICMP':'1','IPV6-ICMP':'58'}.get(protocol,protocol)
        if not protocol or sport is None or dport is None or sport=='' or dport=='':
            return None
        source, destination = ip_address(str(src)), ip_address(str(dst))
        if source.version != destination.version:
            return None
        if protocol.isdigit():
            protocol = str(int(protocol))
            if not 0 <= int(protocol) <= 255:
                return None
        endpoints = [(source.packed.hex(),int(sport)),
                     (destination.packed.hex(),int(dport))]
        if any(not 0<=port<=65535 for _,port in endpoints):
            return None
        payload = json.dumps([protocol,sorted(endpoints)],separators=(',',':'))
        return hashlib.sha256(payload.encode()).hexdigest()
    except (ValueError,TypeError):
        return None


def flow_identifier(value):
    try:
        number = int(value)
        return number if 0<number<=9223372036854775807 else None
    except (TypeError,ValueError,OverflowError):
        return None


def object_bytes(value):
    """Conservative per-entry accounting; shared strings may be counted twice."""
    seen = set()
    def size(item):
        if id(item) in seen:
            return 0
        seen.add(id(item))
        total = sys.getsizeof(item)
        if isinstance(item, dict):
            total += sum(size(k) + size(v) for k, v in item.items())
        elif isinstance(item, (tuple, list, deque)):
            total += sum(size(v) for v in item)
        return total
    return size(value)


class SharedCache:
    """Byte-budgeted LRU of encoded responses, shared by all data providers."""
    def __init__(self, limit):
        self.limit = max(0, int(limit))
        self.target = self.limit
        self.entries = OrderedDict()
        self.resident = set()
        self.bytes = 0
        self.lock = threading.RLock()

    @staticmethod
    def budget(config):
        fixed = config.get('preload_memory_mib')
        if fixed is not None:
            return max(1, min(1024, int(fixed))) * (1 << 20)
        percent = min(10.0, max(0.1, float(config.get('cache_memory_percent', 2))))
        ceiling = max(1, min(1024, int(config.get('cache_max_mib', 128)))) * (1 << 20)
        try:
            physical = os.sysconf('SC_PHYS_PAGES') * os.sysconf('SC_PAGE_SIZE')
        except (AttributeError, ValueError, OSError):
            physical = None
        return min(ceiling, int(physical * percent / 100)) if physical else ceiling

    def _trim(self):
        while self.entries and self.bytes + sys.getsizeof(self.entries) > self.target:
            key = next((key for key in self.entries if key not in self.resident), None)
            if key is None:
                key = next(iter(self.entries))
            _, _, weight = self.entries.pop(key)
            self.resident.discard(key)
            self.bytes -= weight

    def get(self, key, max_age=None):
        with self.lock:
            entry = self.entries.get(key)
            if entry is None or (max_age is not None and time.monotonic()-entry[1] > max_age):
                return None
            self.entries.move_to_end(key)
            payload = entry[0]
        return json.loads(payload)

    def put(self, key, value, resident=False):
        payload = json.dumps(value, ensure_ascii=False, separators=(',', ':'), default=str).encode('utf-8')
        weight = sys.getsizeof(payload) + object_bytes(key) + 128
        with self.lock:
            if weight > min(self.target // 2, 1 << 20):
                return False
            old = self.entries.pop(key, None)
            if old:
                self.bytes -= old[2]
            self.entries[key] = (payload, time.monotonic(), weight)
            if resident:
                self.resident.add(key)
            self.bytes += weight
            self._trim()
            return key in self.entries

    def clear(self):
        with self.lock:
            self.entries.clear()
            self.resident.clear()
            self.bytes = 0

    def pressure(self):
        try:
            values = {k: int(v.split()[0]) for line in Path('/proc/meminfo').read_text().splitlines()
                      for k, v in [line.split(':', 1)]}
            ratio = values['MemAvailable'] / values['MemTotal']
        except (OSError, ValueError, KeyError):
            return
        with self.lock:
            if ratio < .1:
                self.target = self.limit // 2
            elif ratio > .2:
                self.target = self.limit
            self._trim()

    def stats(self):
        with self.lock:
            return dict(limit_bytes=self.limit, target_bytes=self.target,
                        used_bytes=self.bytes + sys.getsizeof(self.entries), entries=len(self.entries),
                        resident_entries=len(self.resident),
                        resident_bytes=sum(self.entries[key][2] for key in self.resident))


class BoundedRecords(deque):
    def __init__(self, maxlen, budget):
        super().__init__(maxlen=maxlen)
        self.budget, self.bytes, self.weights = budget, 0, deque()

    def append(self, value):
        if self.maxlen == 0:
            return
        weight = object_bytes(value) + 64
        if weight > self.budget:
            return
        if len(self) == self.maxlen:
            self.popleft()
        super().append(value)
        self.weights.append(weight)
        self.bytes += weight
        while self.bytes > self.budget:
            self.popleft()

    def extend(self, values):
        for value in values:
            self.append(value)

    def popleft(self):
        self.bytes -= self.weights.popleft()
        return super().popleft()

    def clear(self):
        super().clear()
        self.weights.clear()
        self.bytes = 0


def data_query(ttl=2, pages=False, cache=True, seconds=20):
    def decorate(function):
        @wraps(function)
        def call(app, params=None):
            params = params or {}
            service = getattr(app, 'data', None)
            if service is None or getattr(app, '_data_reader', False):
                return function(app, params)
            if not cache or params.get('format') == 'csv' or params.get('source') in ('file', 'memory'):
                return service.execute(lambda reader: function(reader, params),seconds=seconds,cancelled=params.get('_cancelled'))
            if pages and params.get('view') != 'list':
                return service.execute(lambda reader: function(reader, params))
            return service.query(function, params, ttl, pages)
        return call
    return decorate


class DataService:
    """Shared response cache, bounded read concurrency and first-page prefetch."""
    FIRST_PAGES = {
        'overview': {'window': '1440', 'view': 'panel'},
        'hunt': {'window': '1440', 'limit': '50', 'offset': '0', 'view': 'list', 'icase': '1'},
        'incidents': {'window': '1440', 'limit': '50', 'offset': '0', 'view': 'list'},
        'events': {'window': '1440', 'limit': '50', 'offset': '0', 'view': 'list', 'type': 'drop'},
    }
    FIRST_REFRESH_SECONDS = 15

    def __init__(self, app, cache):
        self.app, self.cache = app, cache
        self.lock = threading.Lock()
        self.inflight, self.queue = {}, OrderedDict()
        self.retry_after = OrderedDict()
        self.readers = set()
        self.read_workers = max(1,min(8,int(getattr(app,'config',{}).get('read_workers',4))))
        self.sql = ReadExecutor()
        app.db.query_pool = self.sql
        self.slots = threading.BoundedSemaphore(self.read_workers)
        self.panel_slots = threading.BoundedSemaphore(1)
        self.log_slots = threading.BoundedSemaphore(max(1,self.read_workers-1))
        self.background_slots = threading.BoundedSemaphore(1)
        self.stop = threading.Event()
        self.wake = threading.Event()
        self.thread = None
        self.generation = app.db.network_generation
        self.revision = 0
        self.ingest_revision = 0
        self.first_updates = {}
        self.overview_active_until = 0
        self.overview_runtime = None
        app.db.on_insert_commit = self.ingested

    @staticmethod
    def normalized(params):
        return {key: str(value) for key, value in params.items()
                if value is not None and value != ''}

    def key(self, name, params):
        return json.dumps(['page', self.generation, self.revision, name, self.normalized(params)],
                          sort_keys=True, separators=(',', ':'))

    def first_page(self, name, params):
        expected = self.FIRST_PAGES.get(name)
        if expected is None:
            return None
        actual = self.normalized(params)
        if name == 'overview':
            actual.setdefault('window', '1440')
        else:
            actual.setdefault('offset', '0')
        return expected if actual == expected else None

    def ingested(self):
        with self.lock:
            self.ingest_revision += 1
        self.wake.set()

    def _first_due(self, name):
        update = self.first_updates.get(name)
        if update is None:
            due = 0
        else:
            revision, expiry, cooldown = update
            due = cooldown if revision != self.ingest_revision else max(cooldown, expiry)
        retry, _ = self.retry_after.get(self.key(name, self.FIRST_PAGES[name]), (0, ''))
        return max(due, retry)

    @staticmethod
    def _first_expiry(db, name, result):
        low, high = result['range']
        clause = (" AND type='drop'" if name == 'events' else
                  " AND type IN ('alert','drop')" if name == 'incidents' else '')
        oldest, = db.conn.execute(
            'SELECT MIN(ts) FROM events WHERE ts>=? AND ts<=?' + clause,
            (low * 1000, high * 1000)).fetchone()
        future, = db.conn.execute('SELECT MIN(ts) FROM events WHERE ts>?' + clause,
                                  (high * 1000,)).fetchone()
        expiry = min((oldest + 1)/1000 + high-low if oldest is not None else float('inf'),
                     future/1000 if future is not None else float('inf'))
        if name == 'overview':
            span = result['bucket'] * 60
            expiry = min(expiry, (int(high // span)+1)*span)
        return time.monotonic() + max(0, expiry - now())

    def _sync_generation(self):
        if self.generation != self.app.db.network_generation:
            with self.lock:
                if self.generation != self.app.db.network_generation:
                    self.generation = self.app.db.network_generation
                    self._clear_cache()

    def _clear_cache(self):
        self.queue.clear()
        self.retry_after.clear()
        self.first_updates.clear()
        self.cache.clear()

    def execute(self, producer, lane='log', background=False, seconds=20, cancelled=None):
        gate=self.background_slots if background else self.panel_slots if lane=='panel' else self.log_slots
        gates=[gate] if background else [gate,self.slots]
        acquired=[];conn = None;attached_summary=False
        def is_cancelled():return self.stop.is_set() or (callable(cancelled) and cancelled())
        try:
            deadline=time.monotonic()+5
            for slot in gates:
                while True:
                    if is_cancelled():raise RuntimeError('查询服务正在关闭' if self.stop.is_set() else '查询已取消')
                    remaining=deadline-time.monotonic()
                    if remaining<=0:raise RuntimeError('查询繁忙，请稍后重试')
                    if slot.acquire(timeout=min(.1,remaining)):
                        acquired.append(slot);break
            if self.stop.is_set():raise RuntimeError('查询服务正在关闭')
            source = self.app.db
            if source.conn is None:
                raise RuntimeError(source.last_error or '事件库不可用')
            conn = sqlite3.connect(Path(source.path).resolve().as_uri()+'?mode=ro', uri=True, timeout=1)
            conn.execute('PRAGMA query_only=ON')
            conn.execute('PRAGMA cache_size=-2048')
            generation = source.network_generation
            deadline = time.monotonic()+min(20,max(.01,seconds))
            conn.set_progress_handler(lambda: is_cancelled() or time.monotonic()>deadline
                                      or generation != source.network_generation, 10000)
            with self.lock:
                self.readers.add(conn)
            if self.stop.is_set():raise RuntimeError('查询服务正在关闭')
            db = copy.copy(source)
            db.conn, db.lock, db.query_state = conn, threading.RLock(), threading.local()
            db.summary_cache, db.visibility_cache, db.last_error = {}, {}, ''
            if hasattr(db,'summary_cursor'):del db.summary_cursor
            analytics = getattr(source,'analytics',None)
            if analytics is not None and analytics.ready and analytics.generation==source.network_generation:
                attached_summary=True
                try:
                    conn.execute('ATTACH DATABASE ? AS summaries',(Path(analytics.path).resolve().as_uri()+'?mode=ro',))
                    conn.execute('PRAGMA summaries.cache_size=-2048')
                except sqlite3.Error as exc:
                    analytics.error = '读取统计索引失败：' + str(exc)
                    raise
            reader = copy.copy(self.app)
            reader.db, reader._data_reader = db, True
            conn.execute('BEGIN')
            def setup(connection):
                helper = copy.copy(db)
                helper.conn, helper.lock = connection, threading.RLock()
                helper._hunt_functions()
                helper._association_functions()
            locks = [source.lock]
            if analytics is not None:
                locks.append(analytics.lock)
            with self.sql.snapshot(source,conn,setup=setup,
                    cancelled=lambda:is_cancelled() or generation!=source.network_generation or time.monotonic()>deadline,
                    locks=locks) as snapshot:
                db.parallel = snapshot
                if attached_summary:
                    state=dict(conn.execute('SELECT k,v FROM summaries.meta'))
                    if state.get('ready')=='1' and now()-float(state.get('as_of',0))<=30:
                        db.summary_cursor=int(state.get('cursor',0))
                db.cpu_cancelled = lambda:is_cancelled() or generation!=source.network_generation or time.monotonic()>deadline
                return producer(reader)
        except sqlite3.Error as exc:
            if not attached_summary:
                self.app.db.note_read_failure(exc)
            raise
        finally:
            if conn is not None:
                conn.set_progress_handler(None, 0)
                with self.lock:
                    self.readers.discard(conn)
                conn.close()
            for slot in reversed(acquired):slot.release()

    def schedule(self, key, task):
        with self.lock:
            if (self.stop.is_set() or key in self.queue or key in self.inflight or len(self.queue) >= 16
                    or time.monotonic()<self.retry_after.get(key,(0,''))[0]):
                return
            self.queue[key] = (time.monotonic()+15, task)
        self.wake.set()

    def query(self, function, params, ttl=2, pages=False, background=False):
        if self.stop.is_set():raise RuntimeError('查询服务正在关闭')
        self._sync_generation()
        requested_generation = (self.generation,self.revision)
        name = function.__name__
        first = self.first_page(name, params)
        if first is not None:
            params = first
        key = self.key(name, params)
        fresh = None if background else self.cache.get(key, None if first is not None else ttl)
        # Same query/range/page only. Keep a bounded last success while one
        # background refresh retries; never cache or substitute failed results.
        stale = fresh if fresh is not None or background else self.cache.get(key, 900)
        if stale is not None:
            if fresh is None:
                self.schedule(key, lambda: self.query(function, dict(params), ttl, False, True))
            failure = self.retry_after.get(key,(0,''))[1]
            result = stale if fresh is not None else dict(stale,read_state=dict(
                status='stale' if failure or self.cache.get(key,30) is None else 'refreshing',
                as_of=stale.get('as_of'),error=failure))
            if first is not None and failure:
                result = dict(result, read_state=dict(status='stale', as_of=result.get('as_of'), error=failure))
        else:
            with self.lock:
                flight = self.inflight.get(key)
                owner = flight is None
                if owner:
                    if len(self.inflight) >= 16:
                        raise RuntimeError('查询队列已满，请稍后重试')
                    flight = self.inflight[key] = dict(event=threading.Event(), result=None, error=None)
            if not owner:
                if not flight['event'].wait(25):
                    raise RuntimeError('查询超时，请稍后重试')
                if flight['error']:
                    raise RuntimeError(flight['error'])
                result = copy.deepcopy(flight['result'])
            else:
                generation = requested_generation
                revision = self.ingest_revision
                started = time.monotonic()
                try:
                    def produce(reader):
                        reader._building_first_page = first is not None
                        value = function(reader, params)
                        if first is not None and reader.db.last_error and not value.get('error'):
                            value = dict(value, error=reader.db.last_error)
                        good = not value.get('error') and not (value.get('security') or {}).get('error')
                        expiry = self._first_expiry(reader.db, name, value) if first is not None and good else None
                        return value, expiry

                    result, expiry = self.execute(produce, lane='panel' if name=='overview' else 'log',background=background)
                    result = dict(result, as_of=result.get('as_of') or now())
                    flight['result'] = result
                    with self.lock:
                        if generation == (self.app.db.network_generation,self.revision):
                            error = result.get('error') or (result.get('security') or {}).get('error')
                            if error:
                                self._retry(key, error)
                            elif self.cache.put(key, result, resident=first is not None):
                                self.retry_after.pop(key,None)
                                if first is not None:
                                    completed = time.monotonic()
                                    cooldown = max(self.FIRST_REFRESH_SECONDS, 4*(completed-started))
                                    self.first_updates[name] = revision, expiry, completed + cooldown
                            elif first is not None:
                                self._retry(key, '首页快照超出缓存容量')
                except Exception as exc:
                    flight['error'] = str(exc)
                    with self.lock:
                        if generation == (self.app.db.network_generation,self.revision):
                            self._retry(key, exc)
                    raise
                finally:
                    with self.lock:
                        self.inflight.pop(key, None)
                        flight['event'].set()
                    if first is not None:
                        self.wake.set()
        if first is not None and name == 'overview' and not background:
            self.overview_active_until = time.monotonic() + 15
            if self.overview_runtime is not None:
                result = dict(result, **self.overview_runtime)
            if 'range' in result:
                network = self.app.network.get(*result['range'], rolling=True)
                result = dict(result, network=network, top=dict(result['top'],
                    sources=network.get('log_sources', []), destinations=network.get('log_destinations', [])))
        if pages and not background and first is None:
            offset, limit = int(params.get('offset') or 0), int(params.get('limit') or 50)
            if result.get('total', 0) > offset+limit:
                following = dict(params, offset=offset+limit)
                if result.get('range'):
                    following.pop('all', None)
                    low, high = (int(value) if float(value).is_integer() else value for value in result['range'])
                    following.update({'from':str(low), 'to':str(high)})
                next_key = self.key(function.__name__, following)
                self.schedule(next_key, lambda: self.query(function, following, ttl, False, True))
        # Read connections and cached pages can remain readable after the writer
        # fails. Always consult the live writer, including on cache hits.
        write_error = self.app.db.write_error
        if write_error:
            result = dict(result, error='事件入库失败，查询结果可能未更新：' + write_error)
        if requested_generation != (self.app.db.network_generation,self.revision):
            raise RuntimeError('历史记录已变更，请重新查询')
        return result

    def _retry(self, key, error):
        self.retry_after[key] = (time.monotonic()+5, str(error))
        self.retry_after.move_to_end(key)
        while len(self.retry_after)>16:
            self.retry_after.popitem(last=False)

    def invalidate(self):
        with self.lock:
            self.revision += 1
            self._clear_cache()
        self.wake.set()

    def start(self):
        if self.thread is not None and self.thread.is_alive():
            return
        self.thread = threading.Thread(target=self._run, name='data-prefetch', daemon=True)
        self.thread.start()

    def _run(self):
        pressure_at = float('inf') if self.app.config.get('preload_memory_mib') is not None else 0
        while not self.stop.is_set():
            self.wake.clear()
            self._sync_generation()
            stamp = time.monotonic()
            if stamp >= pressure_at:
                self.cache.pressure()
                pressure_at = stamp + 30
            with self.lock:
                due, name = min(((self._first_due(name), name) for name, params in self.FIRST_PAGES.items()
                                 if self.key(name, params) not in self.inflight),
                                key=lambda item:item[0], default=(float('inf'), ''))
                task = self.queue.popitem(last=False)[1] if due > stamp and self.queue else None
            if due <= stamp or task:
                try:
                    if due <= stamp:
                        self.query(getattr(App, name).__wrapped__, self.FIRST_PAGES[name], background=True)
                    elif task[0] >= stamp:
                        task[1]()
                except Exception:
                    pass  # Foreground reads report errors; a failed prefetch must not stop the worker.
            else:
                timeout = min(due, pressure_at) - stamp
                self.wake.wait(None if math.isinf(timeout) else max(0,timeout))

    def close(self):
        self.stop.set()
        self.wake.set()
        with self.lock:
            self.queue.clear()
            for conn in self.readers:
                conn.interrupt()
        if self.thread is not None:
            self.thread.join(timeout=5)
        self.sql.close()


def iso(ts):
    try:
        return time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(ts))
    except Exception:
        return ""


try:  # python3-nftables：libnftables 的官方 Python 绑定
    import nftables as _nftables
except ImportError:  # 没装就退回 nft -j
    _nftables = None

_NFT_LOCK = threading.Lock()
_NFT_CTX = [None]


def nft_query_table(family, table):
    """读一张 nft 表（结构化 JSON）。优先走 libnftables 绑定，不启动子进程"""
    if _nftables is not None:
        with _NFT_LOCK:
            try:
                if _NFT_CTX[0] is None:
                    ctx = _nftables.Nftables()
                    ctx.set_json_output(True)
                    _NFT_CTX[0] = ctx
                rc, out, _err = _NFT_CTX[0].cmd("list table %s %s" % (family, table))
