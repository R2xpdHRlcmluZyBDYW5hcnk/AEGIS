def app_event_summary(app_obj):
    """给 quic/ssh/http2 这类事件拼一个可读摘要（含 client/server 子对象）"""
    if not isinstance(app_obj, dict):
        return ""
    parts = []
    for key in APP_SUMMARY_KEYS:
        val = app_obj.get(key)
        if isinstance(val, (str, int, float)) and str(val):
            parts.append(str(val))
        if len(parts) >= 2:
            return " ".join(parts)
    for side in ("client", "server"):
        sub_obj = app_obj.get(side)
        if isinstance(sub_obj, dict):
            for key in ("software_version", "proto_version"):
                val = sub_obj.get(key)
                if isinstance(val, (str, int)) and str(val):
                    parts.append("%s=%s" % (side, val))
                    break
    return " ".join(parts)

