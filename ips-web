    # -- SSE 统一实现 ---------------------------------------------------
    def _sse_start(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream; charset=utf-8")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("X-Accel-Buffering", "no")
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True

    def _sse_send(self, payload):
        try:
            body = json.dumps(payload, ensure_ascii=False, default=str)
            self.wfile.write(("data: " + body + "\n\n").encode("utf-8"))
            self.wfile.flush()
            return True
        except (BrokenPipeError, ConnectionResetError, OSError):
            return False

    def _stream_payload(self, topic, params):
        """各 topic 的快照：与对应 REST 接口返回一致"""
        query = dict(params)
        query.pop("topic", None)
        if topic == "overview":
            return self.app.overview(query)
        if topic in ("alerts", "drops"):
            # App resolves the rolling window per computation, shared with REST/prefetch keys.
            if topic == "alerts":
                return self.app.incidents(query)
            query["type"] = "drop"
            return self.app.events(query)
        if topic == "system":
            return self.app.system_payload()
        if topic == "rules":
            return self.app.rules_payload()
        if topic == "manage":
            return {"governance": governance_state(), "rules": self.app.rules_payload()}
        if topic == "hunt":
            return self.app.hunt(query)
        return {"error": "unknown topic"}

    DELTA_TOPICS = ("hunt", "alerts", "drops")

    def _stream(self, params):
        slots=getattr(self.server,'stream_slots',None)
        if slots is not None and not slots.acquire(blocking=False):
            self.close_connection=True
            return self._error(503,'实时订阅已满，请稍后重试')
        try:return self._serve_stream(params)
        finally:
            if slots is not None:slots.release()

    def _serve_stream(self, params):
        """Window-correct snapshots include delayed writes and expire old rows."""
        topic = (params.get("topic") or "overview").strip()
        if disconnected(self.connection):return
        self._sse_start()
        deadline = time.monotonic() + 300
        last = None
        while time.monotonic() < deadline:
            if getattr(self.server,'stop',None) is not None and self.server.stop.is_set():return
            if disconnected(self.connection):return
            if not self._session():
                self._sse_send({"error": "login required", "status": 401})
                return
            try:
                payload = self._stream_payload(topic, params)
            except Exception as exc:  # noqa: BLE001
                payload = {"error": str(exc)}
            body = json.dumps(payload, ensure_ascii=False, default=str, sort_keys=True)
            if body != last:      # 内容没变就发心跳，客户端仍能判断连接是否存活
                last = body
                if not self._sse_send(payload):
                    return
            else:
                try:
                    self.wfile.write(b": heartbeat\n\n")
                    self.wfile.flush()
                except OSError:
                    return
            if not self._sse_sleep(5, deadline):
                return

    def _sse_sleep(self,seconds, deadline):
        stop=getattr(self.server,'stop',None)
        wake=min(deadline,time.monotonic()+seconds)
        while True:
            if (stop is not None and stop.is_set()) or disconnected(self.connection):return False
            remaining=wake-time.monotonic()
            if remaining<=0:return time.monotonic()<deadline
            # No extra snapshot queries: only observe FIN/RST while waiting.
            if stop is not None:stop.wait(min(.1,remaining))
            else:time.sleep(min(.1,remaining))

    def do_POST(self):  # noqa: N802
        try:
            return self._write("POST")
        finally:
            if self.path.startswith('/api/') and not self.path.startswith('/api/ai/') and getattr(self.app,'data',None):
                self.app.data.invalidate()

    def do_DELETE(self):  # noqa: N802
        try:
            return self._write("DELETE")
        finally:
            if getattr(self.app,'data',None):
                self.app.data.invalidate()

    mutation_lock = threading.Lock()

    def _write(self, method):
        try:
            return self._write_request(method)
        except (ValueError, TypeError) as exc:
            return self._error(400, str(exc))
        except Exception:
            import traceback
            traceback.print_exc()
            return self._error(500, "操作失败，请检查服务日志")

    def _write_request(self, method):
        parsed = urlparse(self.path)
        path = parsed.path
        if method == "POST" and path == "/login":
            return self._do_login()
        if method == "POST" and path == "/logout":
            return self._do_logout()
        if not self._require():
            return
        if self.headers.get("X-Requested-With") != "ips-web":
            self.close_connection = True
            return self._error(400, "missing X-Requested-With header")
        raw = self._read_body(API_BODY_LIMIT)
        if raw is None:
            return
        try:
            body = json.loads(raw or b"{}")
        except Exception:
            return self._error(400, "invalid json")
        if not isinstance(body, dict):
            return self._error(400, "json body must be an object")
        if method == 'POST' and path == '/api/ai/generate':
            return self._generate(body)
        if method == 'POST' and path == '/api/ai/rules/add':
            result = self.app.assistant.add(self.app, self._cookie_token(), body.get('proposal'))
            self.app.data.invalidate()
            return self._json(result)
        with self.mutation_lock:
            return self._mutate(method,path,body)

    def _generate(self, body):
        # One streaming connection owns one inference. Closing it cancels upstream.
        self.close_connection = True
        self.send_response(200)
        self.send_header('Content-Type', 'application/x-ndjson; charset=utf-8')
        self.send_header('Cache-Control', 'no-store')
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('X-Accel-Buffering', 'no')
        self.send_header('Connection', 'close')
        self.end_headers()
        stop = getattr(self.server, 'stop', None)
        def cancelled():
            return (stop is not None and stop.is_set()) or disconnected(self.connection)
        def send(value):
            try:
                self.wfile.write(json.dumps(value, ensure_ascii=False).encode() + b'\n')
                self.wfile.flush()
                return True
            except OSError:
                return False
        try:
            self.app.assistant.generate(self.app, self._cookie_token(), body, send, cancelled)
        except (ValueError, TypeError) as exc:
            send({'error': str(exc)})
        except Exception:
            send({'error': '本地模型调用失败，请稍后重试'})

    def _mutate(self,method,path,body):
        if method == "POST" and path == "/api/db/clear":
            scope=body.get('scope','all')
            if scope not in ('all','database'):raise ValueError('历史清理范围无效')
            if getattr(self.app,'control',None):
                return self._json(self.app.control.request('history-reset',scope=scope))
            ok = self.app.clear_history()
            return self._json({"ok": ok, "stats": self.app.db.stats()})
        if method == "POST" and path == "/api/db/settings":
            return self._json({"ok": True, "stats": self.app.db.configure_capacity(body.get('cap_mib'))})
        if getattr(self.app, "control", None):
            return self._json(self.app.control.request("mutate", method=method, path=path, body=body))
        return self._json(rule_write(self.app, method, path, body))

    def _static(self, name):
        base = os.path.abspath(self.config.get("static_dir"))
        target = os.path.abspath(os.path.join(base, name))
        if not target.startswith(base + os.sep) or not os.path.isfile(target):
            return self._error(404, "not found")
        ctype = {
            "index.html": "text/html; charset=utf-8",
            "app.css": "text/css; charset=utf-8",
            "app.js": "application/javascript; charset=utf-8",
            "ui.js": "application/javascript; charset=utf-8",
            "favicon.svg": "image/svg+xml",
        }.get(name)
        if ctype is None:
            ext = os.path.splitext(name)[1].lower()
            ctype = {
                ".js": "application/javascript; charset=utf-8",
                ".woff2": "font/woff2",
                ".woff": "font/woff",
                ".svg": "image/svg+xml",
                ".png": "image/png",
            }.get(ext, "application/octet-stream")
        with open(target, "rb") as fh:
            data = fh.read()
        self._send(200, data, ctype, {
            "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; "
                                       "style-src 'self' 'unsafe-inline'; "
                                       "script-src 'self'; connect-src 'self'",
        })


