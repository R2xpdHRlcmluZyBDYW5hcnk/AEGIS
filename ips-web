        manual={signature_key(match[2], match[1]) for line in Path(THRESHOLD_CONF).read_text().splitlines()
                if (match := _SUPPRESS_IDS.match(suppression_line(line))) and int(match[1]) and int(match[2])}
    except FileNotFoundError:
