    @data_query(cache=False)
    def hunt_community_range(self, params):
        value = str(params.get('community') or '')
        if not value or len(value)>256 or any(c.isspace() for c in value):
            raise ValueError('Community ID 无效')
        return self.db.community_range(value) or {'error':'未找到该 Community ID 的事件记录'}

    @data_query(cache=False)
    def hunt_tuple_range(self, params):
        value=str(params.get('hash') or '').lower()
        if not re.fullmatch('[0-9a-f]{64}',value):
            raise ValueError('五元组关联键无效')
        return self.db.association_range('tuple:'+value) or {'error':'未找到该五元组的事件记录'}

    @data_query(cache=False)
    def hunt_related(self, params):
        if params.get('incident_id'):
            return self.db.incident_investigation(str(params['incident_id']))
        community = str(params.get('community') or '')
        if community:
            if len(community)>256 or any(char.isspace() for char in community):
                raise ValueError('Community ID 无效')
            return self.db.related_investigation(community=community)
        try:
            src,dst = str(params['src']),str(params['dst'])
            if ip_address(src).version!=ip_address(dst).version:
                raise ValueError()
            sport,dport = int(params['sport']),int(params['dport'])
            proto = str(params['proto']).strip().upper()
            if not (0<=sport<=65535 and 0<=dport<=65535) or not re.fullmatch('[A-Z0-9_-]{1,32}',proto):
                raise ValueError()
        except (KeyError,TypeError,ValueError):
            raise ValueError('需要有效的完整五元组')
        flow = None
        if params.get('flow') not in (None,'',0,'0'):
            flow = flow_identifier(params['flow'])
            if flow is None:
                raise ValueError('Flow ID 无效')
        return self.db.related_investigation(endpoints=(src,sport,dst,dport,proto),flow=flow)

    @data_query(cache=False)
    def record(self, params):
