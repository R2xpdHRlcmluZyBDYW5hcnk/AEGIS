    # -- 增量读取 -------------------------------------------------------
    def ingest(self, budget=3):
        for _ in range(budget):
            if not self._ingest_once():
                return self.pending
        return self.pending

    def _ingest_once(self):
        with self.lock:
            if self.db is not None and (self.db.conn is None or self.db.write_blocked):
                return False
            if self.db is not None and len(self.db.buf) >= self.db.BATCH:
                self.db.flush()
                if len(self.db.buf) >= self.db.BATCH:
                    return False
            t = now()
            if t - self.last_ingest < (.05 if self.pending else .7):
                return False
            self.last_ingest = t
            try:
                st = os.stat(self.path)
            except OSError as exc:
                self.last_error = str(exc)
                return False
            if self.ino != st.st_ino:
                first_open = self.ino is None
                self.ino = st.st_ino
                self.buf = b""
                self.offset = max(0, st.st_size - self.initial_tail) if first_open else 0
                floor=getattr(self.db,'stream_cutoff',None) if self.db is not None else None
                if first_open and floor and (st.st_dev,st.st_ino)==(floor['device'],floor['inode']) and st.st_size>=floor['offset']:
                    self.offset=max(self.offset,floor['offset'])
                self.offsets = array.array("Q")
                self.offset_base = self.next_id
                self.minute_index.clear()
            if st.st_size < self.offset:
                self.offset = 0
                self.buf = b""
                self.offsets = array.array("Q")
                self.offset_base = self.next_id
                self.minute_index.clear()
            if st.st_size == self.offset and not self.buf:
                self.pending = False
                return False
            start = self.offset
            try:
                with open(self.path, "rb") as fh:
                    fh.seek(start)
                    chunk = fh.read(4 << 20)
                    self.offset = fh.tell()
                    self.pending = self.offset < st.st_size
            except OSError as exc:
                self.last_error = str(exc)
                return False
            data = self.buf + chunk
            previous_buf = self.buf
            self.last_error = ""
            if not data:
                return False
            base = start - len(self.buf)
            parts = data.split(b"\n")
            self.buf = parts.pop() if parts else b""
            added = 0
            pos = base
            def positioned():
                position = base
                for raw in parts:
                    offset = position
                    position += len(raw)+1
                    if raw.strip():
                        yield raw,offset
            parallel = getattr(self,'cpu',None) is not None and len(data)>=256<<10 and len(parts)>=128
            if parallel:
                from event_processing import parse_events
                jobs = ((batch,self.db is not None) for batch in byte_batches(positioned(),size=lambda row:len(row[0])))
                stats={}
                try:
                    # Parse before publishing offsets or adding any record, so a worker
                    # failure retries the entire input batch without partial cache updates.
                    parsed_rows = [row for batch in self.cpu.ordered(parse_events,jobs,stats) for row in batch]
                    self.worker_pids=stats.get('pids',set())
                except BaseException:
                    self.offset,self.buf = start,previous_buf
                    raise
            else:
                def serial_rows():
                    for raw,offset in positioned():
                        parsed = self._parse(raw)
                        if parsed:
                            rec,line = parsed
                            rec['off'] = offset
                            yield rec,line,None
                parsed_rows = serial_rows()
            for rec,line,values in parsed_rows:
                line_off = rec['off']
                rec["id"] = self.next_id
                self.next_id += 1
                event_key = ((self.db.add_prepared(values) if parallel else self.db.add(rec,line.decode('utf-8','replace')))
                             if self.db is not None else None)
                cached = dict(list_record(rec),_event_key=event_key) if self.compact else rec
                self.events.append(cached)
                if rec["type"] in ("alert", "drop"):
                    self.strong.append(cached)
                self.offsets.append(line_off)
                if len(self.offsets) > self.offset_cap:
                    drop = len(self.offsets) - self.offset_cap
                    del self.offsets[:drop]
                    self.offset_base += drop
                minute = int(rec["ts"] // 60) * 60
                self.minute_index.setdefault(minute, line_off)
                if rec["type"] in ("alert", "drop"):
                    slot = self.buckets.setdefault(minute, [0, 0])
                    slot[0 if rec["type"] == "alert" else 1] += 1
                added += 1
            if added:
                cutoff = int(now() // 60) * 60 - DB_TIER1_DAYS * 86400
                for key in [k for k in self.buckets if k < cutoff]:
                    self.buckets.pop(key, None)
                for key in [k for k in self.minute_index if k < cutoff]:
                    self.minute_index.pop(key, None)
                if self.minute_cap:
                    for mapping in (self.minute_index,self.buckets):
                        while len(mapping)>self.minute_cap:
                            mapping.pop(next(iter(mapping)))
            return len(parts) >= 0 and (self.offset < st.st_size or bool(self.buf))

    def coverage(self):
        """内存里最旧的一条事件时间戳；0 表示还没有数据"""
        with self.lock:
            if not self.events:
                return 0.0
            return self.events[0]["ts"]

    def _log_files(self):
        """当前日志 + 轮转文件，最新的在前"""
        files = [self.path]
        try:
            rotated = [p for p in glob(self.path + ".*") if os.path.isfile(p)]
        except Exception:  # noqa: BLE001
            rotated = []
        rotated.sort(key=lambda item: os.path.getmtime(item), reverse=True)
        return files + rotated

    def search_history(self, window=60, matcher=None, limit=100, offset=0,
                       max_bytes=256 << 20, matcher_spec=None, cancelled=None):
        """超出内存缓冲：扫日志文件（含 .gz），覆盖比缓冲更早的时间范围"""
        cutoff = now() - window * 60
        if getattr(self,'cpu',None) is not None and (matcher is None or matcher_spec is not None):
            return self._parallel_history(cutoff,limit,offset,max_bytes,matcher_spec,cancelled)
        matches = []
        scanned = 0
        for path in self._log_files():
            if scanned > max_bytes:
                break
            try:
                stat = os.stat(path)
            except OSError:
                continue
            if stat.st_mtime < cutoff:
                break                     # 更早的文件都在范围之外
            opener = gzip.open if path.endswith(".gz") else open
            try:
                with opener(path, "rt", encoding="utf-8", errors="replace") as handle:
                    for line in handle:
                        scanned += len(line)
                        if scanned > max_bytes:
                            break
                        parsed = self._parse(line.rstrip("\n").encode("utf-8"))
                        if not parsed:
                            continue
                        rec, raw = parsed
                        if rec["ts"] < cutoff:
                            continue
                        if matcher is not None and not matcher(rec):
                            continue
                        rec["id"] = None
                        rec["_raw"] = line.rstrip("\n")
                        matches.append(rec)
                        if len(matches) >= 5000:
                            break
            except (OSError, EOFError):
                continue
            if len(matches) >= 5000:
                break
        matches.sort(key=lambda item: item["ts"], reverse=True)
        return len(matches), matches[offset:offset + limit]

    def _parallel_history(self,cutoff,limit,offset,max_bytes,spec,cancelled):
        from event_processing import history_records
        def source():
            scanned=0
            for path in self._log_files():
                if scanned>max_bytes:break
                try:
                    if os.stat(path).st_mtime<cutoff:break
                    opener=gzip.open if path.endswith('.gz') else open
                    with opener(path,'rt',encoding='utf-8',errors='replace') as handle:
                        for line in handle:
                            scanned+=len(line)
                            if scanned>max_bytes:break
                            yield line.rstrip('\n').encode('utf-8')
                except (OSError,EOFError):continue
        lines=source();batches=byte_batches(lines)
        results=self.cpu.ordered(history_records,((batch,cutoff,spec) for batch in batches),cancelled=cancelled)
        matches=[]
        try:
            for hits in results:
                matches.extend(hits[:5000-len(matches)])
                if len(matches)>=5000:break
        finally:
            results.close();batches.close();lines.close()
        matches.sort(key=lambda item:item['ts'],reverse=True)
        return len(matches),matches[offset:offset+limit]

    # -- 查询 -----------------------------------------------------------
    def query(self, window=60, etype="all", sev=None, proto=None, action=None,
              q="", offset=0, limit=100, matcher=None, start=None, end=None,
              matcher_spec=None, cancelled=None):
        cutoff = now() - window * 60 if start is None else start
        q = (q or "").strip().lower()
        pool = self.strong if etype in ("alert", "drop") else self.events
        out = []
        matched = 0
        with self.lock:
            snapshot = list(pool)
        if getattr(self,'cpu',None) is not None and len(snapshot)>=128 and (matcher is None or matcher_spec is not None):
            from event_processing import memory_records
            def records():
                for event in reversed(snapshot):
                    if event['ts']<cutoff:break
                    raw=self.detail(event['id']) if self.compact else None
                    if self.compact and raw is None and self.db is not None and event.get('_event_key'):
                        with self.db.lock:
                            row=self.db.conn.execute('SELECT '+','.join(self.db.names)+' FROM events WHERE event_key=?',
                                (event['_event_key'],)).fetchone() if self.db.conn is not None else None
                        if row is not None:event=dict(self.db._row(row),id=event['id'])
                    yield event,raw
            options=dict(cutoff=cutoff,end=end,type=etype,sev=sev,proto=proto,action=action,q=q)
            source=records();batches=byte_batches(source,size=lambda item:len(item[1] or '')+1024)
            results=self.cpu.ordered(memory_records,((batch,options,matcher_spec) for batch in batches),cancelled=cancelled)
            try:
                for hits in results:
                    before=matched;matched+=len(hits)
                    begin=max(0,offset-before)
                    if len(out)<limit:out.extend(hits[begin:begin+limit-len(out)])
            finally:
                results.close();batches.close();source.close()
            return matched,out
        for ev in reversed(snapshot):
            if end is not None and ev["ts"] > end:
                continue
            if ev["ts"] < cutoff:
                break
            if self.compact:
                raw = self.detail(ev['id'])
                parsed = self._parse(raw.encode('utf-8')) if raw is not None else None
                if parsed is not None:
                    ev = dict(parsed[0],id=ev['id'])
                elif self.db is not None and ev.get('_event_key'):
                    with self.db.lock:
                        row = self.db.conn.execute('SELECT '+','.join(self.db.names)+
                            ' FROM events WHERE event_key=?',(ev['_event_key'],)).fetchone() if self.db.conn is not None else None
                    if row is not None:
                        ev = dict(self.db._row(row),id=ev['id'])
            if matcher is not None and not matcher(ev):
                continue
            if etype != "all" and ev["type"] != etype:
                continue
            if sev is not None and ev["sev"] not in sev:
                continue
            if proto and ev["proto"].upper() != proto.upper():
                continue
            if action and ev["action"] != action:
                continue
            if q and q not in (ev["sig"] + " " + ev["src"] + " " + ev["dst"] + " " +
                               ev["app"] + " " + ev["reason"] + " " + ev["cat"]).lower():
                continue
            matched += 1
            if matched > offset and len(out)<limit:
                out.append(ev)
        return matched, out

    def aggregate(self, window=60, etype="all", sev=None, proto=None, action=None, q="", topn=8, start=None, end=None):
        _, events = self.query(window=window, etype=etype, sev=sev, proto=proto,
                               action=action, q=q, offset=0, limit=10 ** 6, start=start, end=end)
        sig = Counter()
        src = Counter()
        dst = Counter()
        dport = Counter()
        protos = Counter()
        reasons = Counter()
        for ev in events:
            sig[(ev["sig"], ev["sev"])] += 1
            src[ev["src"]] += 1
            dst[ev["dst"]] += 1
            if ev["dport"]:
                dport[f'{ev["dport"]}/{ev["proto"].lower() or "?"}'] += 1
            protos[ev["proto"] or "?"] += 1
            if ev["reason"]:
                reasons[ev["reason"]] += 1
        return {
            "total": len(events),
            "signatures": [{"sig": s, "sev": v, "count": c} for (s, v), c in sig.most_common(topn)],
            "sources": [{"ip": k, "count": v} for k, v in src.most_common(topn)],
            "destinations": [{"ip": k, "count": v} for k, v in dst.most_common(topn)],
            "ports": [{"port": k, "count": v} for k, v in dport.most_common(topn)],
            "protocols": [{"proto": k, "count": v} for k, v in protos.most_common()],
            "reasons": [{"reason": k, "count": v} for k, v in reasons.most_common(topn)],
        }

    def series(self, minutes=60, bucket=1):
        """按分钟聚合；bucket 为每个点的分钟数（大范围时把点变少）。

        应用重启 / eve.json 轮转后，内存只剩最近一段；缺的整段从事件库聚合补齐
        （两边按分钟互斥，不重复计数）。事件库批量写入有秒级延迟，最新分钟以内存为准。
        """
        bucket = max(1, int(bucket))
        span = bucket * 60
        end = int(now() // 60) * 60
        end -= end % span        # 柱子对齐到整点/整刻，横轴标签才落得齐
        slots = max(1, int(minutes) // bucket)
        start = end - (slots - 1) * span
        mem_oldest = min(self.buckets) if self.buckets else end + span
        boundary = min(end + span, max(start, mem_oldest))
        db_minutes = self._series_db(start, boundary)
        points = []
        for index in range(slots):
            base = start + index * span
            alerts = drops = 0
            for offset in range(bucket):
                minute = base + offset * 60
                if minute < boundary and minute in db_minutes:
                    a, d = db_minutes[minute]
                else:
                    a, d = self.buckets.get(minute, (0, 0))
                alerts += a
                drops += d
            points.append({"t": base, "alerts": alerts, "drops": drops})
        return points

    def _series_db(self, start, boundary):
        """事件库按分钟聚合 alert/drop，供内存覆盖不到的区间使用；结果缓存 10 秒"""
        if start >= boundary or self.db is None or self.db.conn is None:
            return {}
        stamp = now()
        cached = self._series_cache
        if cached and cached[0] == (start, boundary) and stamp - cached[1] < 10:
            return cached[2]
        rows = {}
        try:
            with self.db.lock:
                grouped = self.db.conn.execute(
                    "SELECT CAST(ts/60000 AS INTEGER), type, COUNT(*) FROM events"
                    " WHERE ts >= ? AND ts < ? AND type IN ('alert','drop')"
                    " GROUP BY 1, 2", (start * 1000, boundary * 1000)).fetchall()
            for minute, etype, count in grouped:
                slot = rows.setdefault(minute * 60, [0, 0])
                slot[0 if etype == "alert" else 1] += count
        except sqlite3.Error:
            return {}
        self._series_cache = ((start, boundary), stamp, rows)
        return rows

    def oldest(self):
        try:
            return self.events[0]["ts"]
        except IndexError:
            return None

    def detail(self, event_id):
        with self.lock:
            idx = event_id - self.offset_base
            if not (0 <= idx < len(self.offsets)):
                return None
            off = self.offsets[idx]
            try:
                if os.stat(self.path).st_ino != self.ino:
                    return None          # 日志已轮转，旧偏移失效
                with open(self.path, "rb") as handle:
                    handle.seek(off)
                    return handle.readline().decode("utf-8", "replace").rstrip("\n")
            except OSError:
                return None


