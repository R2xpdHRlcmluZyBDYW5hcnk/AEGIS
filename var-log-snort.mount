[Unit]
Description=Persistent Snort native logs
DefaultDependencies=no
RequiresMountsFor=/var/lib/ips-snort-logs /var/log
After=local-fs.target armbian-zram-config.service armbian-ramlog.service
Before=umount.target
Conflicts=umount.target

[Mount]
What=/var/lib/ips-snort-logs/snort
Where=/var/log/snort
Type=none
Options=bind

[Install]
WantedBy=multi-user.target
